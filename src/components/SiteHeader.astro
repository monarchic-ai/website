---
import { webappBaseUrl } from "../lib/publicUrls";

interface Props {
  active?: "products" | "research" | "support";
  tone?: "dark" | "paper";
}

const { active, tone = "dark" } = Astro.props;
const navClass = (current: boolean) => [
  "site-nav-link",
  tone === "paper"
    ? current
      ? "site-nav-link--current text-black"
      : "text-black/64 hover:text-black"
    : current
      ? "site-nav-link--current text-white"
      : "text-white/68 hover:text-white",
].join(" ");
---

<header
  id="navigation"
  class:list={[
    "site-header sticky top-0 z-50",
    tone === "paper" ? "site-header--paper bg-paper text-black" : "bg-black text-white",
  ]}
>
  <a href="/" aria-label="Monarchic home" class="site-wordmark motion-link">
    <span aria-hidden="true">Monarchic</span>
  </a>
  <nav aria-label="Primary navigation" class="site-primary-nav">
    <a aria-current={active === "products" ? "page" : undefined} href="/products" class={navClass(active === "products")}><span>Products</span></a>
    <a aria-current={active === "research" ? "page" : undefined} href="/research" class={navClass(active === "research")}><span>Research</span></a>
    <a aria-current={active === "support" ? "page" : undefined} href="/company#contact" class={navClass(active === "support")}><span>Support</span></a>
    <a href={`${webappBaseUrl}/app`} class={navClass(false)}><span>Apps</span></a>
  </nav>
</header>
