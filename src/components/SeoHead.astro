---
interface Props {
  title: string;
  description: string;
  path?: string;
  type?: "website" | "article";
  imagePath?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  type = "website",
  imagePath = "/social-card.png?v=5",
} = Astro.props;

const siteUrl = (import.meta.env.PUBLIC_MONARCHIC_WEBSITE_BASE_URL ?? "https://monarchic.io").replace(/\/$/, "");
const canonicalUrl = new URL(path, `${siteUrl}/`).toString();
const imageUrl = new URL(imagePath, `${siteUrl}/`).toString();
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:site_name" content="Monarchic" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Monarchic AI engineering research and development" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
