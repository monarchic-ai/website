---
import type { ProductWorkflowProof } from "../lib/productWorkflowProofs";

interface Props {
  proof: ProductWorkflowProof;
}

const { proof } = Astro.props;
const callPayload = proof.calls.length === 1
  ? { tool: proof.calls[0].tool, arguments: proof.calls[0].arguments }
  : proof.calls.map((call) => ({ tool: call.tool, arguments: call.arguments }));
const requestJson = JSON.stringify(callPayload, null, 2);
const outputJson = JSON.stringify(proof.output, null, 2);
---

<section data-workflow-proof={proof.slug} class="mt-10 border-2 border-white bg-black/78">
  <header class="border-b-2 border-white p-5 sm:p-6">
    <p class="text-[0.65rem] font-bold uppercase text-signal">Concrete workflow / priced call</p>
    <h2 class="mt-3 max-w-4xl text-2xl font-extrabold uppercase leading-tight sm:text-3xl">{proof.title}</h2>
    <p class="mt-4 max-w-3xl text-sm leading-7 text-white/66">
      The request, exact tool-call payload, returned output, and usage receipt are shown below.
    </p>
  </header>

  <div class="grid min-w-0 lg:grid-cols-[0.82fr_1.18fr_1.18fr_0.62fr]">
    <section class="min-w-0 border-b border-white/35 p-5 lg:border-b-0 lg:border-r">
      <p class="font-mono text-[0.62rem] font-bold uppercase text-signal">Request</p>
      <blockquote class="mt-4 text-base font-bold leading-7 text-white">“{proof.request}”</blockquote>
    </section>

    <section class="min-w-0 border-b border-white/35 p-5 lg:border-b-0 lg:border-r">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="font-mono text-[0.62rem] font-bold uppercase text-signal">Execution</p>
        <span class="text-[0.58rem] font-bold uppercase text-white/42">Tool call payload</span>
      </div>
      <pre class="mt-4 max-h-80 max-w-full overflow-auto border border-white/28 bg-black p-3 text-[0.68rem] leading-5 text-white/72"><code>{requestJson}</code></pre>
      <p class="mt-4 text-xs leading-6 text-white/56">{proof.execution}</p>
    </section>

    <section class="min-w-0 border-b border-white/35 p-5 lg:border-b-0 lg:border-r">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="font-mono text-[0.62rem] font-bold uppercase text-signal">Output</p>
        <span class="border border-white/35 px-2 py-1 text-[0.56rem] font-bold uppercase text-white/56">{proof.outputKind}</span>
      </div>
      <pre class="mt-4 max-h-80 max-w-full overflow-auto border border-white/28 bg-black p-3 text-[0.68rem] leading-5 text-white/72"><code>{outputJson}</code></pre>
    </section>

    <section class="min-w-0 bg-signal p-5 text-black">
      <p class="font-mono text-[0.62rem] font-bold uppercase text-black/58">Usage rating</p>
      <p class="mt-5 font-mono text-4xl font-extrabold uppercase leading-none">At runtime</p>
      <p class="mt-2 text-xs font-extrabold uppercase">Recorded on the operation receipt</p>
      <p class="mt-6 text-xs font-semibold leading-5 text-black/72">{proof.usageExplanation}</p>
      {proof.calls.length > 1 && (
        <ul class="mt-5 border-t border-black/28 pt-4 text-[0.65rem] font-bold uppercase leading-5">
          {proof.calls.map((call) => <li>{call.tool}</li>)}
        </ul>
      )}
    </section>
  </div>

  <footer class="grid border-t border-white/35 sm:grid-cols-2">
    <div class="border-b border-white/35 p-5 sm:border-b-0 sm:border-r">
      <p class="text-[0.62rem] font-bold uppercase text-white/46">Required access</p>
      <p class="mt-3 text-xs leading-6 text-white/68">{proof.permission}</p>
    </div>
    <div class="p-5">
      <p class="text-[0.62rem] font-bold uppercase text-signal">Current limits</p>
      <p class="mt-3 text-xs leading-6 text-white/68">{proof.boundary}</p>
    </div>
  </footer>
</section>
