<figure
  class="home-brain-visual relative min-h-[24rem] overflow-hidden border-t border-white/20 bg-black sm:min-h-[34rem] lg:min-h-0 lg:border-l lg:border-t-0"
  data-brain-field
  tabindex="0"
  aria-labelledby="brain-field-caption"
  aria-describedby="brain-field-instructions"
>
  <canvas class="home-brain-canvas absolute inset-0 h-full w-full" data-brain-canvas aria-hidden="true"></canvas>

  <div class="absolute left-4 top-4 z-10 flex items-center gap-2 border border-white/25 bg-black/90 px-3 py-2 font-mono text-[0.58rem] font-bold uppercase text-white/72 sm:left-5 sm:top-5">
    <span class="brain-status-mark h-1.5 w-1.5 bg-signal" aria-hidden="true"></span>
    <span data-brain-status>Signal field / Autonomous</span>
  </div>

  <div class="absolute right-4 top-4 z-10 hidden border border-white/20 bg-black/88 px-3 py-2 font-mono text-[0.54rem] font-bold uppercase text-white/48 sm:block sm:right-5 sm:top-5">
    Move / Trace&nbsp;&nbsp; Click / Pulse
  </div>

  <figcaption id="brain-field-caption" class="absolute inset-x-0 bottom-0 z-10 grid gap-2 border-t border-white/20 bg-black/94 px-4 py-3 font-mono text-[0.56rem] font-bold uppercase text-white/58 sm:grid-cols-[auto_1fr] sm:px-5">
    <span class="text-signal">Reference architecture / Public view</span>
    <span class="sm:text-right">Agent infrastructure / Research tools / Hosted MCPs</span>
  </figcaption>

  <p id="brain-field-instructions" class="sr-only">
    Interactive computational brain field. Move the pointer to distort the network. Click, tap, or press Enter to send a signal pulse.
  </p>
</figure>

<script>
  import { mountInteractiveBrains } from "../scripts/interactive-brain";

  mountInteractiveBrains();
