---
const phases = [
  { id: "01", label: "Product", state: "verified", detail: "scope locked" },
  { id: "02", label: "Architecture", state: "verified", detail: "boundaries mapped" },
  { id: "03", label: "Implementation", state: "running", detail: "worker 03 active" },
  { id: "04", label: "Validation", state: "queued", detail: "12 checks ready" },
  { id: "05", label: "UI smoke", state: "queued", detail: "2 viewports" },
  { id: "06", label: "Domain checks", state: "queued", detail: "policy loaded" },
  { id: "07", label: "Export", state: "queued", detail: "artifact pending" },
  { id: "08", label: "Critique", state: "queued", detail: "repair gate" },
];
---

<section class="run-signal relative max-w-full overflow-hidden bg-ink text-white" aria-label="Monarchic campaign run">
  <div class="run-grid pointer-events-none absolute inset-0 opacity-35"></div>

  <header class="relative flex min-h-14 flex-wrap items-center justify-between gap-3 border-b border-white/20 px-4 py-3 sm:px-6">
    <div class="flex items-center gap-3">
      <span class="run-pulse h-2.5 w-2.5 bg-signal" aria-hidden="true"></span>
      <p class="font-mono text-[0.68rem] font-bold uppercase text-white/72">Campaign 042 / Active</p>
    </div>
    <div class="flex items-center gap-4 font-mono text-[0.65rem] uppercase text-white/48">
      <span>Repository connected</span>
      <span class="hidden sm:inline">03 workers</span>
      <span class="text-signal">Evidence on</span>
    </div>
  </header>

  <div class="relative grid min-w-0 grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,1.45fr)_minmax(19rem,0.55fr)]">
    <div class="min-w-0 border-b border-white/20 lg:border-b-0 lg:border-r">
      <div class="grid min-h-40 content-between gap-8 border-b border-white/20 px-4 py-6 sm:px-6 sm:py-8">
        <div class="flex flex-wrap items-start justify-between gap-5">
          <div class="min-w-0">
            <p class="font-mono text-[0.65rem] font-bold uppercase text-signal">Operator goal</p>
            <h2 class="mt-3 max-w-3xl text-2xl font-black uppercase leading-[1.02] sm:text-4xl">
              Harden checkout recovery and prove every release condition.
            </h2>
          </div>
          <div class="border-l border-white/20 pl-4 font-mono text-[0.65rem] uppercase leading-5 text-white/54">
            <p>Branch / main</p>
            <p>Budget / 32 credits</p>
            <p>Policy / guarded</p>
          </div>
        </div>
        <div class="flex min-w-0 items-center gap-3 font-mono text-xs text-white/68">
          <span class="text-signal">monarchic</span>
          <span class="text-white/32">/</span>
          <span class="truncate">repair payment retry path and validate production behavior</span>
          <span class="run-cursor h-4 w-2 shrink-0 bg-white/90" aria-hidden="true"></span>
        </div>
      </div>

      <ol class="divide-y divide-white/14">
        {phases.map((phase) => (
          <li class:list={[
            "run-phase grid min-h-12 grid-cols-[2.2rem_minmax(0,1fr)_auto] items-center gap-3 px-4 py-3 font-mono text-[0.68rem] sm:grid-cols-[2.8rem_minmax(8rem,0.45fr)_minmax(0,1fr)_auto] sm:px-6",
            phase.state === "running" && "is-running",
          ]}>
            <span class="text-white/38">{phase.id}</span>
            <span class="font-bold uppercase text-white">{phase.label}</span>
            <span class="hidden truncate text-white/46 sm:block">{phase.detail}</span>
            <span class:list={[
              "justify-self-end uppercase",
              phase.state === "verified" && "text-paper",
              phase.state === "running" && "text-signal",
              phase.state === "queued" && "text-white/34",
            ]}>
              {phase.state}
            </span>
          </li>
        ))}
      </ol>
    </div>

    <aside class="grid min-w-0 content-between">
      <div>
        <div class="border-b border-white/20 px-5 py-5">
          <p class="font-mono text-[0.65rem] font-bold uppercase text-white/42">Completion gate</p>
          <div class="mt-4 flex items-end justify-between gap-4">
            <p class="text-5xl font-black leading-none">2/8</p>
            <p class="pb-1 font-mono text-[0.65rem] uppercase text-signal">Goal not claimable</p>
          </div>
          <div class="mt-5 grid grid-cols-8 gap-1" aria-hidden="true">
            <span class="h-2 bg-paper"></span>
            <span class="h-2 bg-paper"></span>
            <span class="run-progress h-2 bg-signal"></span>
            <span class="h-2 bg-white/16"></span>
            <span class="h-2 bg-white/16"></span>
            <span class="h-2 bg-white/16"></span>
            <span class="h-2 bg-white/16"></span>
            <span class="h-2 bg-white/16"></span>
          </div>
        </div>

        <dl class="divide-y divide-white/14 px-5">
          <div class="grid grid-cols-[1fr_auto] gap-4 py-4">
            <dt class="font-mono text-[0.65rem] uppercase text-white/44">Receipts</dt>
            <dd class="font-mono text-xs text-white">09</dd>
          </div>
          <div class="grid grid-cols-[1fr_auto] gap-4 py-4">
            <dt class="font-mono text-[0.65rem] uppercase text-white/44">Files changed</dt>
            <dd class="font-mono text-xs text-white">07</dd>
          </div>
          <div class="grid grid-cols-[1fr_auto] gap-4 py-4">
            <dt class="font-mono text-[0.65rem] uppercase text-white/44">Checks passed</dt>
            <dd class="font-mono text-xs text-paper">12</dd>
          </div>
          <div class="grid grid-cols-[1fr_auto] gap-4 py-4">
            <dt class="font-mono text-[0.65rem] uppercase text-white/44">Risk findings</dt>
            <dd class="font-mono text-xs text-signal">01 open</dd>
          </div>
        </dl>
      </div>

      <div class="border-t border-white/20 bg-signal p-5 text-black">
        <p class="font-mono text-[0.65rem] font-bold uppercase">Current operation</p>
        <p class="mt-3 text-lg font-black uppercase leading-tight">Implement retry idempotency guard</p>
        <div class="mt-5 h-1.5 overflow-hidden bg-black/20">
          <span class="run-scan block h-full w-2/3 bg-black"></span>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .run-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .run-phase {
    position: relative;
  }

  .run-phase.is-running {
    background: color-mix(in srgb, var(--color-signal) 8%, transparent);
  }

  .run-phase.is-running::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--color-signal);
    content: "";
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.28;
    }
  }

  @keyframes scan {
    0% {
      transform: translateX(-18%);
    }
    50% {
      transform: translateX(12%);
    }
    100% {
      transform: translateX(-18%);
    }
  }

  .run-pulse,
  .run-cursor {
    animation: pulse 1.35s steps(2, end) infinite;
  }

  .run-progress {
    animation: pulse 1.9s ease-in-out infinite;
  }

  .run-scan {
    animation: scan 3.8s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .run-pulse,
    .run-cursor,
    .run-progress,
    .run-scan {
      animation: none;
    }
  }
</style>
