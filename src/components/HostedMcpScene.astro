<section class="border-b border-white/20 bg-[#0b0b0b] text-white" aria-label="Example RepoIntel request and response">
  <div class="grid lg:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.65fr)]">
    <div class="grid min-w-0 content-between gap-8 border-b border-white/20 px-4 py-7 sm:px-6 sm:py-9 lg:border-b-0 lg:border-r">
      <div>
        <p class="font-mono text-[0.65rem] font-bold uppercase text-signal">RepoIntel request</p>
        <h2 class="mt-3 max-w-4xl text-2xl font-black uppercase leading-[1.02] sm:text-4xl">
          Map this repository and return source-cited architecture.
        </h2>
      </div>
      <div class="min-w-0 border-l-2 border-signal pl-4 font-mono text-xs leading-6 text-white/76">
        <p class="truncate"><span class="text-signal">repointel</span> repository map --include-citations</p>
        <p class="text-white/52">HTTP / scoped key</p>
      </div>
    </div>

    <aside class="bg-signal p-5 text-black sm:p-7">
      <p class="font-mono text-[0.65rem] font-bold uppercase">Example response</p>
      <h3 class="mt-4 text-2xl font-black uppercase leading-tight">Architecture map ready.</h3>
      <dl class="mt-7 border-y border-black/32 font-mono text-[0.65rem] uppercase">
        <div class="flex items-center justify-between gap-4 border-b border-black/24 py-3">
          <dt>Summary</dt>
          <dd class="font-bold">Returned</dd>
        </div>
        <div class="flex items-center justify-between gap-4 border-b border-black/24 py-3">
          <dt>Source citations</dt>
          <dd class="font-bold">Linked</dd>
        </div>
        <div class="flex items-center justify-between gap-4 py-3">
          <dt>Usage receipt</dt>
          <dd class="font-bold">Recorded</dd>
        </div>
      </dl>
    </aside>
  </div>
</section>
