---
import { webappBaseUrl } from "../lib/publicUrls";

interface Props {
  tone?: "dark" | "paper";
}

const { tone = "dark" } = Astro.props;
---

<footer
  id="footer"
  class:list={[
    "grid gap-8 border-t px-4 py-8 sm:grid-cols-[1fr_auto] sm:items-end sm:px-6 sm:py-10",
    tone === "paper" ? "border-black bg-paper text-black" : "border-white text-white",
  ]}
>
  <div>
    <a href="/" class="motion-link inline-flex items-center gap-3">
      <span class:list={["inline-flex h-8 w-8 items-center justify-center", tone === "paper" ? "bg-black" : "bg-paper"]}>
        <img src="/favicon.svg" alt="" class:list={["h-6 w-6 object-cover p-0.5", tone === "paper" && "invert"]} width="24" height="24" />
      </span>
      <span class="text-xs font-extrabold uppercase">Monarchic</span>
    </a>
    <p class:list={["mt-4 max-w-xl text-sm leading-6", tone === "paper" ? "text-black/64" : "text-white/68"]}>
      Independent AI research and development.
    </p>
  </div>
  <nav
    aria-label="Footer"
    class:list={[
      "flex flex-wrap gap-x-5 gap-y-3 text-xs font-bold uppercase sm:justify-end",
      tone === "paper" ? "text-black/68" : "text-white/70",
    ]}
  >
    <a href="/company" class="motion-link hover:text-signal">Company</a>
    <a href="/research" class="motion-link hover:text-signal">Research</a>
    <a href="/products" class="motion-link hover:text-signal">Products</a>
    <a href="/security" class="motion-link hover:text-signal">Security</a>
    <a href={`${webappBaseUrl}/setup`} class="motion-link hover:text-signal">Setup</a>
    <a href="/privacy" class="motion-link hover:text-signal">Privacy</a>
    <a href="/terms" class="motion-link hover:text-signal">Terms</a>
  </nav>
  <p class:list={["text-xs leading-5 sm:col-span-2 sm:text-right", tone === "paper" ? "text-black/46" : "text-white/42"]}>
    &copy; {new Date().getFullYear()} Monarchic. All rights reserved. Contact <a class="underline-offset-4 hover:underline" href="mailto:support@monarchic.io">support@monarchic.io</a>.
  </p>
</footer>
