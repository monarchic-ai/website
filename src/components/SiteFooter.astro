---
const appBaseUrl = (import.meta.env.PUBLIC_MONARCHIC_WEBAPP_BASE_URL ?? "https://app.monarchic.io").replace(/\/$/, "");
---

<footer id="footer" class="grid gap-8 border-t-2 border-white py-8 sm:grid-cols-[1fr_auto] sm:items-end">
  <div>
    <a href="/" class="inline-flex items-center gap-3">
      <img src="/favicon.svg" alt="" class="h-8 w-8 bg-white object-cover p-1" width="32" height="32" />
      <span class="text-xs font-extrabold uppercase">Monarchic</span>
    </a>
    <p class="mt-4 max-w-xl text-sm leading-6 text-white/58">
      Hosted MCPs for software delivery, operations, research, and agent workflows.
    </p>
  </div>
  <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-3 text-xs font-bold uppercase text-white/70 sm:justify-end">
    <a href="/products" class="hover:text-white">Products</a>
    <a href={`${appBaseUrl}/docs`} class="hover:text-white">Docs</a>
    <a href="/research" class="hover:text-white">Research</a>
    <a href="/waitlist" class="hover:text-white">Access</a>
    <a href="/privacy" class="hover:text-white">Privacy</a>
    <a href="/terms" class="hover:text-white">Terms</a>
  </nav>
  <p class="text-xs leading-5 text-white/42 sm:col-span-2 sm:text-right">
    &copy; {new Date().getFullYear()} Monarchic. All rights reserved. Contact <a class="text-white/68 hover:text-white" href="mailto:support@monarchic.io">support@monarchic.io</a>.
  </p>
</footer>
