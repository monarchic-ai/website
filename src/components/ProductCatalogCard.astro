---
import {
  planStatusLabel,
  type CatalogPlan,
} from "../lib/pricing";
import { getProductDetail } from "../lib/productDetails";

interface Props {
  plan: CatalogPlan;
  researchHref?: string;
}

const { plan, researchHref } = Astro.props;
const detail = getProductDetail(plan.slug);
const statusClass = plan.status === "available"
  ? "border-signal bg-signal text-black"
  : plan.status === "contact_sales"
    ? "border-white/70 text-white"
    : "border-white/35 text-white/58";
---

<article
  data-plan-card={plan.slug}
  class="group flex min-h-[285px] flex-col border border-white/45 bg-black/66 p-5 transition duration-200 hover:-translate-y-1 hover:border-signal hover:bg-signal/[0.06] focus-within:-translate-y-1 focus-within:border-signal"
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <span class="text-[0.62rem] font-bold uppercase text-white/48">{detail?.category ?? "MCP"}</span>
    <span class={`border px-2 py-1 text-[0.6rem] font-bold uppercase ${statusClass}`}>
      {planStatusLabel(plan.status)}
    </span>
  </div>
  <h3 class="mt-5 text-xl font-extrabold uppercase">{plan.displayName}</h3>
  <p class="mt-3 text-sm leading-6 text-white/68">{plan.tagline}</p>
  <p class="mt-4 text-xs font-bold uppercase text-white/46">
    {plan.status === "available" ? "Included in shared plan usage" : "Shared plan usage when available"}
  </p>
  <div class="flex-1"></div>
  <div class="mt-6 flex flex-wrap gap-2">
    <a href={`/products/${plan.slug}`} class="border border-white/50 px-3 py-2 text-xs font-bold uppercase transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">Details</a>
    {researchHref && (
      <a href={researchHref} class="border border-signal/70 px-3 py-2 text-xs font-bold uppercase text-signal-soft transition hover:bg-signal/10 hover:text-white">Benchmark</a>
    )}
  </div>
</article>
