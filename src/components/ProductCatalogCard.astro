---
import {
  catalogStatusLabel,
  hostedMcpStatus,
  type CatalogPlan,
} from "../lib/pricing";
import { getProductDetail } from "../lib/productDetails";

interface Props {
  plan: CatalogPlan;
  researchHref?: string;
}

const { plan, researchHref } = Astro.props;
const detail = getProductDetail(plan.slug);
const hostedStatus = hostedMcpStatus(plan);
const statusClass = hostedStatus === "available"
  ? "border-signal bg-signal text-black"
  : hostedStatus === "in_rollout"
    ? "border-signal/80 bg-signal/10 text-signal-soft"
    : "border-white/35 text-white/58";
---

<article
  data-plan-card={plan.slug}
  class="group flex min-h-[350px] flex-col border border-white/45 bg-black/66 p-5 transition hover:border-signal focus-within:border-signal"
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <span class="text-[0.62rem] font-bold uppercase text-white/48">{detail?.category ?? "MCP"}</span>
    <span class={`border px-2 py-1 text-[0.6rem] font-bold uppercase ${statusClass}`}>
      {hostedStatus === "planned" ? "Coming soon" : catalogStatusLabel(plan)}
    </span>
  </div>
  <h3 class="mt-5 text-xl font-extrabold uppercase">{plan.displayName}</h3>
  <p class="mt-3 text-sm leading-6 text-white/68">{detail?.useCase ?? plan.tagline}</p>
  {detail && (
    <dl class="mt-4 grid gap-3 border-t border-white/20 pt-4 text-xs leading-5">
      <div>
        <dt class="font-bold uppercase text-white/42">Best for</dt>
        <dd class="mt-1 text-white/62">{detail.buyer}</dd>
      </div>
      <div>
        <dt class="font-bold uppercase text-white/42">Primary outcome</dt>
        <dd class="mt-1 text-white/62">{detail.outcomes[0]}</dd>
      </div>
    </dl>
  )}
  <p class="mt-4 text-xs font-bold uppercase text-white/46">
    {hostedStatus === "available"
      ? "Included in shared plan usage"
      : hostedStatus === "in_rollout"
        ? "Hosted rollout underway"
        : "Hosted access coming soon"}
  </p>
  <div class="flex-1"></div>
  <div class="mt-6 flex flex-wrap gap-2">
    <a href={`/products/${plan.slug}`} class="border border-white/50 px-3 py-2 text-xs font-bold uppercase transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">Details</a>
    {researchHref && (
      <a href={researchHref} class="border border-signal/70 px-3 py-2 text-xs font-bold uppercase text-signal-soft transition hover:bg-signal/10 hover:text-white">Research</a>
    )}
  </div>
</article>
