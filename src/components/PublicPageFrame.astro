---
import OperatingStatusRail from "./OperatingStatusRail.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  active?: "products" | "research" | "support";
  researchBrief?: string;
  researchStatus?: string;
  researchTitle?: string;
}

const { active, researchBrief, researchStatus, researchTitle } = Astro.props;
---

<main
  data-research-brief={researchBrief}
  data-research-status={researchStatus}
  class="site-frame mx-auto flex min-h-screen max-w-[1480px] flex-col border-x border-white/20 bg-ink text-white"
>
  <SiteHeader active={active} />
  <OperatingStatusRail currentResearch={researchTitle} />
  <div class="flex-1">
    <slot />
  </div>
  <SiteFooter />
</main>
