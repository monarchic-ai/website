---
import Shader14 from "../../components/Shader14.astro";
import SeoHead from "../../components/SeoHead.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import "../../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title="Research | Monarchic"
      description="Published Monarchic benchmarks with named datasets, methods, results, and limitations."
      path="/research"
    />
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="relative min-h-screen overflow-hidden">
      <Shader14 className="pointer-events-none fixed inset-0 h-full w-full opacity-55" />
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_bottom,_rgba(0,0,0,0.72),_rgba(0,0,0,0.97))]"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-5 py-6 sm:px-6 sm:py-10">
        <SiteHeader active="research" />

        <section class="grid gap-8 border-b-2 border-white py-12 lg:min-h-[500px] lg:grid-cols-[1.25fr_0.75fr] lg:items-center">
          <div>
            <p class="inline-flex border border-white/50 bg-black/60 px-3 py-2 text-xs font-bold uppercase text-white/70">
              Research
            </p>
            <h1 class="mt-6 max-w-5xl text-5xl font-extrabold uppercase leading-[0.86] text-white sm:text-7xl lg:text-8xl [text-shadow:8px_8px_0_rgba(255,255,255,0.11)]">
              Benchmarks and methodology.
            </h1>
            <p class="mt-7 max-w-2xl text-base leading-8 text-white/76 sm:text-lg">
              We publish a research page only when a result has a named dataset,
              a dated reproducible run, clear scoring rules, and documented limits.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#published-benchmarks" class="inline-flex min-h-12 items-center justify-center border-2 border-signal bg-signal px-5 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">
                View benchmark
              </a>
              <a href="/products" class="inline-flex min-h-12 items-center justify-center border-2 border-white/50 px-5 text-xs font-bold uppercase transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">
                Browse products
              </a>
            </div>
          </div>

          <aside class="border-2 border-white bg-black/78 p-6 shadow-[10px_10px_0_rgba(255,255,255,0.1)]">
            <p class="text-xs font-bold uppercase text-signal">Publication bar</p>
            <h2 class="mt-4 text-3xl font-extrabold uppercase">Evidence before claims</h2>
            <ul class="mt-6 grid gap-4 text-sm leading-6 text-white/72">
              <li class="border-l-2 border-signal pl-4">Named public dataset or protocol</li>
              <li class="border-l-2 border-signal pl-4">Dated run with a meaningful sample</li>
              <li class="border-l-2 border-signal pl-4">Scoring method and runtime boundary</li>
              <li class="border-l-2 border-signal pl-4">Failures and limitations beside the result</li>
            </ul>
          </aside>
        </section>

        <section id="published-benchmarks" class="scroll-mt-6 py-12">
          <p class="text-xs font-bold uppercase text-white/52">Published benchmark</p>
          <h2 class="mt-3 text-3xl font-extrabold uppercase leading-none sm:text-5xl">ExplicitMem on LongMemEval-S</h2>

          <article class="group mt-7 grid gap-0 border-2 border-white/70 bg-black/76 transition duration-200 hover:-translate-y-1 hover:border-signal focus-within:-translate-y-1 focus-within:border-signal lg:grid-cols-[0.85fr_1.15fr]">
            <div class="border-b-2 border-white/40 p-6 transition group-hover:border-signal/50 lg:border-r-2 lg:border-b-0">
              <p class="text-xs font-bold uppercase text-signal">500-question reproduced run</p>
              <p class="mt-5 text-6xl font-extrabold leading-none sm:text-7xl">97.8%</p>
              <p class="mt-3 text-xs font-bold uppercase text-white/58">Answer accuracy</p>
              <dl class="mt-8 grid grid-cols-2 gap-3">
                <div class="border border-white/30 p-3">
                  <dt class="text-[0.65rem] font-bold uppercase text-white/48">Faithfulness</dt>
                  <dd class="mt-2 text-xl font-extrabold">99.8%</dd>
                </div>
                <div class="border border-white/30 p-3">
                  <dt class="text-[0.65rem] font-bold uppercase text-white/48">Recall@K</dt>
                  <dd class="mt-2 text-xl font-extrabold">100%</dd>
                </div>
                <div class="border border-white/30 p-3">
                  <dt class="text-[0.65rem] font-bold uppercase text-white/48">Local latency</dt>
                  <dd class="mt-2 text-xl font-extrabold">63.3 ms</dd>
                </div>
                <div class="border border-white/30 p-3">
                  <dt class="text-[0.65rem] font-bold uppercase text-white/48">Context</dt>
                  <dd class="mt-2 text-xl font-extrabold">797 tok</dd>
                </div>
              </dl>
            </div>
            <div class="flex flex-col p-6 sm:p-8">
              <p class="text-xs font-bold uppercase text-white/48">Generated 9 June 2026</p>
              <h3 class="mt-4 text-3xl font-extrabold uppercase">Durable memory with an 800-token context budget</h3>
              <p class="mt-5 max-w-2xl text-sm leading-7 text-white/72">
                The run evaluated all 500 LongMemEval-S questions with a
                50-result retrieval limit and an 800-token context budget.
                Retrieval recall and receipt coverage were complete; temporal
                reasoning produced the largest share of answer failures.
              </p>
              <p class="mt-4 max-w-2xl text-sm leading-7 text-signal-soft/80">
                This result describes one fixed configuration. It should not be
                read as a universal memory ranking.
              </p>
              <div class="mt-auto flex flex-wrap gap-3 pt-8">
                <a href="/research/explicitmem" class="inline-flex min-h-11 items-center justify-center border-2 border-signal bg-signal px-4 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">
                  Method and results
                </a>
                <a href="/products/mcp-explicitmem" class="inline-flex min-h-11 items-center justify-center border-2 border-white/50 px-4 text-xs font-bold uppercase transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">
                  ExplicitMem product
                </a>
              </div>
            </div>
          </article>
        </section>

        <SiteFooter />
      </div>
    </main>
  </body>
</html>
