---
import Shader14 from "../../components/Shader14.astro";
import SeoHead from "../../components/SeoHead.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import "../../styles/global.css";

const researchCards = [
  {
    index: "01",
    name: "ExplicitMem",
    href: "/research/explicitmem",
    productHref: "/products/mcp-explicitmem",
    label: "Memory Runtime",
    score: "97.8%",
    metric: "LongMemEval-S accuracy",
    description:
      "Typed memory objects, graph links, bounded context synthesis, and receipt-backed retrieval measured against LongMemEval-S.",
  },
  {
    index: "02",
    name: "RepoIntel",
    href: "/research/repointel",
    productHref: "/products/mcp-repointel",
    label: "Repository Intelligence",
    score: "0.9979",
    metric: "RepoIntel-Bench score",
    description:
      "Code, symbol, and evidence retrieval measured with the RepoIntel-Bench dataset and scoring harness.",
  },
  {
    index: "03",
    name: "BrowserOps",
    href: "/research/browserops",
    productHref: "/products/mcp-browserops",
    label: "Browser Verification",
    score: "7/7",
    metric: "Reliability checks passed",
    description:
      "Screenshot, console, network, and scenario verification exercised through a bounded reliability check set.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      title="Research | Monarchic LLC"
      description="Benchmark notes, receipts, and reliability checks for Monarchic MCP products."
      path="/research"
    />
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="relative min-h-screen overflow-hidden">
      <Shader14 className="pointer-events-none fixed inset-0 h-full w-full opacity-55" />
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_bottom,_rgba(0,0,0,0.7),_rgba(0,0,0,0.97))]"></div>
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(90deg,_rgba(0,0,0,0.88),_rgba(0,0,0,0.38)_55%,_rgba(0,0,0,0.82))]"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-5 py-6 sm:px-6 sm:py-10">
        <SiteHeader active="research" />

        <section class="grid gap-7 border-b-2 border-white py-9 lg:min-h-[540px] lg:grid-cols-[1.35fr_0.65fr] lg:items-center lg:py-10">
          <div>
            <p class="mb-5 inline-flex border border-white/50 bg-black/60 px-3 py-2 text-xs font-bold uppercase text-white/70">
              Research / Evidence Index
            </p>
            <h1 class="max-w-5xl text-5xl font-extrabold uppercase leading-[0.86] text-white sm:text-7xl lg:text-8xl [text-shadow:8px_8px_0_rgba(255,255,255,0.11)]">
              Research receipts for production agent tools.
            </h1>
            <p class="mt-7 max-w-2xl text-base leading-8 text-white/76 sm:text-lg">
              Benchmark notes connect each result to the MCP that produced it, with the test boundary kept in view.
            </p>
            <div class="mt-7 flex flex-wrap gap-3 text-xs font-bold uppercase">
              <a href="/products" class="inline-flex items-center justify-center border-2 border-cyan-300 bg-cyan-300/10 px-5 py-3 text-cyan-100 transition hover:bg-cyan-300/20 hover:text-white focus-visible:bg-cyan-300/20 focus-visible:text-white">
                Explore MCP products
              </a>
              <a href="#research-notes" class="inline-flex items-center justify-center border-2 border-white/50 px-5 py-3 transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-100 focus-visible:border-cyan-300 focus-visible:bg-cyan-300/10 focus-visible:text-cyan-100">
                Open research
              </a>
            </div>
          </div>

          <aside aria-label="Current offer and research status" class="border-2 border-white bg-black/78 shadow-[10px_10px_0_rgba(255,255,255,0.1)]">
            <div class="flex items-center justify-between gap-4 border-b-2 border-white px-5 py-4">
              <p class="text-xs font-bold uppercase text-white/58">Commercial surface</p>
              <span class="border border-emerald-300 px-2 py-1 text-[0.65rem] font-bold uppercase text-emerald-200">Current</span>
            </div>
            <div class="p-5 sm:p-6">
              <h2 class="text-3xl font-extrabold uppercase leading-none">MCP product catalog</h2>
              <p class="mt-4 text-sm leading-7 text-white/72">
                The currently available commercial surface is the MCP product catalog.
              </p>
              <dl class="mt-6 divide-y divide-white/25 border-y border-white/40">
                <div class="flex items-center justify-between gap-4 py-3">
                  <dt class="text-xs font-bold uppercase text-white/50">Subjects</dt>
                  <dd class="text-sm font-extrabold">03</dd>
                </div>
                <div class="flex items-center justify-between gap-4 py-3">
                  <dt class="text-xs font-bold uppercase text-white/50">Evidence notes</dt>
                  <dd class="text-sm font-extrabold">03</dd>
                </div>
                <div class="flex items-center justify-between gap-4 py-3">
                  <dt class="text-xs font-bold uppercase text-white/50">Scope state</dt>
                  <dd class="text-sm font-extrabold uppercase">Bounded</dd>
                </div>
              </dl>
              <a href="/products" class="mt-6 inline-flex w-full items-center justify-between border-2 border-white/50 px-4 py-3 text-xs font-bold uppercase transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-100 focus-visible:border-cyan-300 focus-visible:bg-cyan-300/10 focus-visible:text-cyan-100">
                Open catalog <span aria-hidden="true">↗</span>
              </a>
            </div>
          </aside>
        </section>

        <section id="research-notes" class="scroll-mt-5 py-10">
          <div class="mb-6 grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end">
            <div>
              <p class="text-xs font-bold uppercase text-white/52">Research subjects</p>
              <h2 class="mt-3 text-3xl font-extrabold uppercase leading-none sm:text-5xl">Three tools. Three bounded results.</h2>
            </div>
            <p class="text-xs font-bold uppercase text-white/50 sm:text-right">ExplicitMem / RepoIntel / BrowserOps</p>
          </div>

          <div class="grid gap-4 lg:grid-cols-3">
            {researchCards.map((card) => (
              <article class="group flex min-h-[430px] flex-col border-2 border-white/70 bg-black/76 transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-white">
                <div class="flex items-center justify-between gap-4 border-b-2 border-white px-5 py-3 group-hover:border-black">
                  <p class="text-[0.68rem] font-bold uppercase text-white/58 group-hover:text-cyan-100/70">Test record {card.index}</p>
                  <span class="text-xs font-extrabold">{card.index} / 03</span>
                </div>
                <div class="flex flex-1 flex-col p-5 sm:p-6">
                  <p class="text-xs font-bold uppercase text-white/52 group-hover:text-cyan-100/70">{card.label}</p>
                  <h3 class="mt-3 text-3xl font-extrabold uppercase sm:text-4xl">{card.name}</h3>
                  <div class="mt-6 border-y border-white/40 py-5 group-hover:border-black/40">
                    <p class="text-4xl font-extrabold leading-none sm:text-5xl">{card.score}</p>
                    <p class="mt-2 text-[0.68rem] font-bold uppercase text-white/58 group-hover:text-cyan-100/70">{card.metric}</p>
                  </div>
                  <p class="mt-5 text-sm leading-7 text-white/72 group-hover:text-white/82">{card.description}</p>
                  <div class="mt-auto grid grid-cols-2 gap-2 pt-6 text-center text-[0.68rem] font-bold uppercase">
                    <a href={card.href} class="border-2 border-cyan-300 bg-cyan-300/10 px-3 py-3 text-cyan-100 transition hover:bg-cyan-300/20 hover:text-white">
                      Open research
                    </a>
                    <a href={card.productHref} class="border-2 border-white/50 px-3 py-3 transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-100">
                      Open product
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section aria-labelledby="scope-heading" class="mb-8 grid border-2 border-white bg-black/82 lg:grid-cols-[0.34fr_1fr]">
          <div class="border-b-2 border-cyan-300/60 bg-zinc-950 p-5 text-white lg:border-r-2 lg:border-b-0 sm:p-6">
            <p class="text-xs font-bold uppercase text-cyan-200">Evidence boundary</p>
            <h2 id="scope-heading" class="mt-3 text-3xl font-extrabold uppercase leading-none">Read the limits with the result.</h2>
          </div>
          <div class="flex items-center p-5 sm:p-6 lg:p-8">
            <p class="max-w-4xl text-sm leading-7 text-white/76 sm:text-base">
              Each result is limited to its named benchmark, dataset, scoring rules, and runtime conditions; it is not a universal ranking or guarantee.
            </p>
          </div>
        </section>
        <SiteFooter />
      </div>
    </main>
  </body>
</html>
