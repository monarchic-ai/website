---
import SeoHead from "../../components/SeoHead.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { explicitMemBenchmark } from "../../lib/explicitmemBenchmark";
import { mcpResearchEntries, RESEARCH_REVIEWED_ON } from "../../lib/mcpResearch";
import { catalogStatusLabel } from "../../lib/pricing";
import "../../styles/global.css";

const publishedStudy = mcpResearchEntries[0];
if (!publishedStudy) throw new Error("The approved research index is empty");

const evidenceClasses = [
  {
    label: "Research evidence",
    definition: "A dated method, named dataset or protocol, measured result, stated limitation, and inspectable artifact.",
    destination: "/research/explicitmem",
    action: "Open published study",
  },
  {
    label: "Engineering verification",
    definition: "A concrete product call, output contract, permission requirement, and current operating boundary. It verifies behavior, not comparative performance.",
    destination: "/products",
    action: "Inspect product proofs",
  },
  {
    label: "Operational evidence",
    definition: "Deployment, access, security, and lifecycle records used to describe what is available and how it is operated.",
    destination: "/security",
    action: "Review operations",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title="Research | Monarchic"
      description="Published Monarchic studies with named methods, measured results, inspectable artifacts, and explicit limits."
      path="/research"
    />
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="min-h-screen">
      <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-10">
        <SiteHeader active="research" />

        <section class="border-b-2 border-white py-12 sm:py-16">
          <p class="font-mono text-[0.68rem] font-bold uppercase text-signal">Reviewed {RESEARCH_REVIEWED_ON}</p>
          <h1 class="mt-4 max-w-5xl text-5xl font-extrabold uppercase leading-[0.86] text-white sm:text-7xl lg:text-8xl">
            Methods, evidence, limits.
          </h1>
          <p class="mt-7 max-w-3xl text-base leading-8 text-white/76 sm:text-lg">
            We publish research when a claim has a fixed method, a dated result, an inspectable artifact, and a useful limitation. Product availability and research publication are assessed separately; catalog entries do not need uniform research coverage.
          </p>
        </section>

        <section aria-labelledby="evidence-classes-title" class="border-b-2 border-white py-12">
          <h2 id="evidence-classes-title" class="text-3xl font-extrabold uppercase sm:text-4xl">Three evidence classes</h2>
          <div class="mt-7 grid border border-white/45 lg:grid-cols-3">
            {evidenceClasses.map((evidence, index) => (
              <article class:list={["flex min-h-64 flex-col p-5 sm:p-6", index < evidenceClasses.length - 1 && "border-b border-white/35 lg:border-b-0 lg:border-r"]}>
                <p class="font-mono text-[0.62rem] font-bold uppercase text-signal">0{index + 1}</p>
                <h3 class="mt-4 text-xl font-extrabold uppercase">{evidence.label}</h3>
                <p class="mt-3 text-sm leading-7 text-white/64">{evidence.definition}</p>
                <a href={evidence.destination} class="mt-auto pt-6 text-xs font-extrabold uppercase text-signal hover:text-white">{evidence.action} <span aria-hidden="true">→</span></a>
              </article>
            ))}
          </div>
        </section>

        <section id="published-study" class="scroll-mt-6 py-12">
          <div class="grid gap-5 lg:grid-cols-[1fr_0.72fr] lg:items-end">
            <div>
              <p class="text-xs font-bold uppercase text-signal">Published research / {mcpResearchEntries.length}</p>
              <h2 class="mt-3 text-3xl font-extrabold uppercase leading-none sm:text-5xl">ExplicitMem evaluations</h2>
            </div>
            <p class="text-sm leading-7 text-white/62">
              Four evaluation views cover LongMemEval-S synthesis, LoCoMo retrieval, cross-dataset candidate generation, and generic-answer support. Each keeps its own metric and caveat.
            </p>
          </div>

          <article
            data-research-card={publishedStudy.productSlug}
            data-research-status={publishedStudy.hostedStatus}
            class="group mt-7 grid border-2 border-white/70 bg-black/76 transition hover:border-signal focus-within:border-signal lg:grid-cols-[0.82fr_1.18fr]"
          >
            <div class="border-b-2 border-white/40 p-6 transition group-hover:border-signal/50 lg:border-r-2 lg:border-b-0">
              <div class="flex flex-wrap justify-between gap-3">
                <p class="text-xs font-bold uppercase text-signal">{explicitMemBenchmark.questions}-question LongMemEval-S run</p>
                <span class="border border-signal bg-signal px-2 py-1 text-[0.62rem] font-bold uppercase text-black">{catalogStatusLabel(publishedStudy.plan)}</span>
              </div>
              <p class="mt-6 text-6xl font-extrabold leading-none sm:text-7xl">{explicitMemBenchmark.answerAccuracy}</p>
              <p class="mt-3 text-xs font-bold uppercase text-white/58">Answer accuracy / fixed synthesis configuration</p>
              <dl class="mt-8 grid grid-cols-2 gap-3">
                <div class="border border-white/30 p-3">
                  <dt class="text-[0.65rem] font-bold uppercase text-white/48">Faithfulness</dt>
                  <dd class="mt-2 text-xl font-extrabold">{explicitMemBenchmark.answerFaithfulness}</dd>
                </div>
                <div class="border border-white/30 p-3">
                  <dt class="text-[0.65rem] font-bold uppercase text-white/48">Recall@K</dt>
                  <dd class="mt-2 text-xl font-extrabold">{explicitMemBenchmark.retrievalRecallAtK}</dd>
                </div>
              </dl>
            </div>
            <div class="flex flex-col p-6 sm:p-8">
              <p class="text-xs font-bold uppercase text-white/48">{publishedStudy.briefLabel}</p>
              <h3 class="mt-4 text-3xl font-extrabold uppercase">{publishedStudy.question}</h3>
              <p class="mt-5 max-w-2xl text-sm leading-7 text-white/72">{publishedStudy.evaluationLens}</p>
              <p class="mt-4 max-w-2xl border-l-2 border-signal pl-4 text-xs leading-6 text-white/52">{publishedStudy.limit}</p>
              <div class="mt-auto flex flex-wrap gap-3 pt-8">
                <a href={publishedStudy.href} class="inline-flex min-h-11 items-center justify-center border-2 border-signal bg-signal px-4 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">Method and results</a>
                <a href={`/products/${publishedStudy.productSlug}`} class="inline-flex min-h-11 items-center justify-center border-2 border-white/50 px-4 text-xs font-bold uppercase transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">Product details</a>
              </div>
            </div>
          </article>
        </section>

        <SiteFooter />
      </div>
    </main>
  </body>
</html>
