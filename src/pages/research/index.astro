---
import Shader14 from "../../components/Shader14.astro";
import SeoHead from "../../components/SeoHead.astro";
import "../../styles/global.css";

const researchCards = [
  {
    name: "ExplicitMem",
    href: "/research/explicitmem",
    productHref: "/products/mcp-explicitmem",
    label: "Memory Runtime",
    score: "97.8%",
    metric: "LongMemEval-S accuracy",
    description:
      "ExplicitMem is a private memory MCP runtime for typed memory objects, graph links, bounded context synthesis, and receipt-backed retrieval.",
  },
  {
    name: "RepoIntel",
    href: "/research/repointel",
    productHref: "/products/mcp-repointel",
    label: "Repository Intelligence",
    score: "0.9979",
    metric: "RepoIntel-Bench score",
    description:
      "RepoIntel is a repository intelligence MCP runtime for indexing code, symbols, evidence records, generated wiki pages, and change-aware retrieval.",
  },
  {
    name: "BrowserOps",
    href: "/research/browserops",
    productHref: "/products/mcp-browserops",
    label: "Browser Verification",
    score: "7/7",
    metric: "Reliability checks passed",
    description:
      "BrowserOps is a browser evidence and UI verification MCP for agents that need screenshots, console and network diagnostics, scenario checks, and receipt-backed browser QA.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      title="Research | Monarchic AI"
      description="Benchmark notes, receipts, and reliability checks for Monarchic MCP products."
      path="/research"
    />
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="relative min-h-screen overflow-hidden">
      <Shader14
        className="pointer-events-none fixed inset-0 h-full w-full opacity-70"
      />
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_bottom,_rgba(0,0,0,0.68),_rgba(0,0,0,0.94))]"></div>

      <section class="relative z-10 mx-auto max-w-7xl px-6 py-8 sm:py-12">
        <header class="flex flex-wrap items-center justify-between gap-5 border-b-2 border-white pb-6">
          <a href="/" class="inline-flex items-center gap-3">
            <img
              src="/favicon.svg"
              alt="Monarchic AI logo"
              class="h-9 w-9 bg-white object-cover p-1"
              width="36"
              height="36"
            />
            <span class="text-[0.7rem] font-semibold uppercase tracking-[0.36em] text-white/72">
              Monarchic AI
            </span>
          </a>
          <nav class="flex flex-wrap items-center gap-2">
            <a href="/products" class="border-2 border-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] transition hover:bg-white hover:text-black">Products</a>
            <a href="/research" class="border-2 border-white bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-black">Research</a>
          </nav>
        </header>

        <div class="py-12">
          <p class="mb-5 text-xs font-semibold uppercase tracking-[0.4em] text-white/64">
            Product Research
          </p>
          <h1 class="max-w-5xl text-4xl font-extrabold uppercase leading-[0.9] sm:text-6xl lg:text-7xl [text-shadow:5px_5px_0_rgba(255,255,255,0.12)]">
            Benchmarks<br />With Receipts
          </h1>
          <p class="mt-7 max-w-3xl text-base leading-8 text-white/78 sm:text-lg">
            These pages show the tests behind the products: what ran, what
            passed, and where the results stop. The point is not to make every
            score sound impressive. It is to make the evidence readable.
          </p>
        </div>

        <section class="grid gap-6 lg:grid-cols-3">
          {researchCards.map((card) => (
            <article
              class="group border-2 border-white bg-black/72 p-5 transition hover:bg-white hover:text-black sm:p-6"
            >
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.32em] text-white/58 group-hover:text-black/58">
                    {card.label}
                  </p>
                  <h2 class="mt-4 text-3xl font-extrabold uppercase sm:text-4xl">
                    {card.name}
                  </h2>
                </div>
                <div class="border border-white px-4 py-3 text-right group-hover:border-black">
                  <p class="text-2xl font-extrabold">{card.score}</p>
                  <p class="mt-1 text-[0.62rem] uppercase tracking-[0.22em] text-white/56 group-hover:text-black/56">
                    {card.metric}
                  </p>
                </div>
              </div>
              <p class="mt-6 max-w-2xl text-sm leading-7 text-white/74 group-hover:text-black/74">
                {card.description}
              </p>
              <div class="mt-6 flex flex-wrap gap-2">
                <a href={card.href} class="inline-flex items-center gap-3 border border-white px-3 py-2 text-xs font-semibold uppercase tracking-[0.22em] transition hover:bg-black hover:text-white group-hover:border-black">
                  Open Research
                  <span class="h-2 w-2 bg-white group-hover:bg-black"></span>
                </a>
                <a href={card.productHref} class="inline-flex items-center border border-white px-3 py-2 text-xs font-semibold uppercase tracking-[0.22em] transition hover:bg-black hover:text-white group-hover:border-black">
                  Product Page
                </a>
              </div>
            </article>
          ))}
        </section>

        <section class="my-10 border-2 border-white bg-black/70 p-5 sm:p-6">
          <h2 class="text-xl font-extrabold uppercase">Scope</h2>
          <p class="mt-4 max-w-5xl text-sm leading-7 text-white/74">
            These notes are scoped to specific benchmarks. A score can show
            progress inside a harness, but it does not prove every real-world
            use case. Product pages should change when datasets, scoring rules,
            or runtime boundaries change.
          </p>
        </section>
      </section>
    </main>
  </body>
</html>
