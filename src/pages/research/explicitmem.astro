---
import Shader14 from "../../components/Shader14.astro";
import SeoHead from "../../components/SeoHead.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import "../../styles/global.css";

const headlineMetrics = [
  ["Questions", "500"],
  ["Answer accuracy", "97.8%"],
  ["Answer faithfulness", "99.8%"],
  ["Retrieval recall@K", "100%"],
  ["Retrieval receipts", "100%"],
  ["Average context", "797 tokens"],
  ["Average local latency", "63.3 ms"],
  ["Context budget", "800 tokens"],
];

const questionTypes = [
  { label: "Knowledge update", count: 78, accuracy: "98.7%", passed: "77 / 78" },
  { label: "Multi-session", count: 133, accuracy: "100%", passed: "132 / 133 faithful" },
  { label: "Single-session assistant", count: 56, accuracy: "96.4%", passed: "54 / 56" },
  { label: "Single-session preference", count: 30, accuracy: "100%", passed: "30 / 30" },
  { label: "Single-session user", count: 70, accuracy: "98.6%", passed: "69 / 70" },
  { label: "Temporal reasoning", count: 133, accuracy: "94.7%", passed: "126 / 133" },
];

const runConfig = [
  ["Benchmark", "LongMemEval-S"],
  ["Protocol", "longmemeval-s-answer-v1"],
  ["Judge", "Normalized answer string match"],
  ["Runtime profile", "Synthesis"],
  ["Retrieval limit", "Top 50"],
  ["Question coverage", "All 500 questions"],
  ["Generated", "9 June 2026"],
  ["Claim scope", "This benchmark configuration"],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title="ExplicitMem LongMemEval-S Benchmark | Monarchic"
      description="Method, results, and limitations for ExplicitMem's 500-question LongMemEval-S benchmark run."
      path="/research/explicitmem"
      type="article"
    />
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="relative min-h-screen overflow-hidden">
      <Shader14 className="pointer-events-none fixed inset-0 h-full w-full opacity-65" />
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_bottom,_rgba(0,0,0,0.7),_rgba(0,0,0,0.96))]"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-5 py-6 sm:px-6 sm:py-10">
        <SiteHeader active="research" />

        <section class="grid gap-10 border-b-2 border-white py-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
          <div>
            <p class="text-xs font-semibold uppercase text-cyan-200">ExplicitMem / LongMemEval-S</p>
            <h1 class="mt-5 max-w-5xl text-4xl font-extrabold uppercase leading-[0.9] sm:text-6xl lg:text-7xl [text-shadow:5px_5px_0_rgba(255,255,255,0.12)]">
              Memory benchmark
            </h1>
            <p class="mt-7 max-w-3xl text-base leading-8 text-white/78 sm:text-lg">
              A reproduced 500-question run measuring answer accuracy,
              faithfulness, retrieval coverage, context size, and local
              evaluation latency under one fixed protocol.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#results" class="inline-flex min-h-12 items-center justify-center border-2 border-cyan-300 bg-cyan-300/10 px-5 text-xs font-bold uppercase text-cyan-100 transition hover:bg-cyan-300/20 hover:text-white">View results</a>
              <a href="/products/mcp-explicitmem" class="inline-flex min-h-12 items-center justify-center border-2 border-white/50 px-5 text-xs font-bold uppercase transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-100">View product</a>
            </div>
          </div>

          <aside class="border-2 border-white bg-black/76 p-5">
            <div class="flex items-center justify-between gap-4">
              <p class="text-xs font-bold uppercase text-white/58">Run summary</p>
              <span class="border border-cyan-300 px-2 py-1 text-[0.65rem] font-bold uppercase text-cyan-200">500 questions</span>
            </div>
            <p class="mt-5 text-6xl font-extrabold leading-none">97.8%</p>
            <p class="mt-3 text-xs font-bold uppercase text-white/58">Answer accuracy</p>
            <p class="mt-6 text-sm leading-7 text-white/72">
              The same run reached 99.8% faithfulness, complete retrieval
              recall, and complete retrieval-receipt coverage under the fixed
              protocol described below.
            </p>
          </aside>
        </section>

        <section id="results" class="scroll-mt-6 py-12">
          <p class="text-xs font-bold uppercase text-cyan-200">01 / Headline results</p>
          <h2 class="mt-3 text-3xl font-extrabold uppercase sm:text-4xl">What the run measured</h2>
          <div class="mt-7 grid border-l border-t border-white/36 sm:grid-cols-2 lg:grid-cols-4">
            {headlineMetrics.map(([label, value]) => (
              <div class="border-r border-b border-white/36 bg-black/68 p-5 transition hover:border-cyan-300 hover:bg-cyan-300/[0.06]">
                <p class="text-[0.65rem] font-bold uppercase text-white/48">{label}</p>
                <p class="mt-3 text-2xl font-extrabold">{value}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="mb-12 border-2 border-white bg-black/76">
          <div class="border-b-2 border-white p-5 sm:p-6">
            <p class="text-xs font-bold uppercase text-cyan-200">02 / Question types</p>
            <h2 class="mt-3 text-2xl font-extrabold uppercase sm:text-3xl">Where the system was strongest and weakest</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[700px] border-collapse text-left text-sm">
              <thead>
                <tr class="border-b-2 border-white text-xs uppercase text-white/60">
                  <th class="p-4">Question type</th>
                  <th class="p-4">Questions</th>
                  <th class="p-4">Answer accuracy</th>
                  <th class="p-4">Scored result</th>
                </tr>
              </thead>
              <tbody>
                {questionTypes.map((row) => (
                  <tr class="border-b border-white/24 transition last:border-b-0 hover:bg-cyan-300/[0.06]">
                    <td class="p-4 font-extrabold uppercase">{row.label}</td>
                    <td class="p-4">{row.count}</td>
                    <td class="p-4 text-xl font-extrabold">{row.accuracy}</td>
                    <td class="p-4 text-white/66">{row.passed}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="mb-12 grid gap-5 lg:grid-cols-3">
          <article class="border-2 border-white bg-black/70 p-5">
            <p class="text-xs font-bold uppercase text-cyan-200">03 / Method</p>
            <h2 class="mt-3 text-2xl font-extrabold uppercase">Fixed answer protocol</h2>
            <p class="mt-4 text-sm leading-7 text-white/74">
              The run used the complete LongMemEval-S question set, retrieved up
              to 50 items, synthesized at most 800 context tokens, and judged
              answers with normalized string matching.
            </p>
          </article>
          <article class="border-2 border-white bg-black/70 p-5">
            <p class="text-xs font-bold uppercase text-cyan-200">04 / Failures</p>
            <h2 class="mt-3 text-2xl font-extrabold uppercase">Temporal reasoning led the misses</h2>
            <p class="mt-4 text-sm leading-7 text-white/74">
              Twelve cases reported context truncation. Seven wrong answers were
              localized to evidence but synthesized incorrectly, and five cases
              lacked localized answer evidence.
            </p>
          </article>
          <article class="border-2 border-white bg-black/70 p-5">
            <p class="text-xs font-bold uppercase text-cyan-200">05 / Boundary</p>
            <h2 class="mt-3 text-2xl font-extrabold uppercase">No cross-system comparison</h2>
            <p class="mt-4 text-sm leading-7 text-white/74">
              Mem0 and Supermemory are excluded because no comparable run used
              this exact dataset, question order, scoring method, context
              budget, and latency boundary.
            </p>
          </article>
        </section>

        <section class="mb-12 grid gap-0 border-2 border-white bg-black/76 lg:grid-cols-[0.72fr_1.28fr]">
          <div class="border-b-2 border-white p-5 lg:border-r-2 lg:border-b-0 sm:p-6">
            <p class="text-xs font-bold uppercase text-cyan-200">Run configuration</p>
            <h2 class="mt-3 text-3xl font-extrabold uppercase">Reproduction boundary</h2>
          </div>
          <dl class="grid sm:grid-cols-2">
            {runConfig.map(([label, value]) => (
              <div class="border-b border-white/30 p-4 odd:sm:border-r">
                <dt class="text-[0.65rem] font-bold uppercase text-white/48">{label}</dt>
                <dd class="mt-2 text-sm font-semibold text-white/82">{value}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="mb-12 grid gap-6 border-2 border-cyan-300/70 bg-black/78 p-6 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <p class="text-xs font-bold uppercase text-cyan-200">Source and interpretation</p>
            <h2 class="mt-3 text-2xl font-extrabold uppercase">Read the result as benchmark-scoped evidence</h2>
            <p class="mt-4 max-w-3xl text-sm leading-7 text-white/72">
              LongMemEval defines the dataset. Monarchic reproduced ExplicitMem
              under the configuration above. The result does not establish
              performance on other datasets, hosted latency, or direct
              superiority over another memory product.
            </p>
            <a class="mt-4 inline-flex text-sm font-bold text-cyan-200 underline underline-offset-4 transition hover:text-white" href="https://github.com/xiaowu0162/longmemeval">
              LongMemEval project and paper
            </a>
          </div>
          <a href="/products/mcp-explicitmem" class="inline-flex min-h-12 items-center justify-center border-2 border-cyan-300 bg-cyan-300/10 px-5 text-xs font-bold uppercase text-cyan-100 transition hover:bg-cyan-300/20 hover:text-white">
            View ExplicitMem
          </a>
        </section>

        <SiteFooter />
      </div>
    </main>
  </body>
</html>
