---
import SeoHead from "../../components/SeoHead.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import {
  explicitMemBenchmark,
  explicitMemQuestionTypes,
  explicitMemReproduction,
  explicitMemRunConfig,
  explicitMemStudies,
} from "../../lib/explicitmemBenchmark";
import { getMcpResearchByProductSlug } from "../../lib/mcpResearch";
import "../../styles/global.css";

const researchEntry = getMcpResearchByProductSlug("mcp-explicitmem");
if (!researchEntry) throw new Error("ExplicitMem research entry is missing");

const headlineMetrics = [
  ["Questions", String(explicitMemBenchmark.questions)],
  ["Answer accuracy", explicitMemBenchmark.answerAccuracy],
  ["Answer faithfulness", explicitMemBenchmark.answerFaithfulness],
  ["Answer evidence hit rate", explicitMemBenchmark.answerEvidenceHitRate],
  ["Retrieval recall@K", explicitMemBenchmark.retrievalRecallAtK],
  ["Retrieval receipts", explicitMemBenchmark.retrievalReceiptCoverage],
  ["Average context", explicitMemBenchmark.averageContext],
  ["Average local latency", explicitMemBenchmark.averageLatency],
  ["Context budget", explicitMemBenchmark.contextBudget],
] as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title="ExplicitMem Evaluation Report | Monarchic"
      description="Methods, results, failures, artifacts, and limitations for ExplicitMem evaluations across LongMemEval-S, LoCoMo, cross-dataset retrieval, and generic-answer support."
      path="/research/explicitmem"
      type="article"
    />
  </head>
  <body class="min-h-screen bg-black text-white">
    <main
      data-research-brief={researchEntry.productSlug}
      data-research-status={researchEntry.hostedStatus}
      class="min-h-screen"
    >
      <div class="mx-auto max-w-7xl px-5 py-6 sm:px-6 sm:py-10">
        <SiteHeader active="research" />

        <section class="grid gap-10 border-b-2 border-white py-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
          <div>
            <p class="text-xs font-semibold uppercase text-signal">ExplicitMem / Published evaluations</p>
            <h1 class="mt-5 max-w-5xl text-4xl font-extrabold uppercase leading-[0.9] sm:text-6xl lg:text-7xl">
              Memory evaluation report
            </h1>
            <p class="mt-7 max-w-3xl text-base leading-8 text-white/78 sm:text-lg">
              Four separately scoped evaluations cover answer synthesis, LoCoMo retrieval,
              cross-dataset candidate generation, and generic-answer support. Every result
              keeps its method, failure evidence, artifact, and interpretation limit beside it.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#studies" class="inline-flex min-h-12 items-center justify-center border-2 border-signal bg-signal px-5 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">View studies</a>
              <a href="/products/mcp-explicitmem" class="inline-flex min-h-12 items-center justify-center border-2 border-white/50 px-5 text-xs font-bold uppercase transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">View product</a>
            </div>
          </div>

          <aside class="border-2 border-white bg-black/76 p-5">
            <div class="flex items-center justify-between gap-4">
              <p class="text-xs font-bold uppercase text-white/58">Published study views</p>
              <span class="border border-signal px-2 py-1 text-[0.65rem] font-bold uppercase text-signal">{explicitMemStudies.length} scopes</span>
            </div>
            <p class="mt-5 text-6xl font-extrabold leading-none">{explicitMemBenchmark.answerAccuracy}</p>
            <p class="mt-3 text-xs font-bold uppercase text-white/58">LongMemEval-S answer accuracy</p>
            <p class="mt-6 text-sm leading-7 text-white/72">
              This is one result inside the report. LoCoMo and cross-dataset sections use retrieval metrics, while the generic-answer section uses deterministic answer support. Those values are not interchangeable.
            </p>
          </aside>
        </section>

        <section id="studies" class="scroll-mt-6 border-b-2 border-white py-12">
          <div class="flex flex-wrap items-end justify-between gap-5">
            <h2 class="text-3xl font-extrabold uppercase sm:text-4xl">Study register</h2>
            <p class="max-w-xl text-sm leading-7 text-white/58">Metric labels are intentionally different because each evaluation asks a different question.</p>
          </div>
          <div class="mt-7 border border-white/45">
            {explicitMemStudies.map((study, index) => (
              <article id={study.id} class:list={["grid lg:grid-cols-[0.62fr_1.38fr]", index < explicitMemStudies.length - 1 && "border-b border-white/35"]}>
                <div class="border-b border-white/30 p-5 lg:border-b-0 lg:border-r sm:p-6">
                  <p class="font-mono text-[0.62rem] font-bold uppercase text-signal">0{index + 1} / {study.scope}</p>
                  <h3 class="mt-3 text-xl font-extrabold uppercase">{study.dataset}</h3>
                  <p class="mt-5 text-4xl font-extrabold leading-none">{study.metricValue}</p>
                  <p class="mt-2 text-xs font-bold uppercase text-white/52">{study.metricLabel}</p>
                  <p class="mt-4 text-xs leading-5 text-white/48">{study.sample} / generated {study.generated}</p>
                </div>
                <div class="grid sm:grid-cols-2">
                  <div class="border-b border-white/25 p-5 sm:border-r sm:p-6">
                    <p class="text-[0.62rem] font-bold uppercase text-white/46">Method</p>
                    <p class="mt-3 text-sm leading-7 text-white/70">{study.method}</p>
                  </div>
                  <div class="border-b border-white/25 p-5 sm:p-6">
                    <p class="text-[0.62rem] font-bold uppercase text-white/46">Failure evidence</p>
                    <p class="mt-3 text-sm leading-7 text-white/70">{study.failure}</p>
                  </div>
                  <div class="p-5 sm:border-r sm:p-6">
                    <p class="text-[0.62rem] font-bold uppercase text-white/46">Interpretation limit</p>
                    <p class="mt-3 text-sm leading-7 text-white/70">{study.limitation}</p>
                  </div>
                  <div class="p-5 sm:p-6">
                    <p class="text-[0.62rem] font-bold uppercase text-white/46">Artifact</p>
                    <a href={study.evidenceUrl} class="mt-3 inline-flex text-sm font-bold text-signal underline underline-offset-4 transition hover:text-white">Inspect source artifact</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="results" class="scroll-mt-6 py-12">
          <p class="text-xs font-bold uppercase text-signal">LongMemEval-S detail</p>
          <h2 class="mt-3 text-3xl font-extrabold uppercase sm:text-4xl">What the synthesis run measured</h2>
          <div class="mt-7 grid border-l border-t border-white/36 sm:grid-cols-2 lg:grid-cols-4">
            {headlineMetrics.map(([label, value]) => (
              <div class="border-r border-b border-white/36 bg-black/68 p-5">
                <p class="text-[0.65rem] font-bold uppercase text-white/48">{label}</p>
                <p class="mt-3 text-2xl font-extrabold">{value}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="mb-12 border-2 border-white bg-black/76">
          <div class="border-b-2 border-white p-5 sm:p-6">
            <h2 class="text-2xl font-extrabold uppercase sm:text-3xl">Where the system was strongest and weakest</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[700px] border-collapse text-left text-sm">
              <thead>
                <tr class="border-b-2 border-white text-xs uppercase text-white/60">
                  <th class="p-4">Question type</th>
                  <th class="p-4">Questions</th>
                  <th class="p-4">Answer accuracy</th>
                  <th class="p-4">Scored result</th>
                </tr>
              </thead>
              <tbody>
                {explicitMemQuestionTypes.map((row) => (
                  <tr class="border-b border-white/24 last:border-b-0">
                    <td class="p-4 font-extrabold uppercase">{row.label}</td>
                    <td class="p-4">{row.count}</td>
                    <td class="p-4 text-xl font-extrabold">{row.accuracy}</td>
                    <td class="p-4 text-white/66">{row.passed}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="mb-12 grid gap-5 lg:grid-cols-3">
          <article class="border-2 border-white bg-black/70 p-5">
            <h2 class="text-2xl font-extrabold uppercase">Fixed answer protocol</h2>
            <p class="mt-4 text-sm leading-7 text-white/74">
              The run used the complete {explicitMemBenchmark.benchmark} question set, the promoted
              synthesis profile, no per-session character limit, up to 50
              retrieved items, an 800-token context budget, and deterministic
              normalized answer matching.
            </p>
          </article>
          <article class="border-2 border-white bg-black/70 p-5">
            <h2 class="text-2xl font-extrabold uppercase">One upstream-gold mismatch remains</h2>
            <p class="mt-4 text-sm leading-7 text-white/74">
              The only scored miss is faithful and evidence-localized: the
              source dates compute to 12 weeks, while the upstream gold answer
              expects 15. The repository's strict 100% threshold remains unmet.
            </p>
          </article>
          <article class="border-2 border-white bg-black/70 p-5">
            <h2 class="text-2xl font-extrabold uppercase">No cross-system comparison</h2>
            <p class="mt-4 text-sm leading-7 text-white/74">
              Mem0 and Supermemory are excluded because no comparable run used
              this exact dataset, question order, scoring method, context
              budget, and latency boundary.
            </p>
          </article>
        </section>

        <section class="mb-12 grid gap-0 border-2 border-white bg-black/76 lg:grid-cols-[0.72fr_1.28fr]">
          <div class="border-b-2 border-white p-5 lg:border-r-2 lg:border-b-0 sm:p-6">
            <p class="text-xs font-bold uppercase text-signal">Run configuration</p>
            <h2 class="mt-3 text-3xl font-extrabold uppercase">Reproduction boundary</h2>
          </div>
          <dl class="grid sm:grid-cols-2">
            {explicitMemRunConfig.map(([label, value]) => (
              <div class="border-b border-white/30 p-4 odd:sm:border-r">
                <dt class="text-[0.65rem] font-bold uppercase text-white/48">{label}</dt>
                <dd class="mt-2 text-sm font-semibold text-white/82">{value}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="mb-12 grid border-2 border-white bg-black/76 lg:grid-cols-[0.72fr_1.28fr]">
          <div class="border-b-2 border-white p-5 lg:border-r-2 lg:border-b-0 sm:p-6">
            <p class="text-xs font-bold uppercase text-signal">Repository reproduction</p>
            <h2 class="mt-3 text-3xl font-extrabold uppercase">Validate committed evidence</h2>
            <p class="mt-4 text-sm leading-7 text-white/62">Run from the ExplicitMem-MCP repository at the artifact version being reviewed. Dataset files and optional CUDA dependencies must be available for a full rerun.</p>
          </div>
          <div class="min-w-0 p-5 sm:p-6">
            <pre class="max-w-full overflow-x-auto border border-white/30 bg-black p-4 font-mono text-xs leading-7 text-white/74"><code>{explicitMemReproduction.join("\n")}</code></pre>
            <p class="mt-4 text-xs leading-6 text-white/48">The validation command checks committed claim paths. Commands that regenerate evidence may require local datasets, model weights, and the runtime described by the source artifact.</p>
          </div>
        </section>

        <section class="mb-12 grid gap-6 border-2 border-signal/70 bg-black/78 p-6 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <p class="text-xs font-bold uppercase text-signal">Source and interpretation</p>
            <h2 class="mt-3 text-2xl font-extrabold uppercase">Read the result as benchmark-scoped evidence</h2>
            <p class="mt-4 max-w-3xl text-sm leading-7 text-white/72">
              The source repository tracks supported results by artifact path and metric field. LongMemEval-S, LoCoMo, cross-dataset retrieval, and generic-answer support remain separate claims. None establishes hosted latency or direct superiority over another memory product.
            </p>
            <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
              <a class="inline-flex text-sm font-bold text-signal underline underline-offset-4 transition hover:text-white" href={explicitMemBenchmark.evidenceUrl}>
                ExplicitMem evidence receipt
              </a>
              <a class="inline-flex text-sm font-bold text-signal underline underline-offset-4 transition hover:text-white" href="https://github.com/xiaowu0162/longmemeval">
                LongMemEval project and paper
              </a>
            </div>
          </div>
          <a href="/products/mcp-explicitmem" class="inline-flex min-h-12 items-center justify-center border-2 border-signal bg-signal px-5 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">
            View ExplicitMem
          </a>
        </section>

        <SiteFooter />
      </div>
    </main>
  </body>
</html>
