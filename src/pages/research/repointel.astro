---
import Shader14 from "../../components/Shader14.astro";
import "../../styles/global.css";

const scoreRows = [
  ["Overall score", "0.6677"],
  ["Tasks", "87"],
  ["Zero-score tasks", "0"],
  ["Patch generation", "1.0000"],
  ["Review", "0.9650"],
  ["Localization", "0.6104"],
  ["Explanation", "0.5909"],
  ["Patch plan", "0.5850"],
];

const taskTypeRows = [
  {
    type: "Patch generation",
    tasks: "10",
    score: "1.0000",
    note: "Fixture diffs apply cleanly and pass public and hidden tests.",
  },
  {
    type: "Review",
    tasks: "5",
    score: "0.9650",
    note: "Seeded defect findings are detected with file and citation coverage.",
  },
  {
    type: "Localization",
    tasks: "40",
    score: "0.6104",
    note: "RepoIntel search, symbol, and bounded lexical evidence recover all nonzero locations.",
  },
  {
    type: "Explanation",
    tasks: "22",
    score: "0.5909",
    note: "File and citation recall are scored; answer judge scores are not yet synthesized.",
  },
  {
    type: "Patch plan",
    tasks: "10",
    score: "0.5850",
    note: "Plans are evidence-backed but do not yet include a judged natural-language synthesis layer.",
  },
];

const repoRows = [
  ["fixture-small-api", "51", "0.7480"],
  ["monarchic", "12", "0.6097"],
  ["pathweave", "12", "0.5757"],
  ["omnis-genomics", "12", "0.4764"],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="RepoIntel benchmark research across repository localization, explanation, patch planning, patch generation, and review tasks."
    />
    <title>RepoIntel Research | Monarchic AI</title>
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="relative min-h-screen overflow-hidden">
      <Shader14
        className="pointer-events-none fixed inset-0 h-full w-full opacity-70"
      />
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_bottom,_rgba(0,0,0,0.68),_rgba(0,0,0,0.94))]"></div>

      <section class="relative z-10 mx-auto max-w-7xl px-6 py-8 sm:py-12">
        <header class="flex flex-wrap items-center justify-between gap-5 border-b-2 border-white pb-6">
          <a href="/" class="inline-flex items-center gap-3">
            <img
              src="/favicon.svg"
              alt="Monarchic AI logo"
              class="h-9 w-9 bg-white object-cover p-1"
              width="36"
              height="36"
            />
            <span class="text-[0.7rem] font-semibold uppercase tracking-[0.36em] text-white/72">
              Monarchic AI
            </span>
          </a>
          <div class="border-2 border-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.28em]">
            Research
          </div>
        </header>

        <div class="grid gap-10 py-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
          <div>
            <p class="mb-5 text-xs font-semibold uppercase tracking-[0.4em] text-white/64">
              RepoIntel MCP
            </p>
            <h1 class="max-w-5xl text-4xl font-extrabold uppercase leading-[0.9] sm:text-6xl lg:text-7xl [text-shadow:5px_5px_0_rgba(255,255,255,0.12)]">
              Repository<br />Intelligence Bench
            </h1>
            <p class="mt-7 max-w-3xl text-base leading-8 text-white/78 sm:text-lg">
              RepoIntel is a repository intelligence MCP runtime for indexing code,
              symbols, evidence records, generated wiki pages, and change-aware
              retrieval. This page reports the current RepoIntel-Bench run across
              localization, explanation, patch planning, patch generation, and review.
            </p>
          </div>

          <div class="grid gap-3 border-2 border-white bg-black/70 p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.34em] text-white/64">
              Current RepoIntel Run
            </p>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-2">
              {scoreRows.map(([label, value]) => (
                <div class="border border-white/30 p-4">
                  <p class="text-[0.66rem] uppercase tracking-[0.26em] text-white/52">{label}</p>
                  <p class="mt-2 text-lg font-bold">{value}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <section class="border-2 border-white bg-black/76">
          <div class="border-b-2 border-white p-5 sm:p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.34em] text-white/64">
              RepoIntel-Bench
            </p>
            <h2 class="mt-3 text-2xl font-extrabold uppercase sm:text-3xl">
              Score by Task Type
            </h2>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full min-w-[880px] border-collapse text-left text-sm">
              <thead>
                <tr class="border-b-2 border-white text-xs uppercase tracking-[0.2em] text-white/60">
                  <th class="p-4">Task Type</th>
                  <th class="p-4">Tasks</th>
                  <th class="p-4">Mean Score</th>
                  <th class="p-4">Interpretation</th>
                </tr>
              </thead>
              <tbody>
                {taskTypeRows.map((row) => (
                  <tr class="border-b border-white/24 align-top last:border-b-0">
                    <td class="p-4 text-lg font-extrabold uppercase">{row.type}</td>
                    <td class="p-4 font-semibold">{row.tasks}</td>
                    <td class="p-4 text-2xl font-extrabold">{row.score}</td>
                    <td class="p-4 max-w-xl text-xs leading-5 text-white/62">{row.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="grid gap-5 py-8 lg:grid-cols-[0.9fr_1.1fr]">
          <div class="border-2 border-white bg-black/70 p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-white/60">
              Score by Repository
            </p>
            <div class="mt-5 grid gap-3">
              {repoRows.map(([repo, tasks, score]) => (
                <div class="grid grid-cols-[1fr_auto] gap-4 border border-white/30 p-4">
                  <div>
                    <p class="text-sm font-extrabold uppercase">{repo}</p>
                    <p class="mt-1 text-[0.66rem] uppercase tracking-[0.24em] text-white/52">{tasks} tasks</p>
                  </div>
                  <p class="text-xl font-extrabold">{score}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="grid gap-5">
            <div class="border-2 border-white bg-black/70 p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.3em] text-white/60">
                What This Measures
              </p>
              <p class="mt-4 text-sm leading-7 text-white/76">
                The benchmark combines generated fixture tasks with real repository
                tasks from Monarchic, PathWeave, and Omnis Genomics. It scores
                file recall, symbol recall, citation quality, patch application,
                hidden tests, minimality, seeded review findings, and task-type
                specific metrics.
              </p>
            </div>
            <div class="border-2 border-white bg-black/70 p-5">
              <p class="text-xs font-semibold uppercase tracking-[0.3em] text-white/60">
                Current Ceiling
              </p>
              <p class="mt-4 text-sm leading-7 text-white/76">
                Patch generation and seeded review are now strong. The remaining
                ceiling is answer synthesis: explanation and localization judge
                metrics are still zero because this adapter reports evidence rather
                than generating judged natural-language answers.
              </p>
            </div>
          </div>
        </section>

        <section class="mb-10 border-2 border-white bg-black/70 p-5 sm:p-6">
          <h2 class="text-xl font-extrabold uppercase">Sources and Scope</h2>
          <ul class="mt-4 grid gap-3 text-sm leading-7 text-white/74">
            <li>
              RepoIntel artifact:
              local RepoIntel-Bench full run with 87 tasks and evaluated patch outputs.
            </li>
            <li>
              Latest verified score:
              <span class="font-mono">0.6677</span>
              from commit-scoped benchmark work on RepoIntel-Bench.
            </li>
            <li>
              Runtime note:
              benchmark state is stored on the large data disk; the adapter has
              non-fatal fallback behavior for RepoIntel index/query failures.
            </li>
          </ul>
          <p class="mt-5 max-w-5xl text-xs leading-6 text-white/52">
            RepoIntel results are benchmark-scoped. The current score should be read
            as a RepoIntel-Bench adapter result, not a general claim about all
            repository-intelligence workloads. A clean fully indexed run can update
            this page when the benchmark environment is pinned for publication.
          </p>
        </section>
      </section>
    </main>
  </body>
</html>
