---
import Shader14 from "../components/Shader14.astro";
import SeoHead from "../components/SeoHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WaitlistForm from "../components/WaitlistForm.svelte";
import { allPlans } from "../lib/pricing";
import "../styles/global.css";

const apiBaseUrl = import.meta.env.PUBLIC_MONARCHIC_API_BASE_URL ?? "https://api.monarchic.io";
const appBaseUrl = (import.meta.env.PUBLIC_MONARCHIC_WEBAPP_BASE_URL ?? "https://app.monarchic.io").replace(/\/$/, "");
const wipProducts = allPlans
  .filter((plan) => plan.kind === "single-mcp" && plan.status === "coming_soon")
  .map((plan) => ({ slug: plan.slug, label: plan.displayName }));

const featuredRoutes = [
  {
    slug: "mcp-explicitmem",
    label: "ExplicitMem",
    href: "/products/mcp-explicitmem",
    proof: "97.8% accuracy on the 500-question LongMemEval-S run",
    role: "Durable memory",
  },
  {
    slug: "mcp-repointel",
    label: "RepoIntel",
    href: "/products/mcp-repointel",
    proof: "Repository maps and cited evidence",
    role: "Codebase context",
  },
  {
    slug: "mcp-incidentops",
    label: "IncidentOps",
    href: "/products/mcp-incidentops",
    proof: "Timelines, triage, response packets, and guarded updates",
    role: "Incident response",
  },
  {
    slug: "mcp-infraprofiler",
    label: "InfraProfiler",
    href: "/products/mcp-infraprofiler",
    proof: "Cost, reliability, latency, and pipeline hotspot analysis",
    role: "Infrastructure intelligence",
  },
];

const proofPoints = [
  ["Accuracy", "97.8%", "LongMemEval-S answer accuracy"],
  ["Faithfulness", "99.8%", "LongMemEval-S answer faithfulness"],
  ["Recall@K", "100%", "ExplicitMem retrieval coverage"],
  ["Local latency", "63.3 ms", "Average benchmark evaluation time"],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title="Monarchic | Hosted MCPs for agent workflows"
      description="Hosted MCPs for repository intelligence, memory, delivery, infrastructure, incident response, and agent workflows."
      path="/"
    />
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="relative min-h-screen overflow-hidden">
      <Shader14 className="pointer-events-none fixed inset-0 h-full w-full opacity-70" />
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_bottom,_rgba(0,0,0,0.62),_rgba(0,0,0,0.86)_55%,_rgba(0,0,0,0.98))]"></div>
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(90deg,_rgba(0,0,0,0.9),_rgba(0,0,0,0.38)_48%,_rgba(0,0,0,0.82))]"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-12">
        <SiteHeader />

        <section id="introduction" class="grid min-h-[calc(100vh-112px)] gap-8 py-10 lg:min-h-[640px] lg:grid-cols-[1fr_0.82fr] lg:items-center">
          <div>
            <p class="mb-5 inline-flex border border-white/46 bg-black/48 px-3 py-2 text-xs font-bold uppercase text-white/68">
              Hosted MCP catalog
            </p>
            <h1 class="max-w-5xl text-5xl font-extrabold uppercase leading-[0.88] text-white sm:text-7xl lg:text-8xl [text-shadow:8px_8px_0_rgba(255,255,255,0.11)]">
              Better tools for production agents.
            </h1>
            <p class="mt-7 max-w-2xl text-base leading-8 text-white/76 sm:text-lg">
              One catalog for repository context, durable memory, delivery,
              infrastructure, incident response, and more.
            </p>
            <div class="mt-8 flex flex-wrap gap-3 text-xs font-bold uppercase">
              <a href="/products" class="inline-flex items-center justify-center border-2 border-cyan-300 bg-cyan-300/10 px-5 py-3 text-cyan-100 transition hover:bg-cyan-300/20 hover:text-white">
                View products
              </a>
              <a href="/research" class="inline-flex items-center justify-center border-2 border-white/50 px-5 py-3 text-white transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-100">
                Research
              </a>
              <a href={`${appBaseUrl}/docs`} class="inline-flex items-center justify-center border-2 border-cyan-300 px-5 py-3 text-cyan-200 transition hover:bg-cyan-300/10 hover:text-cyan-100">
                Read the docs
              </a>
              <a href="#waitlist" class="inline-flex items-center justify-center border-2 border-white/50 px-5 py-3 text-white transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-100">
                Join waitlist
              </a>
            </div>
          </div>

          <aside class="border-2 border-white bg-black/72 shadow-[12px_12px_0_rgba(255,255,255,0.1)]">
            <div class="border-b-2 border-white px-5 py-4">
              <p class="text-xs font-bold uppercase text-white/58">Hosted catalog</p>
              <h2 class="mt-2 text-3xl font-extrabold uppercase leading-none">Available MCPs, one shared allowance</h2>
            </div>
            <div class="divide-y divide-white/24">
              {featuredRoutes.map((route) => (
                <a href={route.href} class="group grid gap-3 px-5 py-5 transition hover:bg-cyan-300/10 hover:text-white sm:grid-cols-[1fr_auto]">
                  <div>
                    <p class="text-sm font-extrabold uppercase">{route.label}</p>
                    <p class="mt-1 text-xs font-bold uppercase text-white/48 group-hover:text-cyan-100/70">{route.role}</p>
                    <p class="mt-3 text-sm leading-6 text-white/70 group-hover:text-white/80">{route.proof}</p>
                  </div>
                  <p class="self-start border border-white/50 px-3 py-2 text-xs font-extrabold uppercase transition group-hover:border-cyan-300 group-hover:text-cyan-100">
                    Available
                  </p>
                </a>
              ))}
            </div>
          </aside>
        </section>

        <section id="proof" class="border-t-2 border-white py-10">
          <div class="grid gap-5 lg:grid-cols-[0.8fr_1.2fr]">
            <div>
              <p class="text-xs font-bold uppercase text-cyan-200">ExplicitMem benchmark</p>
              <h2 class="mt-3 max-w-3xl text-3xl font-extrabold uppercase leading-tight sm:text-4xl">
                500 LongMemEval-S questions under one fixed protocol.
              </h2>
              <p class="mt-4 max-w-2xl text-sm leading-7 text-white/70">
                These results cover one local benchmark configuration. The
                report includes the method, question-type breakdown, failed
                cases, and limits beside the headline metrics.
              </p>
              <a href="/research/explicitmem" class="mt-5 inline-flex border border-white/50 px-4 py-3 text-xs font-bold uppercase transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-100">
                Read methodology
              </a>
            </div>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
              {proofPoints.map(([label, value, scope]) => (
                <div class="border border-white/46 bg-black/64 p-5 transition hover:border-cyan-300 hover:bg-cyan-300/[0.06]">
                  <p class="text-[0.68rem] font-bold uppercase text-white/46">{label}</p>
                  <p class="mt-3 text-3xl font-extrabold leading-none text-white">{value}</p>
                  <p class="mt-3 text-xs font-semibold uppercase leading-5 text-white/56">{scope}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section id="pricing_model" class="border-t-2 border-white py-10">
          <div class="grid gap-5 lg:grid-cols-[1.05fr_0.95fr]">
            <div class="border-2 border-cyan-300/60 bg-zinc-950 p-6 text-white">
              <p class="text-xs font-bold uppercase text-cyan-200">Pricing model</p>
              <h2 class="mt-3 max-w-3xl text-3xl font-extrabold uppercase leading-tight sm:text-4xl">
                One plan covers every available MCP.
              </h2>
              <p class="mt-4 max-w-2xl text-sm leading-7 text-white/72">
                Choose a monthly credit allowance for your workload. Standard
                operations use fewer credits. PTY sessions start at one credit
                with terminal controls included; browser and provider-backed
                work follows measured cost.
              </p>
              <a href="/products" class="mt-6 inline-flex border-2 border-cyan-300 bg-cyan-300/10 px-5 py-3 text-xs font-bold uppercase text-cyan-100 transition hover:bg-cyan-300/20 hover:text-white">
                Compare plans
              </a>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              <a href="/products#mcp-catalog" class="group border border-white/46 bg-black/64 p-5 transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-white">
                <p class="text-sm font-extrabold uppercase">Choose an MCP</p>
                <p class="mt-2 text-sm leading-6 text-white/68 group-hover:text-white/80">Inspect all 15 available and WIP products before selecting a plan.</p>
              </a>
              <a href="/products#plans" class="group border border-white/46 bg-black/64 p-5 transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-white">
                <p class="text-sm font-extrabold uppercase">Choose capacity</p>
                <p class="mt-2 text-sm leading-6 text-white/68 group-hover:text-white/80">Compare Evaluation, Individual, Developer, Team, and Business allowances in one place.</p>
              </a>
            </div>
          </div>
        </section>

        <section id="waitlist" class="border-t-2 border-white py-10">
          <div class="grid gap-5 lg:grid-cols-[0.9fr_1.1fr]">
            <div>
              <p class="text-xs font-bold uppercase text-white/54">Next step</p>
              <h2 class="mt-3 max-w-3xl text-3xl font-extrabold uppercase leading-tight sm:text-4xl">
                Tell us which WIP product matters to your team.
              </h2>
              <p class="mt-4 max-w-2xl text-sm leading-7 text-white/70">
                Available MCPs work with the shared plan allowance. Products
                marked WIP are not available for checkout; choose one below to
                get an access update.
              </p>
            </div>
            <div class="border-2 border-white bg-black p-6 shadow-[10px_10px_0_rgba(255,255,255,0.12)]">
              <WaitlistForm
                client:load
                apiBaseUrl={apiBaseUrl}
                slug={wipProducts[0]?.slug ?? "monarchic-ai"}
                products={wipProducts}
                submitLabel="Join waitlist"
              />
            </div>
          </div>
        </section>

        <SiteFooter />
      </div>
    </main>
  </body>
</html>
