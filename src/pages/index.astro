---
import Shader14 from "../components/Shader14.astro";
import SeoHead from "../components/SeoHead.astro";
import "../styles/global.css";

const webappBaseUrl = (import.meta.env.PUBLIC_MONARCHIC_WEBAPP_BASE_URL ?? "https://app.monarchic.io").replace(/\/$/, "");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      title="Monarchic AI | Hosted MCPs for production agents"
      description="Monarchic AI builds hosted MCP infrastructure, repository intelligence, durable memory, and browser verification for production agent systems."
      path="/"
    />
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="relative min-h-screen overflow-hidden">
      <Shader14
        className="pointer-events-none fixed inset-0 h-full w-full opacity-75"
      />
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_bottom,_rgba(0,0,0,0.62),_rgba(0,0,0,0.94))]"></div>

      <section class="relative z-10 mx-auto max-w-7xl px-6 py-8 sm:py-12">
        <header class="flex flex-wrap items-center justify-between gap-5 border-b-2 border-white pb-6">
          <a href="/" class="inline-flex items-center gap-3">
            <img
              src="/favicon.svg"
              alt="Monarchic AI logo"
              class="h-9 w-9 bg-white object-cover p-1"
              width="36"
              height="36"
            />
            <span class="text-[0.7rem] font-semibold uppercase tracking-[0.36em] text-white/72">
              Monarchic AI
            </span>
          </a>
          <nav class="flex flex-wrap items-center gap-2">
            <a href="/products" class="border-2 border-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] transition hover:bg-white hover:text-black">Products</a>
            <a href="/research" class="border-2 border-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] transition hover:bg-white hover:text-black">Research</a>
            <a href={webappBaseUrl} class="border-2 border-white bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-black transition hover:bg-black hover:text-white">App</a>
          </nav>
        </header>

        <section class="grid min-h-[calc(100vh-112px)] gap-10 py-12 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
          <div>
            <p class="mb-5 text-xs font-semibold uppercase tracking-[0.4em] text-white/64">
              Model Context infrastructure
            </p>
            <h1 class="max-w-5xl text-5xl font-extrabold uppercase leading-[0.9] sm:text-7xl lg:text-8xl [text-shadow:6px_6px_0_rgba(255,255,255,0.12)]">
              Hosted MCPs<br />Built To Run
            </h1>
            <p class="mt-7 max-w-3xl text-base leading-8 text-white/78 sm:text-lg">
              Monarchic gives engineering teams hosted MCP routes,
              account-scoped API access, repository intelligence, durable
              memory, and browser verification for agents already operating
              near production code, browsers, and customer workflows. Teams can
              buy access in the app and start from account-owned MCP routes
              instead of waiting on manual onboarding.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href="/products"
                class="inline-flex items-center justify-center border-2 border-white bg-white px-5 py-3 text-xs font-bold uppercase tracking-[0.28em] text-black transition hover:bg-black hover:text-white"
              >
                Products
              </a>
              <a
                href="/research"
                class="inline-flex items-center justify-center border-2 border-white px-5 py-3 text-xs font-bold uppercase tracking-[0.28em] transition hover:bg-white hover:text-black"
              >
                Research
              </a>
              <a
                href={`${webappBaseUrl}/products`}
                class="inline-flex items-center justify-center border-2 border-cyan-300 px-5 py-3 text-xs font-bold uppercase tracking-[0.28em] text-cyan-200 transition hover:bg-cyan-200 hover:text-black"
              >
                Buy In App
              </a>
            </div>
          </div>

          <div class="grid gap-4">
            <div class="border-2 border-white bg-black/72 p-5">
              <p class="text-xs font-bold uppercase tracking-[0.32em] text-cyan-200">Hosted MCPs</p>
              <p class="mt-3 text-sm leading-7 text-white/74">
                BrowserOps, ExplicitMem, RepoIntel, and curated bundles ship as
                account-scoped endpoints with entitlement checks, API-key
                setup, usage boundaries, and rollout controls instead of loose
                process snippets.
              </p>
            </div>
            <div class="border-2 border-white bg-black/72 p-5">
              <p class="text-xs font-bold uppercase tracking-[0.32em] text-amber-200">Measured Systems</p>
              <p class="mt-3 text-sm leading-7 text-white/74">
                Research pages keep benchmark scope, receipts, reliability
                gates, and non-claims visible before a tool is used as launch
                infrastructure.
              </p>
            </div>
            <div class="border-2 border-white bg-black/72 p-5">
              <p class="text-xs font-bold uppercase tracking-[0.32em] text-emerald-200">App Surface</p>
              <p class="mt-3 text-sm leading-7 text-white/74">
                The app owns signup, account state, API keys, hosted MCP setup,
                subscription handoff, and operator-visible account state so
                public discovery stays separate from production control.
              </p>
            </div>
          </div>
        </section>

        <section class="grid gap-5 border-t-2 border-white py-10 md:grid-cols-3">
          <a href="/products/mcp-repointel" class="group border border-white/58 bg-black/64 p-5 transition hover:bg-white hover:text-black">
            <p class="text-xs font-bold uppercase tracking-[0.28em] text-white/52 group-hover:text-black/52">RepoIntel</p>
            <h2 class="mt-3 text-xl font-extrabold uppercase">Repository intelligence for agents</h2>
            <p class="mt-3 text-sm leading-6 text-white/70 group-hover:text-black/70">
              Generated wiki context, dependency summaries, and targeted code evidence.
            </p>
          </a>
          <a href="/products/mcp-explicitmem" class="group border border-white/58 bg-black/64 p-5 transition hover:bg-white hover:text-black">
            <p class="text-xs font-bold uppercase tracking-[0.28em] text-white/52 group-hover:text-black/52">ExplicitMem</p>
            <h2 class="mt-3 text-xl font-extrabold uppercase">Durable memory with receipts</h2>
            <p class="mt-3 text-sm leading-6 text-white/70 group-hover:text-black/70">
              Typed memory, graph links, bounded recall, and audit-friendly retrieval.
            </p>
          </a>
          <a href="/products/mcp-browserops" class="group border border-white/58 bg-black/64 p-5 transition hover:bg-white hover:text-black">
            <p class="text-xs font-bold uppercase tracking-[0.28em] text-white/52 group-hover:text-black/52">BrowserOps</p>
            <h2 class="mt-3 text-xl font-extrabold uppercase">Browser verification evidence</h2>
            <p class="mt-3 text-sm leading-6 text-white/70 group-hover:text-black/70">
              Screenshots, console diagnostics, network checks, and scenario receipts.
            </p>
          </a>
        </section>

        <section class="grid gap-6 border-t-2 border-white py-10 lg:grid-cols-[0.8fr_1.2fr]">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-white/54">Launch Fit</p>
            <h2 class="mt-3 text-3xl font-extrabold uppercase sm:text-4xl">
              Built for teams moving agent tools from scripts to controlled,
              account-owned production access.
            </h2>
          </div>
          <div class="grid gap-3 sm:grid-cols-3">
            <div class="border border-white/46 bg-black/64 p-4">
              <p class="text-sm font-extrabold uppercase">Account scoped</p>
              <p class="mt-2 text-sm leading-6 text-white/68">Routes and API keys attach to real accounts, not loose demo tokens.</p>
            </div>
            <div class="border border-white/46 bg-black/64 p-4">
              <p class="text-sm font-extrabold uppercase">Evidence first</p>
              <p class="mt-2 text-sm leading-6 text-white/68">Research and receipts describe what the tool proves and what it does not.</p>
            </div>
            <div class="border border-white/46 bg-black/64 p-4">
              <p class="text-sm font-extrabold uppercase">Ready to use</p>
              <p class="mt-2 text-sm leading-6 text-white/68">Checkout creates account-owned access without a manual onboarding cycle.</p>
            </div>
          </div>
        </section>

        <section class="grid gap-6 border-t-2 border-white py-10 lg:grid-cols-[1.1fr_0.9fr]">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-white/54">Immediate Access</p>
            <h2 class="mt-3 max-w-4xl text-3xl font-extrabold uppercase sm:text-4xl">
              Monarchic access starts when the product, account owner, and
              evidence boundary are explicit.
            </h2>
            <p class="mt-4 max-w-3xl text-sm leading-7 text-white/70">
              The first purchase is scoped around a named workflow, the MCP
              routes required for that workflow, and the receipts needed to
              use the system as production access from day one.
            </p>
          </div>
          <div class="grid gap-3">
            <div class="border border-white/46 bg-black/64 p-4">
              <p class="text-sm font-extrabold uppercase">Environment</p>
              <p class="mt-2 text-sm leading-6 text-white/68">
                Confirm the target repository, browser surface, memory scope,
                and account that owns the MCP route.
              </p>
            </div>
            <div class="border border-white/46 bg-black/64 p-4">
              <p class="text-sm font-extrabold uppercase">Evidence</p>
              <p class="mt-2 text-sm leading-6 text-white/68">
                Define the receipts, screenshots, logs, or catalog checks that
                count as proof for the workflow.
              </p>
            </div>
            <div class="border border-white/46 bg-black/64 p-4">
              <p class="text-sm font-extrabold uppercase">Handoff</p>
              <p class="mt-2 text-sm leading-6 text-white/68">
                Keep API access, billing, support scope, and rollback decisions
                attached to the same account.
              </p>
            </div>
          </div>
        </section>

        <section class="border-t-2 border-white py-10">
          <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.3em] text-white/54">What Ships</p>
              <h2 class="mt-3 max-w-3xl text-3xl font-extrabold uppercase sm:text-4xl">
                A Monarchic purchase is a routed MCP service with ownership,
                proof, and account controls.
              </h2>
              <p class="mt-4 max-w-2xl text-sm leading-7 text-white/70">
                Monarchic keeps the launch surface small enough to inspect:
                one account, one workflow, the MCP routes it needs, and the
                evidence that tells the team whether to expand, revise, or stop.
              </p>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <div class="border border-white/46 bg-black/64 p-4">
                <p class="text-sm font-extrabold uppercase">Hosted route</p>
                <p class="mt-2 text-sm leading-6 text-white/68">
                  A named MCP endpoint with account access, entitlement checks,
                  API-key setup, and target environment notes.
                </p>
              </div>
              <div class="border border-white/46 bg-black/64 p-4">
                <p class="text-sm font-extrabold uppercase">Owner record</p>
                <p class="mt-2 text-sm leading-6 text-white/68">
                  The billing account, owner contact, support path, and rollback
                  decision stay attached to the same workspace.
                </p>
              </div>
              <div class="border border-white/46 bg-black/64 p-4">
                <p class="text-sm font-extrabold uppercase">Evidence pack</p>
                <p class="mt-2 text-sm leading-6 text-white/68">
                  Screenshots, repository context, memory traces, logs, or
                  receipt files are collected for the workflow under test.
                </p>
              </div>
              <div class="border border-white/46 bg-black/64 p-4">
                <p class="text-sm font-extrabold uppercase">Exit criteria</p>
                <p class="mt-2 text-sm leading-6 text-white/68">
                  Expansion, revision, or shutdown decisions stay attached to
                  the account instead of drifting into unmanaged automation.
                </p>
              </div>
            </div>
          </div>
        </section>

        <section class="grid gap-6 border-t-2 border-white py-10 lg:grid-cols-[1fr_1fr]">
          <div class="border border-white/46 bg-black/64 p-5">
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-cyan-200">Best Fit</p>
            <h2 class="mt-3 text-2xl font-extrabold uppercase">
              Teams with agents already touching real repositories, browsers,
              and customer workflows.
            </h2>
            <p class="mt-4 text-sm leading-7 text-white/70">
              Start with a purchase when you need hosted tool access, evidence
              capture, account ownership, and a clear path to broader use.
            </p>
          </div>
          <div class="border border-white/46 bg-black/64 p-5">
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-amber-200">Not A Fit</p>
            <h2 class="mt-3 text-2xl font-extrabold uppercase">
              One-off demos, unaudited automations, or tools that do not need
              account-level control.
            </h2>
            <p class="mt-4 text-sm leading-7 text-white/70">
              Monarchic is intentionally oriented around hosted operations,
              receipts, billing handoff, and productized MCP access rather
              than unmanaged local experimentation.
            </p>
          </div>
        </section>

        <section class="flex flex-col gap-5 border-t-2 border-white py-10 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-white/54">Account Handoff</p>
            <h2 class="mt-3 max-w-3xl text-3xl font-extrabold uppercase sm:text-4xl">
              Pick a tool, review its evidence boundary, then buy access in the
              app and start using the hosted MCP route.
            </h2>
          </div>
          <a
            href={`${webappBaseUrl}/products`}
            class="inline-flex items-center justify-center border-2 border-cyan-300 px-5 py-3 text-xs font-bold uppercase tracking-[0.28em] text-cyan-200 transition hover:bg-cyan-200 hover:text-black"
          >
            Buy In App
          </a>
        </section>
      </section>
    </main>
  </body>
</html>
