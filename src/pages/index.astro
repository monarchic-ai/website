---
import Shader14 from "../components/Shader14.astro";
import SeoHead from "../components/SeoHead.astro";
import WaitlistForm from "../components/WaitlistForm.svelte";
import { cadenceLabel, findPlanBySlug, formatPriceUSD, resolveDisplayPrice } from "../lib/pricing";
import "../styles/global.css";

const apiBaseUrl = import.meta.env.PUBLIC_MONARCHIC_API_BASE_URL ?? "https://api.monarchic.io";

const featuredRoutes = [
  {
    slug: "mcp-explicitmem",
    label: "ExplicitMem",
    href: "/products/mcp-explicitmem",
    proof: "99.8% memory benchmark accuracy",
    role: "Durable memory",
  },
  {
    slug: "mcp-repointel",
    label: "RepoIntel",
    href: "/products/mcp-repointel",
    proof: "Repository maps and cited evidence",
    role: "Codebase context",
  },
  {
    slug: "mcp-browserops",
    label: "BrowserOps",
    href: "/products/mcp-browserops",
    proof: "Screenshots, console logs, and receipts",
    role: "Browser evidence",
  },
  {
    slug: "mcp-proofpack",
    label: "ProofPack",
    href: "/products/mcp-proofpack",
    proof: "Hashes, verification, and review packs",
    role: "Evidence handoff",
  },
].map((route) => {
  const plan = findPlanBySlug(route.slug);
  const displayPrice = plan ? resolveDisplayPrice(plan, "monthly") : null;
  return {
    ...route,
    price:
      displayPrice?.price.priceCents !== null && displayPrice?.price.priceCents !== undefined
        ? `${formatPriceUSD(displayPrice.price.priceCents)}${cadenceLabel(displayPrice.cadence)}`
        : null,
  };
});

const proofPoints = [
  ["Memory", "ExplicitMem publishes accuracy, recall, token, and hosted latency notes."],
  ["Repositories", "RepoIntel returns source paths and evidence instead of loose summaries."],
  ["Browser", "BrowserOps records screenshots, console output, network checks, and receipts."],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      title="Monarchic LLC | Hosted MCPs for agent engineering"
      description="Monarchic LLC sells hosted MCP routes for durable memory, repository intelligence, browser evidence, and proof-backed agent workflows."
      path="/"
    />
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="relative min-h-screen overflow-hidden">
      <Shader14 className="pointer-events-none fixed inset-0 h-full w-full opacity-70" />
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_bottom,_rgba(0,0,0,0.62),_rgba(0,0,0,0.86)_55%,_rgba(0,0,0,0.98))]"></div>
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(90deg,_rgba(0,0,0,0.9),_rgba(0,0,0,0.38)_48%,_rgba(0,0,0,0.82))]"></div>

      <section class="relative z-10 mx-auto max-w-7xl px-6 py-8 sm:py-12">
        <header class="flex flex-wrap items-center justify-between gap-5 border-b-2 border-white/88 pb-6">
          <a href="/" class="inline-flex items-center gap-3">
            <img src="/favicon.svg" alt="Monarchic LLC logo" class="h-9 w-9 bg-white object-cover p-1" width="36" height="36" />
            <span class="text-[0.7rem] font-semibold uppercase text-white/72">Monarchic LLC</span>
          </a>
          <nav class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase">
            <a href="/products" class="border-2 border-white/82 px-4 py-2 transition hover:bg-white hover:text-black">Products</a>
            <a href="/tutorial" class="border-2 border-white/82 px-4 py-2 transition hover:bg-white hover:text-black">Tutorial</a>
            <a href="/research" class="border-2 border-white/82 px-4 py-2 transition hover:bg-white hover:text-black">Research</a>
          </nav>
        </header>

        <section class="grid min-h-[calc(100vh-112px)] gap-8 py-10 lg:min-h-[640px] lg:grid-cols-[1fr_0.82fr] lg:items-center">
          <div>
            <p class="mb-5 inline-flex border border-white/46 bg-black/48 px-3 py-2 text-xs font-bold uppercase text-white/68">
              Hosted MCP infrastructure
            </p>
            <h1 class="max-w-5xl text-5xl font-extrabold uppercase leading-[0.88] text-white sm:text-7xl lg:text-8xl [text-shadow:8px_8px_0_rgba(255,255,255,0.11)]">
              Agent tools that leave evidence.
            </h1>
            <p class="mt-7 max-w-2xl text-base leading-8 text-white/76 sm:text-lg">
              Monarchic sells hosted MCP routes for agents that need memory,
              repository context, browser checks, and proof-backed handoffs
              without running the infrastructure yourself.
            </p>
            <div class="mt-8 flex flex-wrap gap-3 text-xs font-bold uppercase">
              <a href="/products" class="inline-flex items-center justify-center border-2 border-white bg-white px-5 py-3 text-black transition hover:bg-black hover:text-white">
                View products
              </a>
              <a href="/tutorial" class="inline-flex items-center justify-center border-2 border-cyan-300 px-5 py-3 text-cyan-200 transition hover:bg-cyan-200 hover:text-black">
                Use the MCPs
              </a>
              <a href="#waitlist" class="inline-flex items-center justify-center border-2 border-white/88 px-5 py-3 text-white transition hover:bg-white hover:text-black">
                Join waitlist
              </a>
            </div>
          </div>

          <aside class="border-2 border-white bg-black/72 shadow-[12px_12px_0_rgba(255,255,255,0.1)]">
            <div class="border-b-2 border-white px-5 py-4">
              <p class="text-xs font-bold uppercase text-white/58">Available first</p>
              <h2 class="mt-2 text-3xl font-extrabold uppercase leading-none">Individual MCP routes</h2>
            </div>
            <div class="divide-y divide-white/24">
              {featuredRoutes.map((route) => (
                <a href={route.href} class="group grid gap-3 px-5 py-5 transition hover:bg-white hover:text-black sm:grid-cols-[1fr_auto]">
                  <div>
                    <p class="text-sm font-extrabold uppercase">{route.label}</p>
                    <p class="mt-1 text-xs font-bold uppercase text-white/48 group-hover:text-black/48">{route.role}</p>
                    <p class="mt-3 text-sm leading-6 text-white/70 group-hover:text-black/70">{route.proof}</p>
                  </div>
                  {route.price && (
                    <p class="self-start border border-white/50 px-3 py-2 text-sm font-extrabold uppercase group-hover:border-black/50">
                      {route.price}
                    </p>
                  )}
                </a>
              ))}
            </div>
          </aside>
        </section>

        <section class="border-t-2 border-white py-10">
          <div class="grid gap-5 lg:grid-cols-[0.8fr_1.2fr]">
            <div>
              <p class="text-xs font-bold uppercase text-white/54">What Monarchic is</p>
              <h2 class="mt-3 max-w-3xl text-3xl font-extrabold uppercase leading-tight sm:text-4xl">
                A hosted layer for agent work that should be inspectable.
              </h2>
            </div>
            <div class="grid gap-3 md:grid-cols-3">
              {proofPoints.map(([label, copy]) => (
                <div class="border border-white/46 bg-black/64 p-5">
                  <p class="text-sm font-extrabold uppercase">{label}</p>
                  <p class="mt-2 text-sm leading-6 text-white/68">{copy}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="border-t-2 border-white py-10">
          <div class="grid gap-5 lg:grid-cols-[1.05fr_0.95fr]">
            <div class="border-2 border-white bg-white p-6 text-black">
              <p class="text-xs font-bold uppercase text-black/54">Pricing model</p>
              <h2 class="mt-3 max-w-3xl text-3xl font-extrabold uppercase leading-tight sm:text-4xl">
                Buy one route, or use the shared usage tiers when you need the full catalog.
              </h2>
              <p class="mt-4 max-w-2xl text-sm leading-7 text-black/72">
                Single MCP subscriptions are priced for focused workflows. Usage
                tiers cover broader hosted agent work where route cost and
                volume vary by account.
              </p>
              <a href="/products" class="mt-6 inline-flex border-2 border-black px-5 py-3 text-xs font-bold uppercase transition hover:bg-black hover:text-white">
                Compare plans
              </a>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
              <a href="/products/mcp-repointel" class="group border border-white/46 bg-black/64 p-5 transition hover:bg-white hover:text-black">
                <p class="text-sm font-extrabold uppercase">Start narrow</p>
                <p class="mt-2 text-sm leading-6 text-white/68 group-hover:text-black/68">Pick one route such as RepoIntel or ExplicitMem when one agent workflow is the bottleneck.</p>
              </a>
              <a href="/products/usage-developer" class="group border border-white/46 bg-black/64 p-5 transition hover:bg-white hover:text-black">
                <p class="text-sm font-extrabold uppercase">Scale usage</p>
                <p class="mt-2 text-sm leading-6 text-white/68 group-hover:text-black/68">Move to a usage tier when multiple MCPs call Monarchic infrastructure regularly.</p>
              </a>
            </div>
          </div>
        </section>

        <section id="waitlist" class="border-t-2 border-white py-10">
          <div class="grid gap-5 lg:grid-cols-[0.9fr_1.1fr]">
            <div>
              <p class="text-xs font-bold uppercase text-white/54">Next step</p>
              <h2 class="mt-3 max-w-3xl text-3xl font-extrabold uppercase leading-tight sm:text-4xl">
                Use the catalog, then tell us which route should be opened for your account.
              </h2>
              <p class="mt-4 max-w-2xl text-sm leading-7 text-white/70">
                Access is still gated while account controls and route
                availability finish release checks. The product pages show the
                current pricing and proof boundary for each MCP.
              </p>
            </div>
            <div class="border-2 border-white bg-black p-6 shadow-[10px_10px_0_rgba(255,255,255,0.12)]">
              <WaitlistForm client:load apiBaseUrl={apiBaseUrl} slug="monarchic-ai" submitLabel="Join waitlist" />
            </div>
          </div>
        </section>
      </section>
    </main>
  </body>
</html>
