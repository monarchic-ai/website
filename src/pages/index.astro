---
import PublicPageFrame from "../components/PublicPageFrame.astro";
import SeoHead from "../components/SeoHead.astro";
import SystemField from "../components/SystemField.astro";
import { explicitMemBenchmark } from "../lib/explicitmemBenchmark";
import { allPlans, hostedMcpStatus } from "../lib/pricing";
import "../styles/global.css";

const appBaseUrl = (import.meta.env.PUBLIC_MONARCHIC_WEBAPP_BASE_URL ?? "https://app.monarchic.io").replace(/\/$/, "");
const publicMcpProducts = allPlans.filter((plan) => plan.kind === "single-mcp");
const availableEnhancementCount = publicMcpProducts.filter((plan) => hostedMcpStatus(plan) === "available").length;

const systemLayers = [
  {
    number: "01",
    title: "Capabilities",
    copy: "AI agent enhancements add specialist capabilities for repository work, memory, delivery, infrastructure, browser testing, and business operations. Each connects through a hosted MCP.",
  },
  {
    number: "02",
    title: "Runs",
    copy: "Plans, tasks, state transitions, usage, and review decisions persist outside any one model call.",
  },
  {
    number: "03",
    title: "Workers",
    copy: "Workers materialize repositories, execute tasks, and return logs and artifacts inside a run-scoped workspace.",
  },
  {
    number: "04",
    title: "Review",
    copy: "A person can monitor progress, inspect artifacts, and decide whether the run continues, stops, or needs revision.",
  },
];

const featuredRoutes = [
  {
    label: "RepoIntel",
    href: "/products/mcp-repointel",
    proof: "Maps architecture and returns answers with source-file citations.",
    role: "Repository intelligence",
  },
  {
    label: "ExplicitMem",
    href: "/products/mcp-explicitmem",
    proof: `${explicitMemBenchmark.answerAccuracy} accuracy (${explicitMemBenchmark.passedQuestions}/${explicitMemBenchmark.questions}) on the fixed ${explicitMemBenchmark.benchmark} run.`,
    role: "Memory research",
  },
  {
    label: "ReleaseOps",
    href: "/products/mcp-releaseops",
    proof: "Checks release conditions and packages failures and handoff artifacts.",
    role: "Release management",
  },
];

const publicRecord = [
  {
    label: "Research",
    title: "Methods and results",
    copy: "See the method, dataset, measurements, and misses behind each published result.",
    href: "/research",
    action: "Read the record",
  },
  {
    label: "Security",
    title: "Controls in place",
    copy: "See the controls deployed today, the permissions each route needs, and the limits still open.",
    href: "/security",
    action: "Review security",
  },
  {
    label: "Company",
    title: "Company and product status",
    copy: "See what Monarchic is building, what is available now, and what remains in development.",
    href: "/company",
    action: "About Monarchic",
  },
];

const futureWork = [
  {
    number: "01",
    phase: "In development",
    title: "Long-running agent workflows",
    copy: "The Monarchic product in development is an account-level surface for launching, monitoring, reviewing, and controlling agent work across multiple tasks.",
    href: "/products/monarchic-ai",
    action: "View product status",
  },
  {
    number: "02",
    phase: "Research direction",
    title: "Beyond software engineering",
    copy: "The longer-term direction extends agent systems into scientific and business work. No product in those fields is available today.",
    href: "/company",
    action: "Read company direction",
  },
];

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#080808" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title="Monarchic | AI engineering systems"
      description="Monarchic is an independent R&D company building AI agent enhancements and execution infrastructure for long-running work."
      path="/"
    />
  </head>
  <body class="min-h-screen bg-ink text-white">
    <PublicPageFrame>

      <section id="introduction" aria-labelledby="home-title" class="home-lab border-b border-white/20" data-company-first data-system-posture>
        <div class="home-hero-stage grid lg:min-h-[47rem] lg:grid-cols-[minmax(0,1.35fr)_minmax(26rem,0.65fr)] xl:min-h-[50rem]">
          <div class="home-hero-copy relative min-w-0 px-4 py-11 sm:px-6 sm:py-14 lg:px-8 lg:py-16" data-hero-background="static-topology-field">
            <svg class="home-hero-topology absolute inset-0 h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none" shape-rendering="crispEdges" aria-hidden="true">
              <path class="home-hero-trace home-hero-trace--one" d="M-24 14H-16V10H-8V18H0V14H8V6H16V22H24V14H32V10H40V18H48V14H56V6H64V22H72V14H80V10H88V18H96V14H104V6H112V22H120V14H128" vector-effect="non-scaling-stroke"></path>
              <path class="home-hero-trace home-hero-trace--two" d="M-24 29H-12V23H0V35H12V29H24V19H36V39H48V29H60V23H72V35H84V29H96V19H108V39H120V29H132" vector-effect="non-scaling-stroke"></path>
              <path class="home-hero-trace home-hero-trace--three" d="M-24 43H-18V39H-6V47H6V43H18V33H30V53H42V43H54V39H66V47H78V43H90V33H102V53H114V43H132" vector-effect="non-scaling-stroke"></path>
              <path class="home-hero-trace home-hero-trace--four" d="M-24 58H-12V52H0V64H12V58H24V48H36V68H48V58H60V52H72V64H84V58H96V48H108V68H120V58H132" vector-effect="non-scaling-stroke"></path>
              <path class="home-hero-trace home-hero-trace--five" d="M-24 73H-16V69H-8V77H0V73H8V65H16V81H24V73H32V69H40V77H48V73H56V65H64V81H72V73H80V69H88V77H96V73H104V65H112V81H120V73H128" vector-effect="non-scaling-stroke"></path>
              <path class="home-hero-trace home-hero-trace--six" d="M-24 88H-12V82H0V94H12V88H24V78H36V98H48V88H60V82H72V94H84V88H96V78H108V98H120V88H132" vector-effect="non-scaling-stroke"></path>

              <path class="home-hero-signal home-hero-signal--two" d="M-24 29H-12V23H0V35H12V29H24V19H36V39H48V29H60V23H72V35H84V29H96V19H108V39H120V29H132" pathLength="100" vector-effect="non-scaling-stroke"></path>
              <path class="home-hero-signal home-hero-signal--four" d="M-24 58H-12V52H0V64H12V58H24V48H36V68H48V58H60V52H72V64H84V58H96V48H108V68H120V58H132" pathLength="100" vector-effect="non-scaling-stroke"></path>
              <path class="home-hero-signal home-hero-signal--six" d="M-24 88H-12V82H0V94H12V88H24V78H36V98H48V88H60V82H72V94H84V88H96V78H108V98H120V88H132" pathLength="100" vector-effect="non-scaling-stroke"></path>

              <path class="home-hero-datum" d="M10 3V10M7 10H13M10 14V29M7 29H13M10 33V48M7 48H13M10 52V67M7 67H13M10 71V86M7 86H13M10 90V97" vector-effect="non-scaling-stroke"></path>

              <g class="home-hero-samples">
                <rect class="home-hero-sample home-hero-sample--white" x="7.1" y="5.2" width="1.8" height="1.5"></rect>
                <rect class="home-hero-sample" x="23.1" y="18.2" width="2.2" height="1.7"></rect>
                <rect class="home-hero-sample" x="35.1" y="38.2" width="1.8" height="1.6"></rect>
                <rect class="home-hero-sample home-hero-sample--white" x="53.2" y="38.2" width="1.7" height="1.6"></rect>
                <rect class="home-hero-sample" x="59.1" y="51.2" width="2" height="1.7"></rect>
                <rect class="home-hero-sample" x="71.1" y="63.2" width="2.2" height="1.7"></rect>
                <rect class="home-hero-sample home-hero-sample--white" x="79.1" y="68.2" width="1.8" height="1.6"></rect>
                <rect class="home-hero-sample" x="95.1" y="77.2" width="2.2" height="1.7"></rect>
                <rect class="home-hero-sample" x="83.1" y="87.2" width="1.8" height="1.6"></rect>
              </g>

              <g class="home-hero-register">
                <rect class="home-hero-register-bit" x="82" y="5" width="1" height="0.8"></rect>
                <rect class="home-hero-register-bit" x="83.8" y="5" width="2.3" height="0.8"></rect>
                <rect class="home-hero-register-bit" x="86.9" y="5" width="1" height="0.8"></rect>
                <rect class="home-hero-register-bit" x="88.7" y="5" width="3.4" height="0.8"></rect>
                <rect class="home-hero-register-bit" x="92.9" y="5" width="1" height="0.8"></rect>
                <rect class="home-hero-register-bit" x="94.7" y="5" width="2.8" height="0.8"></rect>
                <rect class="home-hero-register-bit" x="82" y="7" width="2.8" height="0.8"></rect>
                <rect class="home-hero-register-bit" x="85.6" y="7" width="1" height="0.8"></rect>
                <rect class="home-hero-register-bit" x="87.4" y="7" width="1.6" height="0.8"></rect>
                <rect class="home-hero-register-bit" x="89.8" y="7" width="1" height="0.8"></rect>
                <rect class="home-hero-register-bit" x="91.6" y="7" width="2.8" height="0.8"></rect>
                <rect class="home-hero-register-bit" x="95.2" y="7" width="2.3" height="0.8"></rect>
              </g>
            </svg>
            <div class="home-hero-content" data-hero-priority-layer="content">
              <p class="font-mono text-[0.64rem] font-bold uppercase text-white/54">Monarchic, LLC / AI R&amp;D company</p>
              <h1 id="home-title" class="mt-6 max-w-5xl text-[2.75rem] font-black uppercase leading-[0.82] min-[360px]:text-[3.2rem] sm:text-[5.2rem] lg:text-[6.9rem]">
                <span class="block">Monarchic builds</span>
                <span class="home-hero-outline block">agent systems.</span>
              </h1>
              <p class="mt-8 max-w-3xl text-lg font-medium leading-8 text-white/76 sm:text-2xl sm:leading-9">
                Production infrastructure for capable AI agents. Hosted MCPs provide repository context, persistent memory, browser control, and release operations through one account.
              </p>
              <p class="home-operating-assumption mt-8 max-w-2xl border-l-2 border-signal pl-4 font-mono text-xs font-bold uppercase leading-6 text-white/58 sm:text-sm">
                Operator controls / See each task, review the result, or stop the run.
              </p>
              <div class="mt-9 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
                <a href="/products" class="motion-link inline-flex min-h-12 items-center justify-between gap-6 border border-signal bg-signal px-5 text-xs font-black uppercase text-black hover:bg-signal-soft">
                  Explore products <span class="motion-arrow" aria-hidden="true">↗</span>
                </a>
                <a href="#current-work" class="motion-link inline-flex min-h-12 items-center justify-between gap-6 border border-white/40 px-5 text-xs font-black uppercase text-white hover:border-signal hover:bg-signal hover:text-black">
                  See current work <span class="motion-arrow" aria-hidden="true">↓</span>
                </a>
              </div>
            </div>
          </div>

          <SystemField {availableEnhancementCount} />
        </div>

        <dl class="home-proof-rail grid border-t border-white/20 md:grid-cols-3">
          <div class="border-b border-white/20 p-4 sm:p-5 md:border-b-0 md:border-r">
            <dt class="font-mono text-[0.56rem] font-bold uppercase text-white/54">Company</dt>
            <dd class="mt-2 text-sm font-black uppercase text-white">Monarchic, LLC</dd>
          </div>
          <div class="border-b border-white/20 p-4 sm:p-5 md:border-b-0 md:border-r">
            <dt class="font-mono text-[0.56rem] font-bold uppercase text-white/54">What we build</dt>
            <dd class="mt-2 text-sm font-black uppercase text-white">AI engineering systems</dd>
          </div>
          <div class="p-4 sm:p-5">
            <dt class="font-mono text-[0.56rem] font-bold uppercase text-white/54">Focus</dt>
            <dd class="mt-2 text-sm font-black uppercase text-white">Agent infrastructure / Research tools / Hosted MCPs</dd>
          </div>
        </dl>
      </section>

      <section id="what-we-build" aria-labelledby="what-we-build-title" class="border-b border-white/20">
        <header class="grid gap-5 p-5 sm:p-7 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-end">
          <div>
            <p class="font-mono text-[0.65rem] font-bold uppercase text-signal">What we do</p>
            <h2 id="what-we-build-title" class="mt-3 text-4xl font-black uppercase leading-[0.92] sm:text-5xl">What Monarchic builds.</h2>
          </div>
          <p class="max-w-2xl text-sm leading-7 text-white/64">
            We build AI agent capabilities and the run infrastructure around them. Together they carry a job across multiple agent steps and return a record of what happened.
          </p>
        </header>
        <ol class="grid gap-px border-t border-white/20 bg-white/20 sm:grid-cols-2 lg:grid-cols-4">
          {systemLayers.map((item) => (
            <li class="home-method-item relative flex min-h-64 flex-col overflow-hidden bg-ink p-5 sm:p-6" data-step={item.number}>
              <span class="font-mono text-xs font-bold text-signal">{item.number}</span>
              <div class="mt-auto pt-10">
                <h3 class="text-2xl font-black uppercase">{item.title}</h3>
                <p class="mt-3 text-sm leading-6 text-white/64">{item.copy}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="company-vision" aria-labelledby="company-vision-title" class="home-doctrine border-b border-white/20">
        <div class="grid lg:grid-cols-[minmax(0,1.1fr)_minmax(22rem,0.9fr)]">
          <header class="home-doctrine-main bg-signal p-5 text-black sm:p-7 lg:p-9">
            <p class="font-mono text-[0.65rem] font-bold uppercase text-black/58">Company vision</p>
            <h2 id="company-vision-title" class="mt-4 max-w-4xl text-4xl font-black uppercase leading-[0.9] sm:text-6xl">
              A person should be able to assign a job and review the result.
            </h2>
            <p class="mt-6 max-w-3xl text-base font-medium leading-7 text-black/72 sm:text-lg sm:leading-8">
              The system should carry the work across many steps, preserve what happened, and return a result that can be checked before it is accepted.
            </p>
          </header>
          <div class="border-t border-white/20 bg-[#0b0d10] lg:border-l lg:border-t-0">
            <article class="border-b border-white/20 p-5 sm:p-7">
              <p class="font-mono text-[0.62rem] font-bold uppercase text-signal">Starting point</p>
              <h3 class="mt-3 text-2xl font-black uppercase text-white">Engineering first.</h3>
              <p class="mt-4 text-sm leading-7 text-white/58">Software work gives us repositories, tests, diffs, and release gates. Progress can be measured instead of guessed.</p>
            </article>
            <article class="p-5 sm:p-7">
              <p class="font-mono text-[0.62rem] font-bold uppercase text-signal">Human authority</p>
              <h3 class="mt-3 text-2xl font-black uppercase text-white">The operator stays in charge.</h3>
              <p class="mt-4 text-sm leading-7 text-white/58">A person can see each task, review the output, and decide whether to accept it.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="current-work" aria-labelledby="current-work-title" class="border-b border-white/20 bg-[#0a0a0a]">
        <header class="grid border-b border-white/20 lg:grid-cols-[minmax(0,1fr)_24rem]">
          <div class="p-5 sm:p-7">
            <p class="font-mono text-[0.65rem] font-bold uppercase text-signal">Available now / AI Agent Enhancements</p>
            <h2 id="current-work-title" class="mt-3 max-w-4xl text-4xl font-black uppercase leading-[0.92] sm:text-5xl">
              {availableEnhancementCount} agent enhancements are available.
            </h2>
          </div>
          <div class="border-t border-white/20 p-5 lg:border-l lg:border-t-0 lg:p-7">
            <p class="text-sm leading-7 text-white/68">
              The product line covers repository intelligence, memory, release management, infrastructure, browser testing, and business operations. Each enhancement is delivered through a hosted MCP connection. The long-running Monarchic workflow product is still in development.
            </p>
            <div class="mt-6 flex flex-wrap gap-2">
              <a href="/products/hosted-mcps" class="motion-link inline-flex min-h-11 items-center border border-signal bg-signal px-4 text-xs font-black uppercase text-black hover:bg-signal-soft">Explore agent enhancements</a>
              <a href={`${appBaseUrl}/products/usage-evaluation`} class="motion-link inline-flex min-h-11 items-center border border-white/40 px-4 text-xs font-black uppercase text-white hover:border-signal hover:text-signal-soft">Start free evaluation</a>
            </div>
          </div>
        </header>

        <div>
          {featuredRoutes.map((route, index) => (
            <a href={route.href} class:list={[
              "interactive-row group grid items-center gap-3 px-5 py-4 hover:bg-signal hover:text-black sm:min-h-28 sm:grid-cols-[minmax(10rem,0.52fr)_minmax(0,1fr)_2rem] sm:gap-5 sm:px-7 sm:py-5",
              index < featuredRoutes.length - 1 && "border-b border-white/20",
            ]}>
              <div>
                <p class="text-xl font-black uppercase">{route.label}</p>
                <p class="mt-1 font-mono text-[0.62rem] font-bold uppercase opacity-62">{route.role}</p>
              </div>
              <p class="max-w-2xl text-sm leading-6 opacity-74">{route.proof}</p>
              <span class="row-arrow hidden text-xl sm:inline" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>

      <section id="future-work" aria-labelledby="future-work-title" class="border-b border-white/20">
        <header class="grid gap-5 border-b border-white/20 p-5 sm:p-7 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-end">
          <div>
            <p class="font-mono text-[0.65rem] font-bold uppercase text-signal">What's next / Company direction</p>
            <h2 id="future-work-title" class="mt-3 max-w-4xl text-4xl font-black uppercase leading-[0.92] sm:text-5xl">Current status. Future direction.</h2>
          </div>
          <p class="max-w-2xl text-sm leading-7 text-white/64">
            Product status and research direction are different things. We label them separately.
          </p>
        </header>
        <div class="grid gap-px bg-white/20 lg:grid-cols-2">
          {futureWork.map((item) => (
            <article class="relative flex min-h-[22rem] flex-col overflow-hidden bg-ink p-5 sm:p-7">
              <span class="pointer-events-none absolute -right-2 -top-5 text-[9rem] font-black leading-none text-white/[0.035]" aria-hidden="true">{item.number}</span>
              <p class="relative font-mono text-[0.62rem] font-bold uppercase text-signal">{item.phase}</p>
              <h3 class="relative mt-8 max-w-xl text-3xl font-black uppercase leading-none sm:text-4xl">{item.title}</h3>
              <p class="relative mt-5 max-w-2xl text-sm leading-7 text-white/62">{item.copy}</p>
              <a href={item.href} class="motion-link relative mt-auto inline-flex min-h-11 items-center justify-between border border-white/40 px-4 text-xs font-black uppercase hover:border-signal hover:text-signal-soft">
                {item.action} <span class="motion-arrow" aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section id="public-record" aria-labelledby="public-record-title" class="border-b border-white/20">
        <header class="grid gap-5 border-b border-white/20 p-5 sm:p-7 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-end">
          <div>
            <p class="font-mono text-[0.65rem] font-bold uppercase text-signal">Public record</p>
            <h2 id="public-record-title" class="mt-3 max-w-4xl text-4xl font-black uppercase leading-[0.92] sm:text-5xl">Research. Security. Company.</h2>
          </div>
          <p class="text-sm leading-7 text-white/64">
            Research is for methods and measured results. Security is for controls in place today. Company is for scope and product status.
          </p>
        </header>
        <div class="grid lg:grid-cols-3">
          {publicRecord.map((item, index) => (
            <article class:list={[
              "group flex min-h-72 flex-col p-5 sm:p-7",
              index < publicRecord.length - 1 && "border-b border-white/20 lg:border-b-0 lg:border-r",
            ]}>
              <p class="font-mono text-[0.62rem] font-bold uppercase text-white/46">{item.label}</p>
              <h3 class="mt-7 text-2xl font-black uppercase">{item.title}</h3>
              <p class="mt-4 text-sm leading-7 text-white/62">{item.copy}</p>
              <a href={item.href} class="motion-link mt-auto inline-flex min-h-11 items-center justify-between border border-white/40 px-4 text-xs font-black uppercase hover:border-signal hover:text-signal-soft">
                {item.action} <span class="motion-arrow" aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

    </PublicPageFrame>
  </body>
</html>
