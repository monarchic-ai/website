---
import Shader14 from "../components/Shader14.astro";
import "../styles/global.css";

const loginUrl = import.meta.env.PUBLIC_MONARCHIC_AUTH_LOGIN_URL ?? "#access";
const signupUrl = import.meta.env.PUBLIC_MONARCHIC_AUTH_SIGNUP_URL ?? loginUrl;
const apiBaseUrl =
  import.meta.env.PUBLIC_MONARCHIC_API_BASE_URL ?? "https://dev-api.monarchic.io";
const mcpServerName =
  import.meta.env.PUBLIC_MONARCHIC_MCP_SERVER_NAME ?? "monarchic";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Monarchic AI Access</title>
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="relative min-h-screen overflow-hidden">
      <Shader14
        className="pointer-events-none absolute inset-0 h-full w-full"
        color="#7dd3fc"
      />
      <div class="pointer-events-none absolute inset-0 bg-black/80"></div>

      <section class="relative z-10 mx-auto grid min-h-screen w-full max-w-7xl content-center gap-8 px-5 py-8 md:grid-cols-[minmax(0,0.9fr)_minmax(420px,1.1fr)] md:px-8">
        <div class="flex min-h-[56vh] flex-col justify-between gap-10 py-6">
          <nav class="flex items-center justify-between gap-4">
            <a href="/" class="flex items-center gap-3">
              <img
                src="/favicon.svg"
                alt="Monarchic AI logo"
                class="h-10 w-10 bg-white object-cover p-1"
                width="40"
                height="40"
              />
              <span class="text-sm font-semibold uppercase text-white/80">
                Monarchic AI
              </span>
            </a>
            <a
              href={loginUrl}
              class="border border-white/80 px-4 py-2 text-sm font-semibold uppercase text-white transition hover:bg-white hover:text-black focus:outline-none focus:ring-2 focus:ring-cyan-300"
            >
              Sign in
            </a>
          </nav>

          <div class="max-w-3xl">
            <p class="mb-4 inline-flex border border-cyan-300 bg-cyan-300 px-3 py-1 text-xs font-bold uppercase text-black">
              Hosted access
            </p>
            <h1 class="text-5xl font-extrabold uppercase leading-none sm:text-6xl lg:text-7xl">
              Account and MCP credentials
            </h1>
            <p class="mt-5 max-w-2xl text-lg leading-8 text-white/78">
              Sign in, create access credentials, and connect hosted Monarchic
              from MCP clients without running a local server.
            </p>
          </div>

          <div class="grid gap-3 sm:grid-cols-3">
            <div class="border border-white/30 bg-black/60 p-4">
              <p class="text-xs font-semibold uppercase text-cyan-200">OAuth/OIDC</p>
              <p class="mt-2 text-sm text-white/70">Primary account session</p>
            </div>
            <div class="border border-white/30 bg-black/60 p-4">
              <p class="text-xs font-semibold uppercase text-amber-200">Bearer</p>
              <p class="mt-2 text-sm text-white/70">MCP fallback token</p>
            </div>
            <div class="border border-white/30 bg-black/60 p-4">
              <p class="text-xs font-semibold uppercase text-emerald-200">API key</p>
              <p class="mt-2 text-sm text-white/70">Longer-lived client key</p>
            </div>
          </div>
        </div>

        <section
          id="access"
          class="grid gap-4 border-2 border-white bg-black/82 p-4 shadow-[10px_10px_0_rgba(125,211,252,0.28)] sm:p-6"
          data-api-base-url={apiBaseUrl}
          data-mcp-server-name={mcpServerName}
        >
          <div class="flex flex-col gap-3 border-b border-white/20 pb-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h2 class="text-2xl font-black uppercase">Access console</h2>
              <p class="mt-2 text-sm leading-6 text-white/68">
                Use your account session first. Keep API keys and bearer tokens
                scoped to the tenants and route scopes they need.
              </p>
            </div>
            <div class="flex shrink-0 gap-2">
              <a
                href={signupUrl}
                class="bg-white px-4 py-2 text-sm font-bold uppercase text-black transition hover:bg-cyan-200 focus:outline-none focus:ring-2 focus:ring-cyan-300"
              >
                Create account
              </a>
              <a
                href={loginUrl}
                class="border border-white/80 px-4 py-2 text-sm font-bold uppercase text-white transition hover:bg-white hover:text-black focus:outline-none focus:ring-2 focus:ring-cyan-300"
              >
                Login
              </a>
            </div>
          </div>

          <div class="grid gap-4 lg:grid-cols-2">
            <article class="border border-white/24 bg-zinc-950 p-4">
              <div class="flex items-center justify-between gap-3">
                <h3 class="font-black uppercase">Bearer token</h3>
                <span
                  id="token-status"
                  class="bg-amber-300 px-2 py-1 text-xs font-bold uppercase text-black"
                >
                  Signed out
                </span>
              </div>
              <label
                for="bearer-token"
                class="mt-4 block text-xs font-semibold uppercase text-white/62"
              >
                Current token
              </label>
              <textarea
                id="bearer-token"
                class="mt-2 min-h-28 w-full resize-none border border-white/30 bg-black p-3 font-mono text-xs leading-5 text-white outline-none focus:border-cyan-300"
                readonly
                placeholder="Sign in to show a hosted bearer token."
              ></textarea>
              <div class="mt-3 grid gap-2 sm:grid-cols-2">
                <button
                  id="copy-token"
                  class="border border-white/70 px-3 py-2 text-sm font-bold uppercase text-white transition hover:bg-white hover:text-black focus:outline-none focus:ring-2 focus:ring-cyan-300 disabled:cursor-not-allowed disabled:border-white/20 disabled:text-white/30 disabled:hover:bg-transparent disabled:hover:text-white/30"
                  type="button"
                  disabled
                >
                  Copy token
                </button>
                <button
                  id="clear-token"
                  class="border border-red-300/80 px-3 py-2 text-sm font-bold uppercase text-red-100 transition hover:bg-red-300 hover:text-black focus:outline-none focus:ring-2 focus:ring-red-300 disabled:cursor-not-allowed disabled:border-white/20 disabled:text-white/30 disabled:hover:bg-transparent disabled:hover:text-white/30"
                  type="button"
                  disabled
                >
                  Clear
                </button>
              </div>
            </article>

            <article class="border border-white/24 bg-zinc-950 p-4">
              <div class="flex items-center justify-between gap-3">
                <h3 class="font-black uppercase">API keys</h3>
                <span class="bg-emerald-300 px-2 py-1 text-xs font-bold uppercase text-black">
                  Planned
                </span>
              </div>
              <div class="mt-4 grid gap-3">
                <div class="border border-white/16 bg-black p-3">
                  <p class="text-xs font-semibold uppercase text-white/58">Key name</p>
                  <p class="mt-2 font-semibold">Default MCP key</p>
                </div>
                <div class="border border-white/16 bg-black p-3">
                  <p class="text-xs font-semibold uppercase text-white/58">Scopes</p>
                  <p class="mt-2 font-mono text-xs text-white/72">
                    projects:read runs:read runs:write artifacts:read reviews:write
                  </p>
                </div>
                <button
                  class="border border-white/20 px-3 py-2 text-sm font-bold uppercase text-white/35"
                  type="button"
                  disabled
                >
                  Create key
                </button>
              </div>
            </article>
          </div>

          <article class="border border-white/24 bg-zinc-950 p-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h3 class="font-black uppercase">MCP client config</h3>
                <p class="mt-2 text-sm text-white/64">
                  Uses the hosted Monarchic API endpoint and the bearer token
                  from the current signed-in session.
                </p>
              </div>
              <button
                id="copy-mcp-config"
                class="border border-white/70 px-3 py-2 text-sm font-bold uppercase text-white transition hover:bg-white hover:text-black focus:outline-none focus:ring-2 focus:ring-cyan-300 disabled:cursor-not-allowed disabled:border-white/20 disabled:text-white/30 disabled:hover:bg-transparent disabled:hover:text-white/30"
                type="button"
                disabled
              >
                Copy config
              </button>
            </div>
            <pre
              id="mcp-config"
              class="mt-4 max-h-64 overflow-auto border border-white/20 bg-black p-3 text-xs leading-5 text-white/72"
            ></pre>
          </article>
        </section>
      </section>
    </main>

    <script>
      const accessPanel = document.querySelector("#access");
      const tokenInput = document.querySelector("#bearer-token");
      const tokenStatus = document.querySelector("#token-status");
      const copyTokenButton = document.querySelector("#copy-token");
      const clearTokenButton = document.querySelector("#clear-token");
      const copyConfigButton = document.querySelector("#copy-mcp-config");
      const configOutput = document.querySelector("#mcp-config");

      const readTokenFromUrl = () => {
        const hashParams = new URLSearchParams(window.location.hash.replace(/^#/, ""));
        const searchParams = new URLSearchParams(window.location.search);
        return (
          hashParams.get("access_token") ||
          hashParams.get("bearer_token") ||
          searchParams.get("access_token") ||
          searchParams.get("bearer_token")
        );
      };

      const buildMcpConfig = (token) => {
        const apiBaseUrl = accessPanel?.getAttribute("data-api-base-url") || "";
        const serverName = accessPanel?.getAttribute("data-mcp-server-name") || "monarchic";
        return JSON.stringify(
          {
            mcpServers: {
              [serverName]: {
                command: "monarchic-mcp",
                args: ["--api-base-url", apiBaseUrl],
                env: {
                  MONARCHIC_API_BEARER_TOKEN: token || "<sign-in-first>",
                },
              },
            },
          },
          null,
          2,
        );
      };

      const setToken = (token) => {
        const hasToken = typeof token === "string" && token.length > 0;
        if (tokenInput instanceof HTMLTextAreaElement) {
          tokenInput.value = hasToken ? token : "";
        }
        if (tokenStatus instanceof HTMLElement) {
          tokenStatus.textContent = hasToken ? "Ready" : "Signed out";
          tokenStatus.className = hasToken
            ? "bg-emerald-300 px-2 py-1 text-xs font-bold uppercase text-black"
            : "bg-amber-300 px-2 py-1 text-xs font-bold uppercase text-black";
        }
        for (const button of [copyTokenButton, clearTokenButton, copyConfigButton]) {
          if (button instanceof HTMLButtonElement) {
            button.disabled = !hasToken;
          }
        }
        if (configOutput instanceof HTMLElement) {
          configOutput.textContent = buildMcpConfig(hasToken ? token : "");
        }
      };

      const urlToken = readTokenFromUrl();
      if (urlToken) {
        window.sessionStorage.setItem("monarchic_bearer_token", urlToken);
        window.history.replaceState(null, "", window.location.pathname);
      }
      setToken(window.sessionStorage.getItem("monarchic_bearer_token") || "");

      copyTokenButton?.addEventListener("click", async () => {
        if (tokenInput instanceof HTMLTextAreaElement && tokenInput.value) {
          await navigator.clipboard.writeText(tokenInput.value);
        }
      });

      copyConfigButton?.addEventListener("click", async () => {
        if (configOutput instanceof HTMLElement && configOutput.textContent) {
          await navigator.clipboard.writeText(configOutput.textContent);
        }
      });

      clearTokenButton?.addEventListener("click", () => {
        window.sessionStorage.removeItem("monarchic_bearer_token");
        setToken("");
      });
    </script>
  </body>
</html>
