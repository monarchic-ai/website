---
import PublicPageFrame from "../components/PublicPageFrame.astro";
import SeoHead from "../components/SeoHead.astro";
import SystemField from "../components/SystemField.astro";
import { explicitMemBenchmark } from "../lib/explicitmemBenchmark";
import { allPlans, hostedMcpStatus } from "../lib/pricing";
import "../styles/global.css";

const appBaseUrl = (import.meta.env.PUBLIC_MONARCHIC_WEBAPP_BASE_URL ?? "https://app.monarchic.io").replace(/\/$/, "");
const publicMcpProducts = allPlans.filter((plan) => plan.kind === "single-mcp");
const availableMcpCount = publicMcpProducts.filter((plan) => hostedMcpStatus(plan) === "available").length;

const workingMethod = [
  {
    number: "01",
    title: "Brief",
    copy: "Define the job and its constraints. Decide what finished means before the run starts.",
  },
  {
    number: "02",
    title: "Plan",
    copy: "Break the job into ordered tasks. Give each task the role and tools it needs.",
  },
  {
    number: "03",
    title: "Run",
    copy: "Execute in scoped workspaces. Keep task state, logs, and artifacts with the run.",
  },
  {
    number: "04",
    title: "Review",
    copy: "Test the result against the plan. A person decides whether the work is done.",
  },
];

const featuredRoutes = [
  {
    label: "RepoIntel",
    href: "/products/mcp-repointel",
    proof: "Maps architecture and returns source-cited repository evidence.",
    role: "Repository intelligence",
  },
  {
    label: "ExplicitMem",
    href: "/products/mcp-explicitmem",
    proof: `${explicitMemBenchmark.answerAccuracy} accuracy (${explicitMemBenchmark.passedQuestions}/${explicitMemBenchmark.questions}) on the fixed ${explicitMemBenchmark.benchmark} run.`,
    role: "Memory research",
  },
  {
    label: "ReleaseOps",
    href: "/products/mcp-releaseops",
    proof: "Checks release readiness and packages evidence-backed handoffs.",
    role: "Release management",
  },
];

const publicRecord = [
  {
    label: "Research",
    title: "Methods and results",
    copy: "See the method, dataset, measurements, and misses behind each published result.",
    href: "/research",
    action: "Read the record",
  },
  {
    label: "Security",
    title: "Controls in place",
    copy: "See the controls deployed today, the permissions each route needs, and the limits still open.",
    href: "/security",
    action: "Review security",
  },
  {
    label: "Company",
    title: "Company and product status",
    copy: "See what Monarchic is building, what is available now, and what remains in development.",
    href: "/company",
    action: "About Monarchic",
  },
];

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#080808" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title="Monarchic | Automation research and development"
      description="Monarchic is an independent R&D company building an execution system for long-running AI agent work, hosted MCP tools, and reviewable run artifacts."
      path="/"
    />
  </head>
  <body class="min-h-screen bg-ink text-white">
    <PublicPageFrame>

      <section id="introduction" aria-labelledby="home-title" class="home-lab border-b border-white/20" data-company-first data-system-posture>
        <div class="home-status-rail grid min-h-11 items-center gap-2 border-b border-white/20 px-4 py-2 font-mono text-[0.58rem] font-bold uppercase sm:grid-cols-[1fr_auto] sm:px-6 lg:px-8">
          <p class="text-signal">Monarchic / Agent systems R&amp;D</p>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-white/54">
            <span>Hosted platform / Public website</span>
            <span>Monarchic, LLC</span>
          </div>
        </div>

        <div class="grid lg:grid-cols-[minmax(0,1.35fr)_minmax(26rem,0.65fr)]">
          <div class="home-hero-copy relative min-w-0 px-4 py-11 sm:px-6 sm:py-14 lg:px-8 lg:py-16">
            <p class="font-mono text-[0.64rem] font-bold uppercase text-white/54">AI agent execution / Hosted MCP infrastructure</p>
            <h1 id="home-title" class="mt-6 max-w-5xl text-[2.75rem] font-black uppercase leading-[0.82] min-[360px]:text-[3.2rem] sm:text-[5.2rem] lg:text-[6.9rem]">
              <span class="block">Agents should</span>
              <span class="home-hero-outline block">finish the job.</span>
            </h1>
            <p class="mt-8 max-w-3xl text-lg font-medium leading-8 text-white/76 sm:text-2xl sm:leading-9">
              Monarchic is an independent R&amp;D company building an execution system for long-running AI agent work. The plan, task state, artifacts, and review history stay with the run.
            </p>
            <p class="home-operating-assumption mt-8 max-w-2xl border-l-2 border-signal pl-4 font-mono text-xs font-bold uppercase leading-6 text-white/58 sm:text-sm">
              A model response is not a completed task. The run ends when the work has been tested and reviewed.
            </p>
            <div class="mt-9 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
              <a href="/company" class="motion-link inline-flex min-h-12 items-center justify-between gap-6 border border-signal bg-signal px-5 text-xs font-black uppercase text-black hover:bg-signal-soft">
                About Monarchic <span class="motion-arrow" aria-hidden="true">↗</span>
              </a>
              <a href="/research" class="motion-link inline-flex min-h-12 items-center justify-between gap-6 border border-white/40 px-5 text-xs font-black uppercase text-white hover:border-signal hover:bg-signal hover:text-black">
                Read the research <span class="motion-arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <SystemField {availableMcpCount} />
        </div>

        <dl class="home-proof-rail grid border-t border-white/20 md:grid-cols-3">
          <div class="border-b border-white/20 p-4 sm:p-5 md:border-b-0 md:border-r">
            <dt class="font-mono text-[0.56rem] font-bold uppercase text-white/54">Company</dt>
            <dd class="mt-2 text-sm font-black uppercase text-white">Independent R&amp;D</dd>
          </div>
          <div class="border-b border-white/20 p-4 sm:p-5 md:border-b-0 md:border-r">
            <dt class="font-mono text-[0.56rem] font-bold uppercase text-white/54">Current focus</dt>
            <dd class="mt-2 text-sm font-black uppercase text-white">Agent execution systems</dd>
          </div>
          <div class="p-4 sm:p-5">
            <dt class="font-mono text-[0.56rem] font-bold uppercase text-white/54">Available now</dt>
            <dd class="mt-2 text-sm font-black uppercase text-white">{availableMcpCount} hosted MCPs</dd>
          </div>
        </dl>
      </section>

      <section id="company-thesis" aria-labelledby="company-thesis-title" class="home-doctrine border-b border-white/20">
        <div class="grid lg:grid-cols-[minmax(0,1.1fr)_minmax(22rem,0.9fr)]">
          <header class="home-doctrine-main bg-signal p-5 text-black sm:p-7 lg:p-9">
            <p class="font-mono text-[0.65rem] font-bold uppercase text-black/58">Company thesis</p>
            <h2 id="company-thesis-title" class="mt-4 max-w-4xl text-4xl font-black uppercase leading-[0.9] sm:text-6xl">
              Long-running work needs a record.
            </h2>
            <p class="mt-6 max-w-3xl text-base font-medium leading-7 text-black/72 sm:text-lg sm:leading-8">
              Monarchic keeps the plan, task state, logs, artifacts, and review decisions attached to a run. A person can see what happened without rebuilding it from a chat transcript.
            </p>
          </header>
          <div class="border-t border-white/20 bg-[#0b0d10] lg:border-l lg:border-t-0">
            <article class="border-b border-white/20 p-5 sm:p-7">
              <p class="font-mono text-[0.62rem] font-bold uppercase text-signal">Execution boundary</p>
              <h3 class="mt-3 text-2xl font-black uppercase text-white">Workers own the workspace.</h3>
              <p class="mt-4 text-sm leading-7 text-white/58">Repository checkout, task execution, logs, and artifacts stay scoped to the run.</p>
            </article>
            <article class="p-5 sm:p-7">
              <p class="font-mono text-[0.62rem] font-bold uppercase text-signal">Operator authority</p>
              <h3 class="mt-3 text-2xl font-black uppercase text-white">People own the decision.</h3>
              <p class="mt-4 text-sm leading-7 text-white/58">Review and run-control actions remain outside the model.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="operating-method" aria-labelledby="operating-method-title" class="border-b border-white/20">
        <header class="grid gap-5 p-5 sm:p-7 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-end">
          <div>
            <p class="font-mono text-[0.65rem] font-bold uppercase text-signal">Operating method</p>
            <h2 id="operating-method-title" class="mt-3 text-4xl font-black uppercase leading-[0.92] sm:text-5xl">How a Monarchic run moves.</h2>
          </div>
          <p class="max-w-2xl text-sm leading-7 text-white/64">
            Define the job, plan the tasks, execute in scoped workers, then return the result with its evidence.
          </p>
        </header>
        <ol class="grid gap-px border-t border-white/20 bg-white/20 sm:grid-cols-2 lg:grid-cols-4">
          {workingMethod.map((item) => (
            <li class="home-method-item relative flex min-h-64 flex-col overflow-hidden bg-ink p-5 sm:p-6" data-step={item.number}>
              <span class="font-mono text-xs font-bold text-signal">{item.number}</span>
              <div class="mt-auto pt-10">
                <h3 class="text-2xl font-black uppercase">{item.title}</h3>
                <p class="mt-3 text-sm leading-6 text-white/64">{item.copy}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="current-work" aria-labelledby="current-work-title" class="border-b border-white/20 bg-[#0a0a0a]">
        <header class="grid border-b border-white/20 lg:grid-cols-[minmax(0,1fr)_24rem]">
          <div class="p-5 sm:p-7">
            <p class="font-mono text-[0.65rem] font-bold uppercase text-signal">Available now / Hosted MCP catalog</p>
            <h2 id="current-work-title" class="mt-3 max-w-4xl text-4xl font-black uppercase leading-[0.92] sm:text-5xl">
              {availableMcpCount} hosted MCPs are available.
            </h2>
          </div>
          <div class="border-t border-white/20 p-5 lg:border-l lg:border-t-0 lg:p-7">
            <p class="text-sm leading-7 text-white/68">
              The catalog covers repository intelligence, memory, release management, infrastructure, browser work, and other specialist tasks. The long-running Monarchic workflow product that uses this catalog is still in development.
            </p>
            <div class="mt-6 flex flex-wrap gap-2">
              <a href="/products" class="motion-link inline-flex min-h-11 items-center border border-signal bg-signal px-4 text-xs font-black uppercase text-black hover:bg-signal-soft">Browse hosted MCPs</a>
              <a href={`${appBaseUrl}/products/usage-evaluation`} class="motion-link inline-flex min-h-11 items-center border border-white/40 px-4 text-xs font-black uppercase text-white hover:border-signal hover:text-signal-soft">Start free evaluation</a>
            </div>
          </div>
        </header>

        <div>
          {featuredRoutes.map((route, index) => (
            <a href={route.href} class:list={[
              "interactive-row group grid items-center gap-3 px-5 py-4 hover:bg-signal hover:text-black sm:min-h-28 sm:grid-cols-[minmax(10rem,0.52fr)_minmax(0,1fr)_2rem] sm:gap-5 sm:px-7 sm:py-5",
              index < featuredRoutes.length - 1 && "border-b border-white/20",
            ]}>
              <div>
                <p class="text-xl font-black uppercase">{route.label}</p>
                <p class="mt-1 font-mono text-[0.62rem] font-bold uppercase opacity-62">{route.role}</p>
              </div>
              <p class="max-w-2xl text-sm leading-6 opacity-74">{route.proof}</p>
              <span class="row-arrow hidden text-xl sm:inline" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>

      <section id="public-record" aria-labelledby="public-record-title" class="border-b border-white/20">
        <header class="grid gap-5 border-b border-white/20 p-5 sm:p-7 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-end">
          <div>
            <p class="font-mono text-[0.65rem] font-bold uppercase text-signal">Public record</p>
            <h2 id="public-record-title" class="mt-3 max-w-4xl text-4xl font-black uppercase leading-[0.92] sm:text-5xl">The public record is split on purpose.</h2>
          </div>
          <p class="text-sm leading-7 text-white/64">
            Research is for methods and measured results. Security is for controls in place today. Company is for scope and product status.
          </p>
        </header>
        <div class="grid lg:grid-cols-3">
          {publicRecord.map((item, index) => (
            <article class:list={[
              "group flex min-h-72 flex-col p-5 sm:p-7",
              index < publicRecord.length - 1 && "border-b border-white/20 lg:border-b-0 lg:border-r",
            ]}>
              <p class="font-mono text-[0.62rem] font-bold uppercase text-white/46">{item.label}</p>
              <h3 class="mt-7 text-2xl font-black uppercase">{item.title}</h3>
              <p class="mt-4 text-sm leading-7 text-white/62">{item.copy}</p>
              <a href={item.href} class="motion-link mt-auto inline-flex min-h-11 items-center justify-between border border-white/40 px-4 text-xs font-black uppercase hover:border-signal hover:text-signal-soft">
                {item.action} <span class="motion-arrow" aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

    </PublicPageFrame>
  </body>
</html>
