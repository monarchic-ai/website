---
const siteUrl = (import.meta.env.PUBLIC_MONARCHIC_WEBSITE_BASE_URL ?? "https://monarchic.io").replace(/\/$/, "");
const companyUrl = new URL("/company", `${siteUrl}/`).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <link rel="canonical" href={companyUrl} />
    <meta http-equiv="refresh" content="0;url=/company" />
    <title>Company | Monarchic</title>
  </head>
  <body>
    <p>The Monarchic company page has moved to <a href="/company">/company</a>.</p>
  </body>
</html>
