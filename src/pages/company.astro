---
import PublicPageFrame from "../components/PublicPageFrame.astro";
import SeoHead from "../components/SeoHead.astro";
import { allPlans, hostedMcpStatus } from "../lib/pricing";
import "../styles/global.css";

const appBaseUrl = (import.meta.env.PUBLIC_MONARCHIC_WEBAPP_BASE_URL ?? "https://app.monarchic.io").replace(/\/$/, "");
const publicMcps = allPlans.filter((plan) => plan.kind === "single-mcp");
const availableMcpCount = publicMcps.filter((plan) => hostedMcpStatus(plan) === "available").length;

const approach = [
  ["Research", "Start with a bounded question, an observable workflow, and a definition of what would count as evidence."],
  ["Encode", "Turn the useful parts into explicit tool contracts, permission boundaries, and repeatable operations."],
  ["Verify", "Test outputs against named methods and keep failures, limits, and evidence status beside the result."],
  ["Maintain", "Operate the route, measure usage, and revise the product as the underlying systems change."],
];

const system = [
  ["Research", "Questions, methods, results, and visible limits.", "/research", "Read the record"],
  ["Tooling", "Structured contracts that make specialist work callable by an agent.", `${appBaseUrl}/setup`, "Open setup"],
  ["Products", "Hosted MCP routes, scoped access, and account-level usage.", "/products", "View products"],
];

const evidence = [
  {
    label: "External dataset",
    title: "Recognized benchmarks.",
    copy: "ExplicitMem publishes its fixed dataset, method, measurements, one scored miss, and interpretation boundary together.",
    href: "/research/explicitmem",
    action: "Inspect the benchmark",
  },
  {
    label: "First-party evaluation",
    title: "Our methods stay attributed.",
    copy: "Capability, robustness, corpus, and deterministic-gate evaluations are labeled as Monarchic work and published with their method. They are not presented as independent research.",
    href: "/research",
    action: "Review research records",
  },
  {
    label: "Engineering verification",
    title: "Operational checks stay scoped.",
    copy: "Security checks, automated tests, isolation, persistence, artifact promotion, protocol checks, and production measurements support operational claims—not independent benchmark claims.",
    href: "/security",
    action: "Review engineering trust",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#080808" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title="Company | Monarchic"
      description="Monarchic is a small, long-horizon automation research and development company building evidence-grounded tools and hosted MCP products."
      path="/company"
    />
  </head>
  <body class="min-h-screen bg-ink text-white">
    <PublicPageFrame active="company">

      <section aria-labelledby="company-title" class="border-b border-white/20">
        <div class="min-w-0 px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-24">
          <p class="font-mono text-[0.68rem] font-bold uppercase text-signal">Company / Monarchic, LLC</p>
          <h1 id="company-title" class="mt-4 max-w-5xl text-[2.7rem] font-black uppercase leading-[0.84] min-[360px]:text-[2.9rem] sm:text-7xl lg:text-[5.4rem]">
            Automation is the enduring scope.
          </h1>
          <p class="mt-7 max-w-3xl text-lg font-medium leading-8 text-white/78 sm:text-2xl sm:leading-9">
            Monarchic is a technical research and development company building automation that can be inspected, measured, and operated in the real world.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/products" class="inline-flex min-h-12 items-center justify-center border-2 border-signal bg-signal px-5 text-xs font-black uppercase text-black transition hover:bg-signal-soft">
              Explore products
            </a>
            <a href="/research" class="inline-flex min-h-12 items-center justify-center border-2 border-white/50 px-5 text-xs font-black uppercase transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">
              Read the research
            </a>
          </div>
        </div>

      </section>

      <section aria-labelledby="mission-title" class="grid border-b border-white/20 lg:grid-cols-[22rem_minmax(0,1fr)]">
        <header class="border-b border-white/20 p-5 sm:p-7 lg:border-b-0 lg:border-r">
          <h2 id="mission-title" class="text-4xl font-black uppercase leading-[0.92] sm:text-5xl">Build useful systems. Keep the claims honest.</h2>
        </header>
        <div class="grid sm:grid-cols-2">
          <article class="border-b border-white/20 p-5 sm:border-b-0 sm:border-r sm:p-7">
            <p class="font-mono text-[0.62rem] font-bold uppercase text-white/42">Enduring mission</p>
            <h3 class="mt-5 text-2xl font-black uppercase">Automation with an evidence trail.</h3>
            <p class="mt-4 text-sm leading-7 text-white/64">
              We are interested in systems that reduce repeated work without hiding how they reached an answer. The output should be useful; the boundary should be visible.
            </p>
          </article>
          <article class="p-5 sm:p-7">
            <p class="font-mono text-[0.62rem] font-bold uppercase text-white/42">Present focus</p>
            <h3 class="mt-5 text-2xl font-black uppercase">AI agents and MCP infrastructure.</h3>
            <p class="mt-4 text-sm leading-7 text-white/64">
              Today that means specialist MCP tools for repository context, memory, operations, and analysis. MCP is the current interface, not the limit of the company’s ambition.
            </p>
          </article>
          <article class="border-t border-white/20 p-5 sm:col-span-2 sm:p-7">
            <p class="font-mono text-[0.62rem] font-bold uppercase text-white/42">Who the work is for</p>
            <div class="mt-5 grid gap-px border border-white/20 bg-white/20 sm:grid-cols-2 lg:grid-cols-4">
              <p class="bg-ink p-4 text-sm font-bold uppercase leading-6">Software developers and engineering teams</p>
              <p class="bg-ink p-4 text-sm font-bold uppercase leading-6">Engineering leaders and technical evaluators</p>
              <p class="bg-ink p-4 text-sm font-bold uppercase leading-6">Researchers, scientists, and STEM practitioners</p>
              <p class="bg-ink p-4 text-sm font-bold uppercase leading-6">Business and guided nontechnical operators</p>
            </div>
          </article>
        </div>
      </section>

      <section aria-labelledby="approach-title" class="border-b border-white/20">
        <header class="grid gap-5 border-b border-white/20 p-5 sm:p-7 lg:grid-cols-[1fr_0.72fr] lg:items-end">
          <div>
            <h2 id="approach-title" class="text-4xl font-black uppercase leading-[0.92] sm:text-5xl">Evidence before ornament.</h2>
          </div>
          <p class="max-w-2xl text-sm leading-7 text-white/62">
            Evidence-first systems research, deterministic architecture where possible, explicit heuristics where it is not, and reproducible methods proportionate to the claim.
          </p>
        </header>
        <ol class="grid sm:grid-cols-2 lg:grid-cols-4">
          {approach.map(([title, copy], index) => (
            <li class:list={[
              "flex min-h-64 flex-col border-white/20 p-5 sm:p-6",
              index < approach.length - 1 && "border-b sm:border-b-0 sm:border-r",
              index === 1 && "sm:border-r-0 lg:border-r",
              index === 2 && "sm:border-b-0 sm:border-r",
            ]}>
              <div class="mt-auto">
                <h3 class="text-2xl font-black uppercase">{title}</h3>
                <p class="mt-3 text-sm leading-7 text-white/58">{copy}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="system-title" class="border-b border-black bg-signal text-black">
        <div class="grid lg:grid-cols-[22rem_minmax(0,1fr)]">
          <header class="border-b border-black p-5 sm:p-7 lg:border-b-0 lg:border-r">
            <h2 id="system-title" class="text-4xl font-black uppercase leading-[0.92] sm:text-5xl">One connected system.</h2>
            <p class="mt-5 text-sm leading-7 text-black/66">
              Research sharpens the tool. Operating the tool reveals the next research question.
            </p>
          </header>
          <div class="grid md:grid-cols-3">
            {system.map(([title, copy, href, action], index) => (
              <article class:list={[
                "flex min-h-72 flex-col p-5 sm:p-7",
                index < system.length - 1 && "border-b border-black md:border-b-0 md:border-r",
              ]}>
                <h3 class="text-3xl font-black uppercase">{title}</h3>
                <p class="mt-4 text-sm leading-7 text-black/66">{copy}</p>
                <a href={href} class="mt-auto pt-8 text-xs font-black uppercase underline decoration-2 underline-offset-4 hover:no-underline">{action}</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section aria-labelledby="evidence-title" class="border-b border-white/20">
        <header class="grid gap-5 border-b border-white/20 p-5 sm:p-7 lg:grid-cols-[1fr_0.72fr] lg:items-end">
          <div>
            <h2 id="evidence-title" class="text-4xl font-black uppercase leading-[0.92] sm:text-5xl">Three evidence classes. Clearly labeled.</h2>
          </div>
          <p class="text-sm leading-7 text-white/62">
            A recognized external-dataset benchmark, an attributed first-party evaluation, and production or engineering verification are useful in different ways. We do not collapse them into one kind of proof.
          </p>
        </header>
        <div class="grid lg:grid-cols-3">
          {evidence.map((item, index) => (
            <article class:list={[
              "group flex min-h-[360px] flex-col p-5 sm:p-7",
              index < evidence.length - 1 && "border-b border-white/20 lg:border-b-0 lg:border-r",
            ]}>
              <p class="font-mono text-[0.62rem] font-bold uppercase text-white/50">{item.label}</p>
              <h3 class="mt-8 text-3xl font-black uppercase leading-none">{item.title}</h3>
              <p class="mt-5 text-sm leading-7 text-white/62">{item.copy}</p>
              <a href={item.href} class="mt-auto inline-flex min-h-11 items-center justify-between border border-white/45 px-4 text-xs font-black uppercase transition group-hover:border-signal group-hover:text-signal-soft">
                {item.action} <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="posture-title" class="grid border-b border-white/20 lg:grid-cols-2">
        <article class="border-b border-white/20 p-5 sm:p-7 lg:border-b-0 lg:border-r">
          <h2 id="posture-title" class="text-4xl font-black uppercase leading-[0.92] sm:text-5xl">Small by fact. Long-horizon by choice.</h2>
          <p class="mt-6 max-w-2xl text-sm leading-7 text-white/64">
            Monarchic is a small company. {availableMcpCount} MCPs are available now, with more in development and room for the roadmap to grow. Product, billing, privacy, or security questions go directly to the operator.
          </p>
          <a href="mailto:support@monarchic.io?subject=Company%20question" class="mt-8 inline-flex min-h-11 items-center border border-signal px-4 text-xs font-black uppercase text-signal-soft transition hover:bg-signal hover:text-black">
            Contact Monarchic
          </a>
        </article>
        <article class="p-5 sm:p-7">
          <p class="font-mono text-[0.65rem] font-bold uppercase text-white/42">Long-term direction</p>
          <h2 class="mt-4 text-4xl font-black uppercase leading-[0.92] sm:text-5xl">Beyond any single protocol.</h2>
          <p class="mt-6 max-w-2xl text-sm leading-7 text-white/64">
            We expect interfaces, models, and infrastructure to change. The long-term research direction reaches across engineering, STEM, and business automation. Those are fields of inquiry, not a claim that products exist for each today.
          </p>
          <a href="/security" class="mt-8 inline-flex min-h-11 items-center border border-white/45 px-4 text-xs font-black uppercase transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">
            Review the trust boundary
          </a>
        </article>
      </section>

    </PublicPageFrame>
  </body>
</html>
