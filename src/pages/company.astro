---
import PublicPageFrame from "../components/PublicPageFrame.astro";
import SeoHead from "../components/SeoHead.astro";
import { allPlans, hostedMcpStatus } from "../lib/pricing";
import "../styles/global.css";

const appBaseUrl = (import.meta.env.PUBLIC_MONARCHIC_WEBAPP_BASE_URL ?? "https://app.monarchic.io").replace(/\/$/, "");
const publicMcps = allPlans.filter((plan) => plan.kind === "single-mcp");
const availableMcpCount = publicMcps.filter((plan) => hostedMcpStatus(plan) === "available").length;

const approach = [
  ["Define", "Set the technical problem, operating environment, and failure conditions."],
  ["Build", "Specify the tools, permissions, inputs, outputs, and runtime behavior."],
  ["Test", "Run repeatable cases, fix failures, and record what the system cannot do yet."],
  ["Operate", "Deploy the product, measure how it behaves, and maintain it as models and infrastructure change."],
];

const system = [
  ["Research", "Technical questions, test methods, results, and failures.", "/research", "Read the research"],
  ["Tooling", "Agent capabilities with named inputs, outputs, and permissions.", `${appBaseUrl}/setup`, "Open setup"],
  ["Products", "Hosted MCP connections, account access, and usage records.", "/products", "View products"],
];

const programs = [
  {
    label: "Available now",
    title: "Agent enhancements.",
    copy: `${availableMcpCount} hosted MCPs add repository context, memory, operations, browser work, and analysis to existing agents.`,
    href: "/products/hosted-mcps",
    action: "View agent enhancements",
  },
  {
    label: "Published research",
    title: "Agent memory.",
    copy: "ExplicitMem tests how agents store and retrieve named memory across sessions. The report covers LongMemEval-S, LoCoMo, retrieval policy, and generic-answer behavior.",
    href: "/research/explicitmem",
    action: "Read ExplicitMem research",
  },
  {
    label: "In development",
    title: "Long-running agent work.",
    copy: "The Monarchic webapp is being built to launch jobs, keep task state between model calls, run scoped workers, and return results for review.",
    href: "/products/monarchic-ai",
    action: "View product status",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#080808" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title="Company | Monarchic"
      description="Monarchic is an AI research and development company building tools for AI agents and the infrastructure that keeps their work running."
      path="/company"
    />
  </head>
  <body class="min-h-screen bg-ink text-white">
    <PublicPageFrame>

      <section aria-labelledby="company-title" class="border-b border-white/20">
        <div class="min-w-0 px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-24">
          <p class="font-mono text-[0.68rem] font-bold uppercase text-signal">Company / Monarchic, LLC</p>
          <h1 id="company-title" class="mt-4 max-w-5xl text-[2.7rem] font-black uppercase leading-[0.84] min-[360px]:text-[2.9rem] sm:text-7xl lg:text-[5.4rem]">
            We build AI engineering systems.
          </h1>
          <p class="mt-7 max-w-3xl text-lg font-medium leading-8 text-white/78 sm:text-2xl sm:leading-9">
            Monarchic is an AI research and development company. We build tools for AI agents and the infrastructure that keeps their work running.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/products" class="inline-flex min-h-12 items-center justify-center border-2 border-signal bg-signal px-5 text-xs font-black uppercase text-black transition hover:bg-signal-soft">
              Explore products
            </a>
            <a href="/research" class="inline-flex min-h-12 items-center justify-center border-2 border-white/50 px-5 text-xs font-black uppercase transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">
              Read the research
            </a>
          </div>
        </div>

      </section>

      <section aria-labelledby="mission-title" class="grid border-b border-white/20 lg:grid-cols-[22rem_minmax(0,1fr)]">
        <header class="border-b border-white/20 p-5 sm:p-7 lg:border-b-0 lg:border-r">
          <h2 id="mission-title" class="text-4xl font-black uppercase leading-[0.92] sm:text-5xl">Research that becomes software.</h2>
        </header>
        <div class="grid sm:grid-cols-2">
          <article class="border-b border-white/20 p-5 sm:border-b-0 sm:border-r sm:p-7">
            <p class="font-mono text-[0.62rem] font-bold uppercase text-white/42">Company scope</p>
            <h3 class="mt-5 text-2xl font-black uppercase">AI engineering from tools to runtime.</h3>
            <p class="mt-4 text-sm leading-7 text-white/64">
              We build the software around AI agents: specialist tools, persistent runs, isolated workers, and operator controls.
            </p>
          </article>
          <article class="p-5 sm:p-7">
            <p class="font-mono text-[0.62rem] font-bold uppercase text-white/42">Present focus</p>
            <h3 class="mt-5 text-2xl font-black uppercase">AI agents and MCP infrastructure.</h3>
            <p class="mt-4 text-sm leading-7 text-white/64">
              Today that means hosted MCPs for repository context, memory, operations, browser work, and analysis. Next is a webapp for long-running agent work.
            </p>
          </article>
          <article class="border-t border-white/20 p-5 sm:col-span-2 sm:p-7">
            <p class="font-mono text-[0.62rem] font-bold uppercase text-white/42">Who the work is for</p>
            <div class="mt-5 grid gap-px border border-white/20 bg-white/20 sm:grid-cols-2 lg:grid-cols-4">
              <p class="bg-ink p-4 text-sm font-bold uppercase leading-6">Software developers and engineering teams</p>
              <p class="bg-ink p-4 text-sm font-bold uppercase leading-6">Engineering leaders and technical evaluators</p>
              <p class="bg-ink p-4 text-sm font-bold uppercase leading-6">Researchers, scientists, and STEM practitioners</p>
              <p class="bg-ink p-4 text-sm font-bold uppercase leading-6">Business teams and nontechnical operators</p>
            </div>
          </article>
        </div>
      </section>

      <section aria-labelledby="approach-title" class="border-b border-white/20">
        <header class="grid gap-5 border-b border-white/20 p-5 sm:p-7 lg:grid-cols-[1fr_0.72fr] lg:items-end">
          <div>
            <h2 id="approach-title" class="text-4xl font-black uppercase leading-[0.92] sm:text-5xl">How we build.</h2>
          </div>
          <p class="max-w-2xl text-sm leading-7 text-white/62">
            The work moves from a technical question to a maintained product.
          </p>
        </header>
        <ol class="grid sm:grid-cols-2 lg:grid-cols-4">
          {approach.map(([title, copy], index) => (
            <li class:list={[
              "flex min-h-64 flex-col border-white/20 p-5 sm:p-6",
              index < approach.length - 1 && "border-b sm:border-b-0 sm:border-r",
              index === 1 && "sm:border-r-0 lg:border-r",
              index === 2 && "sm:border-b-0 sm:border-r",
            ]}>
              <div class="mt-auto">
                <h3 class="text-2xl font-black uppercase">{title}</h3>
                <p class="mt-3 text-sm leading-7 text-white/58">{copy}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="system-title" class="border-b border-black bg-signal text-black">
        <div class="grid lg:grid-cols-[22rem_minmax(0,1fr)]">
          <header class="border-b border-black p-5 sm:p-7 lg:border-b-0 lg:border-r">
            <h2 id="system-title" class="text-4xl font-black uppercase leading-[0.92] sm:text-5xl">Research, tooling, products.</h2>
            <p class="mt-5 text-sm leading-7 text-black/66">
              The same work continues from experiment to hosted product.
            </p>
          </header>
          <div class="grid md:grid-cols-3">
            {system.map(([title, copy, href, action], index) => (
              <article class:list={[
                "flex min-h-72 flex-col p-5 sm:p-7",
                index < system.length - 1 && "border-b border-black md:border-b-0 md:border-r",
              ]}>
                <h3 class="text-3xl font-black uppercase">{title}</h3>
                <p class="mt-4 text-sm leading-7 text-black/66">{copy}</p>
                <a href={href} class="mt-auto pt-8 text-xs font-black uppercase underline decoration-2 underline-offset-4 hover:no-underline">{action}</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section aria-labelledby="programs-title" class="border-b border-white/20">
        <header class="grid gap-5 border-b border-white/20 p-5 sm:p-7 lg:grid-cols-[1fr_0.72fr] lg:items-end">
          <div>
            <h2 id="programs-title" class="text-4xl font-black uppercase leading-[0.92] sm:text-5xl">Work underway.</h2>
          </div>
          <p class="text-sm leading-7 text-white/62">
            Hosted MCPs are available now. ExplicitMem has published research. The long-running workflow product is still in development.
          </p>
        </header>
        <div class="grid lg:grid-cols-3">
          {programs.map((item, index) => (
            <article class:list={[
              "group flex min-h-[360px] flex-col p-5 sm:p-7",
              index < programs.length - 1 && "border-b border-white/20 lg:border-b-0 lg:border-r",
            ]}>
              <p class="font-mono text-[0.62rem] font-bold uppercase text-white/50">{item.label}</p>
              <h3 class="mt-8 text-3xl font-black uppercase leading-none">{item.title}</h3>
              <p class="mt-5 text-sm leading-7 text-white/62">{item.copy}</p>
              <a href={item.href} class="mt-auto inline-flex min-h-11 items-center justify-between border border-white/45 px-4 text-xs font-black uppercase transition group-hover:border-signal group-hover:text-signal-soft">
                {item.action} <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section id="contact" aria-labelledby="posture-title" class="scroll-mt-28 grid border-b border-white/20 lg:grid-cols-2">
        <article class="border-b border-white/20 p-5 sm:p-7 lg:border-b-0 lg:border-r">
          <p class="font-mono text-[0.65rem] font-bold uppercase text-signal">Support / Direct contact</p>
          <h2 id="posture-title" class="mt-4 text-4xl font-black uppercase leading-[0.92] sm:text-5xl">Small company. Long horizon.</h2>
          <p class="mt-6 max-w-2xl text-sm leading-7 text-white/64">
            {availableMcpCount} MCPs are available now, and more are in development. Product, billing, privacy, or security questions go directly to the operator.
          </p>
          <a href="mailto:support@monarchic.io?subject=Monarchic%20support" class="mt-8 inline-flex min-h-11 items-center border border-signal px-4 text-xs font-black uppercase text-signal-soft transition hover:bg-signal hover:text-black">
            Email support
          </a>
        </article>
        <article class="p-5 sm:p-7">
          <p class="font-mono text-[0.65rem] font-bold uppercase text-white/42">Long-term direction</p>
          <h2 class="mt-4 text-4xl font-black uppercase leading-[0.92] sm:text-5xl">Beyond MCP.</h2>
          <p class="mt-6 max-w-2xl text-sm leading-7 text-white/64">
            We expect interfaces, models, and infrastructure to change. Our long-term research covers agent systems for software engineering, scientific research, and business operations. Those are fields of inquiry, not a claim that products exist for each today.
          </p>
          <a href="/security" class="mt-8 inline-flex min-h-11 items-center border border-white/45 px-4 text-xs font-black uppercase transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">
            Read security details
          </a>
        </article>
      </section>

    </PublicPageFrame>
  </body>
</html>
