---
import Shader14 from "../../components/Shader14.astro";
import SeoHead from "../../components/SeoHead.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import WaitlistForm from "../../components/WaitlistForm.svelte";
import "../../styles/global.css";
import {
  allPlans,
  cadenceLabel,
  creditAllowanceLabel,
  findPlanPrice,
  formatPriceUSD,
  planStatusLabel,
  resolveDisplayPrice,
  type CatalogPlan,
} from "../../lib/pricing";
import {
  publicCatalogDescription,
  publicCatalogDisplayName,
  publicCatalogTagline,
} from "../../lib/publicCatalogCopy";
import { getProductDetail } from "../../lib/productDetails";

const apiBaseUrl = import.meta.env.PUBLIC_MONARCHIC_API_BASE_URL ?? "https://api.monarchic.io";
const appBaseUrl = (import.meta.env.PUBLIC_MONARCHIC_WEBAPP_BASE_URL ?? "https://app.monarchic.io").replace(/\/$/, "");
const usageOrder = ["usage-evaluation", "usage-individual", "usage-developer", "usage-team", "usage-business"];
const bundleOrder = ["bundle-developer", "bundle-go-to-market", "bundle-startup", "bundle-all-mcps"];
const rank = (order: string[], slug: string) => {
  const index = order.indexOf(slug);
  return index === -1 ? order.length : index;
};

const usagePlans = allPlans
  .filter((plan) => plan.kind === "usage-plan")
  .sort((a, b) => rank(usageOrder, a.slug) - rank(usageOrder, b.slug));
const paidUsagePlans = usagePlans.filter((plan) => plan.slug !== "usage-evaluation");
const evaluationPlan = usagePlans.find((plan) => plan.slug === "usage-evaluation") ?? null;
const mcpRoutes = allPlans
  .filter((plan) => plan.kind === "single-mcp")
  .sort((a, b) => a.displayName.localeCompare(b.displayName));
const workflowPacks = allPlans
  .filter((plan) => plan.kind === "bundle")
  .sort((a, b) => rank(bundleOrder, a.slug) - rank(bundleOrder, b.slug));
const monarchicAi = allPlans.find((plan) => plan.slug === "monarchic-ai") ?? null;
const comingSoon = allPlans.filter(
  (plan) =>
    plan.status !== "available" &&
    plan.kind !== "usage-plan" &&
    plan.kind !== "single-mcp" &&
    plan.kind !== "bundle" &&
    plan.slug !== "monarchic-ai",
);

const researchByPlanSlug: Record<string, string> = {
  "mcp-browserops": "/research/browserops",
  "mcp-explicitmem": "/research/explicitmem",
  "mcp-repointel": "/research/repointel",
};

const displayName = (plan: CatalogPlan) => publicCatalogDisplayName(plan.slug, plan.displayName);
const description = (plan: CatalogPlan) => publicCatalogDescription(plan.description);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      title="Products | Monarchic"
      description="Monarchic hosted MCP routes, usage tiers, workflow packs, and gated launch access."
      path="/products"
    />
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="relative min-h-screen overflow-hidden">
      <Shader14 className="pointer-events-none fixed inset-0 h-full w-full opacity-70" />
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_bottom,_rgba(0,0,0,0.68),_rgba(0,0,0,0.94))]"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-10">
        <SiteHeader active="products" />

        <section id="catalog-intro" class="py-12 text-center sm:py-16">
          <p class="text-xs font-semibold uppercase tracking-[0.36em] text-white/64">Products</p>
          <h1 class="mx-auto mt-5 max-w-5xl text-4xl font-extrabold uppercase leading-[0.9] sm:text-6xl lg:text-7xl [text-shadow:5px_5px_0_rgba(255,255,255,0.12)]">
            Hosted MCP Routes
          </h1>
          <p class="mx-auto mt-7 max-w-3xl text-base leading-8 text-white/78 sm:text-lg">
            Hosted capabilities included through usage-plan credits.
          </p>
          <p class="mx-auto mt-2 max-w-3xl text-base leading-8 text-white/78 sm:text-lg">
            Choose monthly or annual capacity for your workload.
          </p>
          <p class="mx-auto mt-4 max-w-3xl text-xs font-bold uppercase tracking-[0.24em] text-white/54">
            Synchronized Pricing, Account Checkout
          </p>
          <a href="#usage-tiers" class="mt-8 inline-flex items-center justify-center border-2 border-cyan-300 bg-cyan-300/10 px-6 py-3 text-xs font-bold uppercase tracking-[0.22em] text-cyan-100 transition hover:bg-cyan-300/20 hover:text-white">
            Compare Plans
          </a>
        </section>

        <section id="catalog-summary" aria-label="Catalog summary" class="mb-10 grid border-2 border-white bg-black/70 sm:grid-cols-2 lg:grid-cols-4">
          <div class="border-b border-white/36 p-5 sm:border-r lg:border-b-0">
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-white/52">Evaluation</p>
            <p class="mt-3 text-2xl font-extrabold uppercase">{evaluationPlan ? creditAllowanceLabel(evaluationPlan) : "Preview"}</p>
          </div>
          <div class="border-b border-white/36 p-5 lg:border-b-0 lg:border-r">
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-white/52">Paid plans</p>
            <p class="mt-3 text-2xl font-extrabold uppercase">{paidUsagePlans.length}</p>
          </div>
          <div class="border-b border-white/36 p-5 sm:border-b-0 sm:border-r">
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-white/52">MCP routes</p>
            <p class="mt-3 text-2xl font-extrabold uppercase">{mcpRoutes.length}</p>
          </div>
          <div class="p-5">
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-white/52">Checkout</p>
            <p class="mt-3 text-2xl font-extrabold uppercase">Account required</p>
            <p class="mt-2 text-sm leading-6 text-white/66">Available plans continue in the secure Monarchic web app.</p>
          </div>
        </section>

        <section id="platform-status" class="mb-10 grid gap-6 border-2 border-amber-300 bg-black/78 p-5 sm:p-6 lg:grid-cols-[1.5fr_0.8fr]">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.28em] text-amber-200">Future platform</p>
            <h2 class="mt-4 text-3xl font-extrabold uppercase sm:text-5xl">
              {monarchicAi ? displayName(monarchicAi) : "Monarchic AI"}
            </h2>
            <p class="mt-4 max-w-3xl text-sm leading-7 text-white/76">
              {monarchicAi ? description(monarchicAi) : "The larger Monarchic platform follows the hosted MCP launch."}
            </p>
            <p class="mt-3 max-w-3xl text-sm leading-7 text-amber-100/80">The current launch focus is hosted MCP access.</p>
          </div>
          {monarchicAi && (
            <div class="flex items-center">
              <a href={`/products/${monarchicAi.slug}`} class="inline-flex w-full items-center justify-center border-2 border-white/50 px-5 py-3 text-xs font-semibold uppercase tracking-[0.22em] transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-100">View status</a>
            </div>
          )}
        </section>

        <nav id="catalog-navigation" aria-label="Product catalog" class="mb-12 flex flex-wrap gap-2 border-y border-white/40 py-4">
          <span class="mr-2 self-center text-[0.65rem] font-bold uppercase tracking-[0.24em] text-white/46">Products /</span>
          <a href="#usage-tiers" class="border border-white/56 px-3 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-white/72 hover:border-white hover:text-white">Usage tiers</a>
          <a href="#mcp-routes" class="border border-white/56 px-3 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-white/72 hover:border-white hover:text-white">MCP routes</a>
          <a href="#workflow-packs" class="border border-white/56 px-3 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-white/72 hover:border-white hover:text-white">Workflow packs</a>
          <a href="#coming-soon" class="border border-white/56 px-3 py-2 text-xs font-semibold uppercase tracking-[0.18em] text-white/72 hover:border-white hover:text-white">Coming soon</a>
        </nav>

        <section id="usage-tiers" class="mb-16 scroll-mt-8">
          <div class="mb-6 max-w-3xl">
            <p class="text-xs font-bold uppercase tracking-[0.34em] text-cyan-200">01 / Usage tiers</p>
            <h2 class="mt-3 text-3xl font-extrabold uppercase sm:text-4xl">Usage capacity</h2>
            <p class="mt-4 text-sm leading-7 text-white/70">Usage tiers are the current public paid products.</p>
            <p class="text-sm leading-7 text-white/70">Available plans continue to account checkout; preview prices cannot be purchased yet.</p>
          </div>
          <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {usagePlans.map((plan) => {
              const displayPrice = resolveDisplayPrice(plan, "monthly");
              const monthlyPrice = findPlanPrice(plan, "monthly");
              const annualPrice = findPlanPrice(plan, "annual");
              const isPurchasable = plan.status === "available" && Boolean(monthlyPrice?.priceId || annualPrice?.priceId);
              return (
                <article data-plan-card={plan.slug} class={`flex min-h-[320px] flex-col border-2 bg-black/74 p-5 ${plan.highlighted ? "border-cyan-300" : "border-white"}`}>
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="text-[0.65rem] font-bold uppercase tracking-[0.22em] text-white/58">Usage tier</span>
                    <span class="border border-white/60 px-2 py-1 text-[0.62rem] font-bold uppercase tracking-[0.16em]">{planStatusLabel(plan.status)}</span>
                  </div>
                  <h3 class="mt-5 text-2xl font-extrabold uppercase">{displayName(plan)}</h3>
                  <p class="mt-2 text-sm leading-6 text-white/66">{publicCatalogTagline(plan.slug, plan.tagline)}</p>
                  {displayPrice?.price.priceCents != null && (
                    <div class="mt-6">
                      <p class="text-3xl font-extrabold">
                        {formatPriceUSD(displayPrice.price.priceCents)}
                        <span class="ml-1 text-sm text-white/52">{cadenceLabel(displayPrice.cadence)}</span>
                      </p>
                      {annualPrice?.priceCents != null && (
                        <p class="mt-2 text-xs font-bold uppercase text-white/58">
                          Annual {formatPriceUSD(annualPrice.priceCents)}{cadenceLabel("annual")}
                        </p>
                      )}
                    </div>
                  )}
                  <p class="mt-3 text-xs font-bold uppercase tracking-[0.18em] text-cyan-200">{creditAllowanceLabel(plan)}</p>
                  <div class="flex-1"></div>
                  <div class="mt-6 grid gap-2">
                    {isPurchasable && (
                      <a href={`${appBaseUrl}/products/${plan.slug}`} class="inline-flex items-center justify-center border-2 border-cyan-300 bg-cyan-300/10 px-3 py-3 text-xs font-bold uppercase text-cyan-100 transition hover:bg-cyan-300/20 hover:text-white">Choose plan</a>
                    )}
                    <a href={`/products/${plan.slug}`} class="inline-flex items-center justify-center border border-white/50 px-3 py-3 text-xs font-bold uppercase transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-100">Details</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        <section id="mcp-routes" class="mb-16 scroll-mt-8">
          <p class="text-xs font-bold uppercase tracking-[0.34em] text-emerald-200">02 / Hosted catalog</p>
          <h2 class="mt-3 text-3xl font-extrabold uppercase sm:text-4xl">Hosted MCP Routes</h2>
          <div class="mt-6 border-t-2 border-white">
            {mcpRoutes.map((plan) => (
              <article data-plan-card={plan.slug} class="grid gap-4 border-b border-white/44 bg-black/58 p-4 sm:p-5 lg:grid-cols-[1fr_2fr_auto] lg:items-center">
                <div>
                  <p class="text-[0.62rem] font-bold uppercase tracking-[0.2em] text-emerald-200">{getProductDetail(plan.slug)?.category ?? "Hosted MCP"} · {planStatusLabel(plan.status)}</p>
                  <h3 class="mt-2 text-xl font-extrabold uppercase">{displayName(plan)}</h3>
                </div>
                <p class="text-sm leading-6 text-white/70">{description(plan)}</p>
                <div class="flex flex-wrap gap-2 lg:justify-end">
                  <a href={`/products/${plan.slug}`} class="border border-white/50 px-3 py-2 text-xs font-bold uppercase tracking-[0.16em] transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-100">Details</a>
                  {researchByPlanSlug[plan.slug] && (
                    <a href={researchByPlanSlug[plan.slug]} class="border border-white/50 px-3 py-2 text-xs font-bold uppercase tracking-[0.16em] transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-100">Research</a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="workflow-packs" class="mb-16 scroll-mt-8">
          <p class="text-xs font-bold uppercase tracking-[0.34em] text-cyan-200">03 / Workflow packs</p>
          <h2 class="mt-3 text-3xl font-extrabold uppercase sm:text-4xl">Related route bundles</h2>
          <div class="mt-6 grid gap-5 md:grid-cols-2">
            {workflowPacks.map((plan) => (
              <article class="flex flex-col border-2 border-white bg-black/74 p-5">
                <p class="text-[0.62rem] font-bold uppercase tracking-[0.2em] text-cyan-200">Workflow pack · {planStatusLabel(plan.status)}</p>
                <h3 class="mt-4 text-2xl font-extrabold uppercase">{displayName(plan)}</h3>
                <p class="mt-3 text-sm leading-7 text-white/70">{description(plan)}</p>
                <a href={`/products/${plan.slug}`} class="mt-6 inline-flex w-fit border border-white/50 px-3 py-3 text-xs font-bold uppercase tracking-[0.18em] transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-100">Details</a>
              </article>
            ))}
          </div>
        </section>

        <section id="coming-soon" class="mb-16 scroll-mt-8">
          <p class="text-xs font-bold uppercase tracking-[0.34em] text-amber-200">04 / Coming soon</p>
          <h2 class="mt-3 text-3xl font-extrabold uppercase sm:text-4xl">Future products</h2>
          <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {comingSoon.map((plan) => (
              <article class="border border-white/50 bg-black/58 p-5">
                <p class="text-[0.62rem] font-bold uppercase tracking-[0.2em] text-amber-200">Coming soon</p>
                <h3 class="mt-4 text-xl font-extrabold uppercase">{displayName(plan)}</h3>
                <p class="mt-3 text-sm leading-6 text-white/66">{description(plan)}</p>
                <a href={`/products/${plan.slug}`} class="mt-5 inline-flex border border-white/50 px-3 py-2 text-xs font-bold uppercase tracking-[0.16em] transition hover:border-cyan-300 hover:bg-cyan-300/10 hover:text-cyan-100">View status</a>
              </article>
            ))}
          </div>
        </section>

        <section id="waitlist" class="grid scroll-mt-8 gap-6 border-t-2 border-white py-10 lg:grid-cols-[0.9fr_1.1fr]">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-white/54">Access</p>
            <h2 class="mt-3 max-w-2xl text-3xl font-extrabold uppercase leading-tight sm:text-4xl">Tell us which hosted routes you need.</h2>
            <p class="mt-4 max-w-2xl text-sm leading-7 text-white/70">Join the waitlist for route availability and account onboarding updates.</p>
          </div>
          <div class="border-2 border-white bg-black p-5 sm:p-6">
            <WaitlistForm client:load apiBaseUrl={apiBaseUrl} slug="monarchic-ai" submitLabel="Join Waitlist" />
          </div>
        </section>

        <SiteFooter />
      </div>
    </main>
  </body>
</html>
