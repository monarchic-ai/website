---
import PublicPageFrame from "../../components/PublicPageFrame.astro";
import SeoHead from "../../components/SeoHead.astro";
import { allPlans, hostedMcpStatus } from "../../lib/pricing";
import "../../styles/global.css";

const mcpProducts = allPlans.filter((plan) => plan.kind === "single-mcp");
const availableMcpCount = mcpProducts.filter((plan) => hostedMcpStatus(plan) === "available").length;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title="Products | Monarchic"
      description="Explore Monarchic AI agent enhancements, the systems behind them, and the next product line in development."
      path="/products"
    />
  </head>
  <body class="min-h-screen bg-ink text-white">
    <PublicPageFrame active="products">
      <section class="page-hero grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end">
        <div>
          <p class="font-mono text-[0.65rem] font-bold uppercase text-signal">Product index / Monarchic</p>
          <h1 class="mt-4 max-w-4xl text-[3.5rem] font-black uppercase leading-[0.84] sm:text-7xl lg:text-[6.5rem]">
            Products.
          </h1>
          <p class="mt-6 max-w-3xl text-base font-medium leading-7 text-white/72 sm:text-xl sm:leading-8">
            Monarchic builds specialist capabilities for AI agents and the systems they run on. Our first product line is available through hosted MCP connections.
          </p>
        </div>
        <dl class="grid grid-cols-2 border border-white/30 bg-black/40 font-mono uppercase lg:grid-cols-1">
          <div class="border-r border-white/20 p-4 lg:border-b lg:border-r-0">
            <dt class="text-[0.56rem] font-bold text-white/54">Available product</dt>
            <dd class="mt-2 text-sm font-black text-white">01</dd>
          </div>
          <div class="p-4">
            <dt class="text-[0.56rem] font-bold text-white/54">Enhancements</dt>
            <dd class="mt-2 text-sm font-black text-signal">{availableMcpCount} available</dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="product-lines-title" class="border-b border-white/20">
        <header class="grid gap-4 border-b border-white/20 px-4 py-6 sm:px-6 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end lg:px-8">
          <div>
            <p class="font-mono text-[0.62rem] font-bold uppercase text-signal">Monarchic products</p>
            <h2 id="product-lines-title" class="mt-3 text-3xl font-black uppercase sm:text-4xl">Current product work.</h2>
          </div>
          <p class="text-sm leading-6 text-white/60">One product line is available now. The next remains unannounced.</p>
        </header>

        <div class="grid gap-px bg-white/20 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,0.65fr)]">
          <article class="relative isolate flex min-h-[30rem] flex-col overflow-hidden bg-[#080b0f] p-5 sm:p-7 lg:min-h-[34rem] lg:p-8" data-product-overview-card="ai-agent-enhancements">
            <svg class="absolute inset-0 z-0 h-full w-full text-signal opacity-20" viewBox="0 0 100 100" preserveAspectRatio="none" shape-rendering="crispEdges" aria-hidden="true">
              <path d="M48 8H62V18H78V11H96M55 32H72V43H90V34H100M44 61H60V51H76V70H92V60H100M52 84H68V76H84V90H100" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke"></path>
              <path d="M49 8H50M61 18H63M71 43H73M59 51H61M83 90H85" fill="none" stroke="currentColor" stroke-width="3" vector-effect="non-scaling-stroke"></path>
            </svg>
            <div class="relative z-10 flex flex-wrap items-center justify-between gap-3 font-mono text-[0.62rem] font-bold uppercase">
              <span class="text-white/54">Product 01 / Agent capabilities</span>
              <span class="border border-signal bg-signal px-2 py-1 text-black">Available now</span>
            </div>
            <div class="relative z-10 mt-auto max-w-3xl pt-20">
              <h3 class="max-w-3xl text-4xl font-black uppercase leading-[0.9] sm:text-6xl">AI Agent Enhancements</h3>
              <p class="mt-5 max-w-2xl text-base leading-7 text-white/70 sm:text-lg sm:leading-8">
                Give AI agents specialist capabilities for repository work, memory, browser testing, release operations, infrastructure, and business operations. Each enhancement runs through a hosted MCP connection.
              </p>
              <div class="mt-7 grid max-w-2xl gap-px border border-white/24 bg-white/20 sm:grid-cols-2">
                <div class="bg-[#080b0f]/95 p-4">
                  <p class="font-mono text-[0.56rem] font-bold uppercase text-white/54">Enhancements</p>
                  <p class="mt-2 text-sm font-black uppercase">{availableMcpCount} available</p>
                </div>
                <div class="bg-[#080b0f]/95 p-4">
                  <p class="font-mono text-[0.56rem] font-bold uppercase text-white/54">Delivery</p>
                  <p class="mt-2 text-sm font-black uppercase">Hosted MCPs</p>
                </div>
              </div>
              <a href="/products/hosted-mcps" data-hosted-mcp-catalog-link class="motion-link mt-7 inline-flex min-h-12 items-center justify-between gap-8 border border-signal bg-signal px-5 text-xs font-black uppercase text-black hover:bg-signal-soft">
                Explore {availableMcpCount} enhancements <span class="motion-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>

          <article class="relative isolate flex min-h-[24rem] flex-col overflow-hidden bg-[#070707] p-5 sm:p-7 lg:min-h-[34rem] lg:p-8" data-product-overview-card="coming-soon">
            <svg class="absolute inset-0 z-0 h-full w-full text-white opacity-[0.07]" viewBox="0 0 100 100" preserveAspectRatio="none" shape-rendering="crispEdges" aria-hidden="true">
              <path d="M12 12H88V88H12ZM22 22H42V42H22ZM58 58H78V78H58Z" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 4" vector-effect="non-scaling-stroke"></path>
            </svg>
            <div class="relative z-10 flex flex-wrap items-center justify-between gap-3 font-mono text-[0.62rem] font-bold uppercase">
              <span class="text-white/54">Product 02 / Unannounced</span>
              <span class="border border-white/36 px-2 py-1 text-white/58">No public brief</span>
            </div>
            <div class="relative z-10 mt-auto pt-20">
              <p class="font-mono text-[0.58rem] font-bold uppercase text-white/50">Status / Pending</p>
              <h3 class="mt-3 text-4xl font-black uppercase leading-[0.9] text-white/72 sm:text-5xl">Coming soon.</h3>
              <p class="mt-5 max-w-md text-sm leading-7 text-white/58">
                The next Monarchic product has not been announced. Its brief stays private until the work is concrete.
              </p>
            </div>
          </article>
        </div>
      </section>
    </PublicPageFrame>
  </body>
</html>
