---
import Shader14 from "../../components/Shader14.astro";
import ProductCatalogCard from "../../components/ProductCatalogCard.astro";
import SeoHead from "../../components/SeoHead.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import "../../styles/global.css";
import {
  allPlans,
  cadenceLabel,
  creditAllowanceLabel,
  findPlanPrice,
  formatPriceUSD,
  planStatusLabel,
  resolveDisplayPrice,
  type CatalogPlan,
} from "../../lib/pricing";

const appBaseUrl = (import.meta.env.PUBLIC_MONARCHIC_WEBAPP_BASE_URL ?? "https://app.monarchic.io").replace(/\/$/, "");
const usageOrder = ["usage-evaluation", "usage-individual", "usage-developer", "usage-team", "usage-business"];
const rank = (order: string[], slug: string) => {
  const index = order.indexOf(slug);
  return index === -1 ? order.length : index;
};

const usagePlans = allPlans
  .filter((plan) => plan.kind === "usage-plan")
  .sort((a, b) => rank(usageOrder, a.slug) - rank(usageOrder, b.slug));

const mcpProducts = allPlans
  .filter((plan) => plan.kind === "single-mcp")
  .sort((a, b) => {
    const availabilityOrder = (plan: CatalogPlan) => plan.status === "available" ? 0 : 1;
    return availabilityOrder(a) - availabilityOrder(b) || a.displayName.localeCompare(b.displayName);
  });

const availableMcpProducts = mcpProducts.filter((plan) => plan.status === "available");
const wipMcpProducts = mcpProducts.filter((plan) => plan.status !== "available");
const availableMcpCount = availableMcpProducts.length;
const wipMcpCount = wipMcpProducts.length;

const researchByPlanSlug: Record<string, string> = {
  "mcp-explicitmem": "/research/explicitmem",
};

function statusClasses(plan: CatalogPlan): string {
  if (plan.status === "available") return "border-signal bg-signal text-black";
  if (plan.status === "contact_sales") return "border-white/70 text-white";
  return "border-white/35 text-white/58";
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title="Products | Monarchic"
      description="Compare Monarchic credit plans and the complete catalog of available and work-in-progress MCPs."
      path="/products"
    />
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="relative min-h-screen overflow-hidden">
      <Shader14 className="pointer-events-none fixed inset-0 h-full w-full opacity-70" />
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_bottom,_rgba(0,0,0,0.68),_rgba(0,0,0,0.95))]"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-10">
        <SiteHeader active="products" />

        <section class="py-14 text-center sm:py-20">
          <p class="text-xs font-semibold uppercase text-signal">Products</p>
          <h1 class="mx-auto mt-5 max-w-5xl text-4xl font-extrabold uppercase leading-[0.9] sm:text-6xl lg:text-7xl [text-shadow:5px_5px_0_rgba(255,255,255,0.12)]">
            Plans and MCPs
          </h1>
          <p class="mx-auto mt-7 max-w-3xl text-base leading-8 text-white/78 sm:text-lg">
            Choose a monthly or annual plan. Its shared credit allowance works
            across every MCP marked Available.
          </p>
          <div class="mt-8 flex flex-col justify-center gap-3 min-[440px]:flex-row">
            <a href="#plans" class="inline-flex min-h-12 items-center justify-center border-2 border-signal bg-signal px-6 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">
              Compare plans
            </a>
            <a href="#mcp-catalog" class="inline-flex min-h-12 items-center justify-center border-2 border-white/50 px-6 text-xs font-bold uppercase text-white transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">
              Browse all MCPs
            </a>
          </div>
        </section>

        <section aria-label="Catalog summary" class="mb-12 grid border-2 border-white bg-black/70 sm:grid-cols-2 lg:grid-cols-4">
          <div class="border-b border-white/36 p-5 sm:border-r lg:border-b-0">
            <p class="text-xs font-bold uppercase text-white/52">Plans</p>
            <p class="mt-3 text-3xl font-extrabold">{usagePlans.length}</p>
            <p class="mt-2 text-sm text-white/62">Evaluation through business</p>
          </div>
          <div class="border-b border-white/36 p-5 lg:border-b-0 lg:border-r">
            <p class="text-xs font-bold uppercase text-white/52">MCP catalog</p>
            <p class="mt-3 text-3xl font-extrabold">{mcpProducts.length}</p>
            <p class="mt-2 text-sm text-white/62">Every current public product</p>
          </div>
          <div class="border-b border-white/36 p-5 sm:border-b-0 sm:border-r">
            <p class="text-xs font-bold uppercase text-white/52">Available now</p>
            <p class="mt-3 text-3xl font-extrabold">{availableMcpCount}</p>
            <p class="mt-2 text-sm text-white/62">Ready to use with an active plan</p>
          </div>
          <div class="p-5">
            <p class="text-xs font-bold uppercase text-white/52">In progress</p>
            <p class="mt-3 text-3xl font-extrabold">{wipMcpCount}</p>
            <p class="mt-2 text-sm text-white/62">Listed for visibility and marked WIP</p>
          </div>
        </section>

        <nav aria-label="Product sections" class="mb-14 flex flex-wrap gap-2 border-y border-white/40 py-4">
          <span class="mr-2 self-center text-[0.65rem] font-bold uppercase text-white/46">Jump to /</span>
          <a href="#plans" class="border border-white/50 px-3 py-2 text-xs font-semibold uppercase text-white/72 transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">Plans</a>
          <a href="#mcp-catalog" class="border border-white/50 px-3 py-2 text-xs font-semibold uppercase text-white/72 transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">Available MCPs</a>
          <a href="#how-credits-work" class="border border-white/50 px-3 py-2 text-xs font-semibold uppercase text-white/72 transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">Credits</a>
        </nav>

        <section id="plans" class="mb-20 scroll-mt-8">
          <p class="text-xs font-bold uppercase text-signal">01 / Plans</p>
          <h2 class="mt-3 text-3xl font-extrabold uppercase sm:text-4xl">Shared usage capacity</h2>
          <p class="mt-4 max-w-3xl text-sm leading-7 text-white/70">
            Each plan includes an account-level credit allowance. Available MCPs
            draw from that shared allowance. Paid plans are prepaid, have no
            overage, and stop hosted calls when the allowance is empty.
          </p>
          <div class="mt-7 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {usagePlans.map((plan) => {
              const displayPrice = resolveDisplayPrice(plan, "monthly");
              const monthlyPrice = findPlanPrice(plan, "monthly");
              const annualPrice = findPlanPrice(plan, "annual");
              const isPurchasable = plan.status === "available" && Boolean(monthlyPrice?.priceId || annualPrice?.priceId);
              const isEvaluation = plan.slug === "usage-evaluation";
              return (
                <article
                  data-plan-card={plan.slug}
                  class={`flex min-h-[330px] flex-col border-2 bg-black/74 p-5 transition duration-200 hover:-translate-y-1 hover:border-signal hover:bg-signal/[0.06] focus-within:-translate-y-1 focus-within:border-signal ${plan.highlighted ? "border-signal" : "border-white/70"}`}
                >
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <span class="text-[0.65rem] font-bold uppercase text-white/58">Credit plan</span>
                    <span class={`border px-2 py-1 text-[0.62rem] font-bold uppercase ${statusClasses(plan)}`}>{planStatusLabel(plan.status)}</span>
                  </div>
                  <h3 class="mt-5 text-2xl font-extrabold uppercase">{plan.displayName}</h3>
                  <p class="mt-2 text-sm leading-6 text-white/66">{plan.tagline}</p>
                  {displayPrice?.price.priceCents != null && (
                    <div class="mt-6">
                      <p class="text-3xl font-extrabold">
                        {formatPriceUSD(displayPrice.price.priceCents)}
                        <span class="ml-1 text-sm text-white/52">{cadenceLabel(displayPrice.cadence)}</span>
                      </p>
                      {annualPrice?.priceCents != null && (
                        <p class="mt-2 text-xs font-bold uppercase text-white/58">
                          Annual {formatPriceUSD(annualPrice.priceCents)}{cadenceLabel("annual")} · two months included
                        </p>
                      )}
                    </div>
                  )}
                  {creditAllowanceLabel(plan) && (
                    <p class="mt-4 border-l-2 border-signal pl-3 text-xs font-bold uppercase text-signal-soft">
                      {creditAllowanceLabel(plan)}
                    </p>
                  )}
                  {!isEvaluation && (
                    <p class="mt-3 text-[0.65rem] font-bold uppercase text-white/48">
                      Prepaid · no overage
                    </p>
                  )}
                  <div class="flex-1"></div>
                  <div class="mt-7 grid gap-2">
                    {isEvaluation ? (
                      <a href={`${appBaseUrl}/products/${plan.slug}`} class="inline-flex min-h-11 items-center justify-center border-2 border-signal bg-signal px-3 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">Claim 200 credits</a>
                    ) : isPurchasable ? (
                      <a href={`${appBaseUrl}/products/${plan.slug}`} class="inline-flex min-h-11 items-center justify-center border-2 border-signal bg-signal px-3 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">Choose plan</a>
                    ) : plan.status === "contact_sales" && plan.salesContactUrl ? (
                      <a href={plan.salesContactUrl} class="inline-flex min-h-11 items-center justify-center border-2 border-signal bg-signal px-3 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">Contact sales</a>
                    ) : (
                      <a href="/waitlist" class="inline-flex min-h-11 items-center justify-center border-2 border-signal/80 px-3 text-xs font-bold uppercase text-signal-soft transition hover:bg-signal/10 hover:text-white">Join waitlist</a>
                    )}
                    <a href={`/products/${plan.slug}`} class="inline-flex min-h-11 items-center justify-center border border-white/50 px-3 text-xs font-bold uppercase transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">Plan details</a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        <section id="mcp-catalog" class="mb-20 scroll-mt-8">
          <p class="text-xs font-bold uppercase text-signal">02 / MCP catalog</p>
          <h2 class="mt-3 text-3xl font-extrabold uppercase sm:text-4xl">Available MCPs</h2>
          <p class="mt-4 max-w-3xl text-sm leading-7 text-white/70">
            These five products are ready for public use with one shared credit
            plan. Open a product to inspect a real tool call, its evidence, and
            the default credit cost.
          </p>
          <div class="mt-7 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {availableMcpProducts.map((plan) => (
              <ProductCatalogCard plan={plan} researchHref={researchByPlanSlug[plan.slug]} />
            ))}
          </div>

          <details data-coming-next class="group mt-10 border-2 border-white/55 bg-black/72">
            <summary class="flex min-h-20 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 transition hover:bg-signal hover:text-black focus-visible:bg-signal focus-visible:text-black [&::-webkit-details-marker]:hidden">
              <span>
                <span class="block text-[0.65rem] font-bold uppercase opacity-56">Roadmap</span>
                <span class="mt-1 block text-lg font-extrabold uppercase">Coming next / {wipMcpCount} MCPs</span>
              </span>
              <span aria-hidden="true" class="text-3xl font-light leading-none transition-transform group-open:rotate-45">+</span>
            </summary>
            <div class="border-t border-white/35 p-4 sm:p-5">
              <p class="max-w-3xl text-sm leading-7 text-white/62">
                These products are visible for roadmap context but are not open
                for checkout. Expand only when you want to inspect what is in progress.
              </p>
              <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                {wipMcpProducts.map((plan) => (
                  <ProductCatalogCard plan={plan} researchHref={researchByPlanSlug[plan.slug]} />
                ))}
              </div>
            </div>
          </details>
        </section>

        <section id="how-credits-work" class="mb-20 scroll-mt-8 border-2 border-white bg-black/76 p-6 lg:p-8">
          <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
            <div>
              <p class="text-xs font-bold uppercase text-signal">03 / Credits</p>
              <h2 class="mt-3 text-3xl font-extrabold uppercase">One allowance, four clear weights</h2>
              <p class="mt-4 max-w-2xl text-sm leading-7 text-white/72">
                Credits track the kind of work a tool call performs. The same
                weights apply across available MCPs, so a plan is comparable
                before you buy it and usage stays readable afterward.
              </p>
            </div>
            <div class="grid gap-3 text-sm leading-6 text-white/72">
              <div class="border border-white/36 bg-black/60 p-4"><strong class="block uppercase text-white">Shared</strong><span class="mt-2 block">Use one plan across every MCP currently marked Available.</span></div>
              <div class="border border-white/36 bg-black/60 p-4"><strong class="block uppercase text-white">Visible</strong><span class="mt-2 block">Review usage and credit impact from your account.</span></div>
              <div class="border border-white/36 bg-black/60 p-4"><strong class="block uppercase text-white">Controlled</strong><span class="mt-2 block">Paid plans are prepaid and hard-capped; hosted calls pause at the credit limit.</span></div>
            </div>
          </div>
          <div class="mt-8 grid border-t border-white/36 sm:grid-cols-2 lg:grid-cols-4">
            <div class="border-b border-white/36 p-4 sm:border-r lg:border-b-0">
              <p class="font-mono text-3xl font-extrabold text-signal">0</p>
              <p class="mt-3 text-xs font-bold uppercase text-white">Metadata</p>
              <p class="mt-2 text-sm leading-6 text-white/58">Status, health, schema, and similar discovery calls.</p>
            </div>
            <div class="border-b border-white/36 p-4 lg:border-b-0 lg:border-r">
              <p class="font-mono text-3xl font-extrabold text-signal">1</p>
              <p class="mt-3 text-xs font-bold uppercase text-white">Standard</p>
              <p class="mt-2 text-sm leading-6 text-white/58">Normal hosted tool calls without heavier analysis or providers.</p>
            </div>
            <div class="border-b border-white/36 p-4 sm:border-b-0 sm:border-r">
              <p class="font-mono text-3xl font-extrabold text-signal">3</p>
              <p class="mt-3 text-xs font-bold uppercase text-white">Stateful analysis</p>
              <p class="mt-2 text-sm leading-6 text-white/58">Analysis, indexing, search, synthesis, and related work.</p>
            </div>
            <div class="p-4">
              <p class="font-mono text-3xl font-extrabold text-signal">10</p>
              <p class="mt-3 text-xs font-bold uppercase text-white">Provider-backed</p>
              <p class="mt-2 text-sm leading-6 text-white/58">Browser, terminal, and external-provider work by default.</p>
            </div>
          </div>
          <div class="mt-8 border border-signal/70 bg-signal/[0.06] p-5 sm:p-6">
            <p class="text-[0.65rem] font-bold uppercase text-signal">Individual plan / 1,000 credits</p>
            <div class="mt-5 grid gap-5 sm:grid-cols-3">
              <div>
                <p class="font-mono text-2xl font-extrabold">1,000</p>
                <p class="mt-2 text-sm leading-6 text-white/62">standard one-credit calls</p>
              </div>
              <div>
                <p class="font-mono text-2xl font-extrabold">≈333</p>
                <p class="mt-2 text-sm leading-6 text-white/62">stateful analysis, indexing, or memory calls at three credits</p>
              </div>
              <div>
                <p class="font-mono text-2xl font-extrabold">100</p>
                <p class="mt-2 text-sm leading-6 text-white/62">provider-backed calls at the default ten-credit weight</p>
              </div>
            </div>
            <p class="mt-5 text-xs leading-6 text-white/48">
              These are single-call equivalents. A workflow that invokes several tools uses the sum of their receipts.
            </p>
          </div>
        </section>

        <section class="mb-16 grid gap-6 border-t-2 border-white py-10 sm:grid-cols-[1fr_auto] sm:items-center">
          <div>
            <p class="text-xs font-bold uppercase text-white/54">Set up a client</p>
            <h2 class="mt-3 text-3xl font-extrabold uppercase">From account to first tool call</h2>
            <p class="mt-3 max-w-2xl text-sm leading-7 text-white/70">The webapp docs cover access, API keys, client setup, verification, and troubleshooting.</p>
          </div>
          <a href={`${appBaseUrl}/docs`} class="inline-flex min-h-12 items-center justify-center border-2 border-signal bg-signal px-6 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">Open docs</a>
        </section>

        <SiteFooter />
      </div>
    </main>
  </body>
</html>
