---
import Shader14 from "../../components/Shader14.astro";
import SeoHead from "../../components/SeoHead.astro";
import "../../styles/global.css";
import {
  allPlans,
  availablePlans,
  type CatalogPlan,
  type PlanKind,
} from "../../lib/pricing";
import { publicPilotDescription, publicPilotFeatureBullet } from "../../lib/publicPilotCopy";
import { getProductDetail } from "../../lib/productDetails";

export function getStaticPaths() {
  return allPlans.map((plan) => ({ params: { slug: plan.slug } }));
}

const webappBaseUrl = import.meta.env.PUBLIC_MONARCHIC_WEBAPP_BASE_URL ?? "https://app.monarchic.io";
const { slug } = Astro.params;
const plan = allPlans.find((candidate) => candidate.slug === slug);
if (!plan) {
  return Astro.redirect("/products");
}

const isComingSoon = plan.status === "coming_soon";

const bundlesIncluding = plan.kind === "single-mcp"
  ? availablePlans
      .filter(
        (candidate) =>
          candidate.kind === "bundle" &&
          candidate.status === "available" &&
          Array.isArray(candidate.includedMcpSlugs) &&
          candidate.includedMcpSlugs.includes(plan.slug),
      )
      .sort((a, b) => a.displayName.localeCompare(b.displayName))
  : [];

const bundleMcps = plan.kind === "bundle" && Array.isArray(plan.includedMcpSlugs)
  ? plan.includedMcpSlugs
      .map((includedSlug) => allPlans.find((candidate) => candidate.slug === includedSlug))
      .filter((candidate): candidate is CatalogPlan => candidate !== undefined)
  : [];

const researchByPlanSlug: Record<string, { href: string; label: string; summary: string }> = {
  "mcp-explicitmem": {
    href: "/research/explicitmem",
    label: "ExplicitMem Research",
    summary: "Benchmark notes for memory accuracy, retrieval quality, and published comparison context.",
  },
  "mcp-repointel": {
    href: "/research/repointel",
    label: "RepoIntel Research",
    summary: "Repository intelligence benchmarks across localization, explanation, planning, generation, and review.",
  },
  "mcp-browserops": {
    href: "/research/browserops",
    label: "BrowserOps Reliability Notes",
    summary: "Browser verification reliability checks for MCP calls, CLI scenarios, receipts, screenshots, console errors, and network failures.",
  },
};

const planResearch = researchByPlanSlug[plan.slug] ?? null;
const bundleResearch = plan.kind === "bundle"
  ? bundleMcps
      .map((mcp) => ({ mcp, research: researchByPlanSlug[mcp.slug] ?? null }))
      .filter((entry): entry is { mcp: CatalogPlan; research: NonNullable<typeof entry.research> } => entry.research !== null)
  : [];

function kindBadge(kind: PlanKind): { label: string; classes: string } {
  switch (kind) {
    case "single-mcp":
      return { label: "Single MCP", classes: "border-emerald-300 text-emerald-200" };
    case "bundle":
      return { label: "Bundle", classes: "border-cyan-300 text-cyan-200" };
    case "ai":
    default:
      return { label: "AI System", classes: "border-amber-300 text-amber-200" };
  }
}

function appPlanUrl(target: CatalogPlan): string {
  return `${webappBaseUrl.replace(/\/$/, "")}/products/${target.slug}`;
}

const badge = kindBadge(plan.kind);
const productDetail = getProductDetail(plan.slug);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SeoHead
      title={`${plan.displayName} | Monarchic AI`}
      description={`${plan.displayName}: ${plan.tagline}. ${publicPilotDescription(plan.description)}`}
      path={`/products/${plan.slug}`}
    />
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="relative min-h-screen overflow-hidden">
      <Shader14 className="pointer-events-none fixed inset-0 h-full w-full opacity-70" />
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_bottom,_rgba(0,0,0,0.68),_rgba(0,0,0,0.94))]"></div>

      <section class="relative z-10 mx-auto max-w-6xl px-6 py-8 sm:py-12">
        <header class="flex flex-wrap items-center justify-between gap-5 border-b-2 border-white pb-6">
          <a href="/" class="inline-flex items-center gap-3">
            <img src="/favicon.svg" alt="Monarchic AI logo" class="h-9 w-9 bg-white object-cover p-1" width="36" height="36" />
            <span class="text-[0.7rem] font-semibold uppercase tracking-[0.36em] text-white/72">Monarchic AI</span>
          </a>
          <nav class="flex flex-wrap items-center gap-2">
            <a href="/research" class="border-2 border-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] transition hover:bg-white hover:text-black">Research</a>
            <a href="/products" class="border-2 border-white bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-black">Products</a>
          </nav>
        </header>

        <p class="mt-10 text-xs font-semibold uppercase tracking-[0.32em] text-white/54">
          <a href="/products" class="hover:text-white">Products</a> / {plan.displayName}
        </p>

        <section class="mt-6 grid gap-8 lg:grid-cols-[1fr_340px]">
          <div>
            <span class={`inline-flex border px-3 py-1 text-[0.65rem] font-bold uppercase tracking-[0.28em] ${badge.classes}`}>
              {badge.label}
            </span>
            <h1 class="mt-5 max-w-4xl text-4xl font-extrabold uppercase leading-[0.9] sm:text-6xl lg:text-7xl [text-shadow:5px_5px_0_rgba(255,255,255,0.12)]">
              {plan.displayName}
            </h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-white/80">{plan.tagline}</p>
            <p class="mt-5 max-w-3xl text-base leading-8 text-white/72">{publicPilotDescription(plan.description)}</p>

            {productDetail !== null && (
              <section class="mt-8 grid gap-3 sm:grid-cols-3">
                <div class="border border-white/40 bg-black/54 p-4">
                  <p class="text-[0.65rem] font-bold uppercase tracking-[0.24em] text-white/48">Category</p>
                  <p class="mt-2 text-sm font-bold uppercase leading-5">{productDetail.category}</p>
                </div>
                <div class="border border-white/40 bg-black/54 p-4">
                  <p class="text-[0.65rem] font-bold uppercase tracking-[0.24em] text-white/48">Self-Hosted Range</p>
                  <p class="mt-2 text-sm font-bold uppercase leading-5">{productDetail.vpsPrice}</p>
                </div>
                <div class="border border-white/40 bg-black/54 p-4">
                  <p class="text-[0.65rem] font-bold uppercase tracking-[0.24em] text-white/48">Buyer</p>
                  <p class="mt-2 text-sm leading-6 text-white/74">{productDetail.buyer}</p>
                </div>
              </section>
            )}

            <section class="mt-8 grid gap-3 border-2 border-white bg-black/64 p-5 md:grid-cols-3">
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.24em] text-white/50">Pilot Step</p>
                <p class="mt-3 text-sm leading-6 text-white/72">Request access in the app so scope, tenant, and route access can be set up together.</p>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.24em] text-white/50">Evidence Step</p>
                <p class="mt-3 text-sm leading-6 text-white/72">Review the proof boundary before treating this product as production infrastructure.</p>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.24em] text-white/50">Account Step</p>
                <p class="mt-3 text-sm leading-6 text-white/72">Use the app for API keys, hosted MCP config, billing, and account-level controls.</p>
              </div>
            </section>

            {planResearch !== null && (
              <section class="mt-10 border-2 border-white bg-black/68 p-5">
                <p class="text-xs font-bold uppercase tracking-[0.36em] text-white/54">Evidence</p>
                <h2 class="mt-3 text-2xl font-extrabold uppercase">{planResearch.label}</h2>
                <p class="mt-3 max-w-2xl text-sm leading-7 text-white/72">{planResearch.summary}</p>
                <a href={planResearch.href} class="mt-5 inline-flex items-center justify-center border border-white px-4 py-3 text-xs font-bold uppercase tracking-[0.22em] transition hover:bg-white hover:text-black">
                  Open Research
                </a>
              </section>
            )}

            {plan.featureBullets.length > 0 && (
              <section class="mt-10">
                <h2 class="text-xs font-bold uppercase tracking-[0.36em] text-white/54">What You Get</h2>
                <ul class="mt-4 grid gap-3 text-sm leading-7 text-white/74 sm:grid-cols-2">
                  {plan.featureBullets.map((bullet) => (
                    <li class="flex gap-3 border border-white/36 bg-black/54 p-4">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-white"></span>
                      <span>{publicPilotFeatureBullet(bullet)}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {productDetail !== null && (
              <section class="mt-10 grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
                <div>
                  <h2 class="text-xs font-bold uppercase tracking-[0.36em] text-white/54">Core Use Case</h2>
                  <p class="mt-4 text-base leading-8 text-white/76">{productDetail.useCase}</p>
                  <div class="mt-6 border border-white/36 bg-black/54 p-4">
                    <p class="text-xs font-bold uppercase tracking-[0.28em] text-white/50">Proof Boundary</p>
                    <p class="mt-3 text-sm leading-7 text-white/72">{productDetail.proof}</p>
                  </div>
                </div>
                <div>
                  <h2 class="text-xs font-bold uppercase tracking-[0.36em] text-white/54">Outcomes</h2>
                  <ul class="mt-4 grid gap-3 text-sm leading-7 text-white/74">
                    {productDetail.outcomes.map((outcome) => (
                      <li class="flex gap-3 border border-white/30 bg-black/50 p-4">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-white"></span>
                        <span>{outcome}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="lg:col-span-2">
                  <h2 class="text-xs font-bold uppercase tracking-[0.36em] text-white/54">Primary Workflows</h2>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {productDetail.workflows.map((workflow) => (
                      <span class="border border-white/40 bg-black/54 px-3 py-2 text-xs font-bold uppercase tracking-[0.18em] text-white/70">
                        {workflow}
                      </span>
                    ))}
                  </div>
                </div>
              </section>
            )}

            {plan.kind === "single-mcp" && bundlesIncluding.length > 0 && (
              <section class="mt-10">
                <h2 class="text-xs font-bold uppercase tracking-[0.36em] text-white/54">Available In Bundles</h2>
                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                  {bundlesIncluding.map((bundle) => {
                    return (
                      <a href={`/products/${bundle.slug}`} class="group border border-white/50 bg-black/60 p-4 transition hover:bg-white hover:text-black">
                        <p class="text-sm font-extrabold uppercase">{bundle.displayName}</p>
                        <p class="mt-2 text-xs uppercase tracking-[0.18em] text-white/56 group-hover:text-black/56">
                          Custom pilot pricing
                        </p>
                      </a>
                    );
                  })}
                </div>
              </section>
            )}

            {plan.kind === "bundle" && bundleMcps.length > 0 && (
              <section class="mt-10">
                <h2 class="text-xs font-bold uppercase tracking-[0.36em] text-white/54">Included MCPs</h2>
                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                  {bundleMcps.map((mcp) => (
                    <a href={`/products/${mcp.slug}`} class="group border border-white/50 bg-black/60 p-4 transition hover:bg-white hover:text-black">
                      <p class="text-sm font-extrabold uppercase">{mcp.displayName}</p>
                      <p class="mt-2 text-xs leading-5 text-white/60 group-hover:text-black/60">{mcp.tagline}</p>
                    </a>
                  ))}
                </div>
              </section>
            )}

            {bundleResearch.length > 0 && (
              <section class="mt-10">
                <h2 class="text-xs font-bold uppercase tracking-[0.36em] text-white/54">Research Links</h2>
                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                  {bundleResearch.map(({ mcp, research }) => (
                    <a href={research.href} class="group border border-white/50 bg-black/60 p-4 transition hover:bg-white hover:text-black">
                      <p class="text-sm font-extrabold uppercase">{research.label}</p>
                      <p class="mt-2 text-xs leading-5 text-white/60 group-hover:text-black/60">{mcp.displayName}</p>
                    </a>
                  ))}
                </div>
              </section>
            )}
          </div>

          <aside class="h-fit border-2 border-white bg-black/74 p-5">
            <p class="text-xs font-bold uppercase tracking-[0.28em] text-white/54">Pricing</p>
            {isComingSoon ? (
              <>
                <p class="mt-4 text-sm font-bold uppercase tracking-[0.2em] text-amber-200">Pricing TBD</p>
                <p class="mt-4 text-sm leading-6 text-white/66">Join the app waitlist for this product.</p>
              </>
            ) : (
              <>
                <p class="mt-4 text-2xl font-extrabold uppercase leading-tight">
                  Custom Pilot Pricing
                </p>
                <p class="mt-4 text-sm leading-6 text-white/66">
                  Pricing is quoted during the pilot phase after deployment
                  shape, storage needs, evaluation scope, and support coverage
                  are known.
                </p>
              </>
            )}
            <div class="mt-6 grid gap-3">
              <a href={appPlanUrl(plan)} class="inline-flex items-center justify-center border-2 border-white bg-white px-4 py-3 text-xs font-bold uppercase tracking-[0.22em] text-black transition hover:bg-black hover:text-white">
                {isComingSoon ? "Join Waitlist" : "Request Pilot"}
              </a>
              <a href="/products" class="inline-flex items-center justify-center border border-white px-4 py-3 text-xs font-bold uppercase tracking-[0.22em] transition hover:bg-white hover:text-black">
                Compare Plans
              </a>
            </div>
          </aside>
        </section>
      </section>
    </main>
  </body>
</html>
