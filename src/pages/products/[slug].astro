---
import Shader14 from "../../components/Shader14.astro";
import SeoHead from "../../components/SeoHead.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import "../../styles/global.css";
import {
  allPlans,
  cadenceLabel,
  catalogStatusLabel,
  creditAllowanceLabel,
  findPlanPrice,
  formatPriceUSD,
  planStatusLabel,
  resolveDisplayPrice,
  type CatalogPlan,
  type PlanKind,
} from "../../lib/pricing";
import { getProductDetail } from "../../lib/productDetails";

export function getStaticPaths() {
  return allPlans.map((plan) => ({ params: { slug: plan.slug } }));
}

const { slug } = Astro.params;
const plan = allPlans.find((candidate) => candidate.slug === slug);
if (!plan) {
  return Astro.redirect("/products");
}

const appBaseUrl = (import.meta.env.PUBLIC_MONARCHIC_WEBAPP_BASE_URL ?? "https://app.monarchic.io").replace(/\/$/, "");
const productDetail = getProductDetail(plan.slug);
const displayPrice = resolveDisplayPrice(plan, "monthly");
const monthlyPrice = findPlanPrice(plan, "monthly");
const annualPrice = findPlanPrice(plan, "annual");
const isPurchasable = plan.kind === "usage-plan" && plan.status === "available" && Boolean(monthlyPrice?.priceId || annualPrice?.priceId);
const isEvaluation = plan.slug === "usage-evaluation";

const researchByPlanSlug: Record<string, { href: string; label: string; summary: string }> = {
  "mcp-explicitmem": {
    href: "/research/explicitmem",
    label: "LongMemEval-S benchmark",
    summary: "Method, results, retrieval coverage, latency, and limitations from the latest 500-question run.",
  },
};
const planResearch = researchByPlanSlug[plan.slug] ?? null;

function kindBadge(kind: PlanKind): string {
  if (kind === "usage-plan") return "Credit plan";
  if (kind === "single-mcp") return "MCP";
  return "Product";
}

function statusLabel(plan: CatalogPlan): string {
  return plan.kind === "single-mcp" ? catalogStatusLabel(plan) : planStatusLabel(plan.status);
}

function statusClasses(plan: CatalogPlan): string {
  if (plan.status === "available") return "border-signal bg-signal text-black";
  if (plan.status === "contact_sales") return "border-white/70 text-white";
  return "border-white/35 text-white/58";
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title={`${plan.displayName} | Monarchic`}
      description={`${plan.displayName}: ${plan.tagline}. ${plan.description}`}
      path={`/products/${plan.slug}`}
    />
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="relative min-h-screen overflow-hidden">
      <Shader14 className="pointer-events-none fixed inset-0 h-full w-full opacity-70" />
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_bottom,_rgba(0,0,0,0.68),_rgba(0,0,0,0.95))]"></div>

      <div class="relative z-10 mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-10">
        <SiteHeader active="products" />

        <p class="mt-10 text-xs font-semibold uppercase text-white/54">
          <a href="/products" class="transition hover:text-signal-soft">Products</a> / {plan.displayName}
        </p>

        <section class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,1fr)_340px]">
          <div class="min-w-0">
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex border border-white/60 px-3 py-1 text-[0.65rem] font-bold uppercase text-white">
                {kindBadge(plan.kind)}
              </span>
              <span class={`inline-flex border px-3 py-1 text-[0.65rem] font-bold uppercase ${statusClasses(plan)}`}>
                {statusLabel(plan)}
              </span>
            </div>
            <h1 class="mt-5 max-w-4xl break-words text-4xl font-extrabold uppercase leading-[0.9] sm:text-6xl lg:text-7xl [text-shadow:5px_5px_0_rgba(255,255,255,0.12)]">
              {plan.displayName}
            </h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-white/80">{plan.tagline}</p>
            <p class="mt-5 max-w-3xl text-base leading-8 text-white/72">{plan.description}</p>

            {productDetail !== null && (
              <section class="mt-8 grid gap-3 sm:grid-cols-2">
                <div class="border border-white/36 bg-black/60 p-4 transition hover:border-signal">
                  <p class="text-[0.65rem] font-bold uppercase text-white/48">Category</p>
                  <p class="mt-2 text-sm font-bold uppercase leading-5">{productDetail.category}</p>
                </div>
                <div class="border border-white/36 bg-black/60 p-4 transition hover:border-signal">
                  <p class="text-[0.65rem] font-bold uppercase text-white/48">Best for</p>
                  <p class="mt-2 text-sm leading-6 text-white/74">{productDetail.buyer}</p>
                </div>
              </section>
            )}

            {plan.kind === "usage-plan" && (
              <section class="mt-10 border-2 border-white bg-black/68 p-5">
                <p class="text-xs font-bold uppercase text-signal">Credit allowance</p>
                <div class="mt-4 grid gap-3 sm:grid-cols-3">
                  {creditAllowanceLabel(plan) !== null && (
                    <div class="border border-white/36 bg-black/54 p-4">
                      <p class="text-[0.65rem] font-bold uppercase text-white/48">Included</p>
                      <p class="mt-2 text-sm font-extrabold uppercase">{creditAllowanceLabel(plan)}</p>
                    </div>
                  )}
                  {plan.overageLabel && (
                    <div class="border border-white/36 bg-black/54 p-4">
                      <p class="text-[0.65rem] font-bold uppercase text-white/48">After allowance</p>
                      <p class="mt-2 text-sm font-extrabold uppercase">{plan.overageLabel}</p>
                    </div>
                  )}
                  <div class="border border-white/36 bg-black/54 p-4">
                    <p class="text-[0.65rem] font-bold uppercase text-white/48">Coverage</p>
                    <p class="mt-2 text-sm font-extrabold uppercase">Every available MCP</p>
                  </div>
                </div>
                {plan.usageSummary && <p class="mt-4 text-sm leading-7 text-white/72">{plan.usageSummary}</p>}
              </section>
            )}

            {plan.kind === "single-mcp" && (
              <section class="mt-10 border-2 border-white bg-black/68 p-5">
                <p class="text-xs font-bold uppercase text-signal">Access and credits</p>
                <h2 class="mt-3 text-2xl font-extrabold uppercase">
                  {plan.status === "available" ? "Included with an active credit plan" : "Public access is WIP"}
                </h2>
                <p class="mt-3 max-w-2xl text-sm leading-7 text-white/72">
                  {plan.usageSummary ?? "This MCP uses the shared credit allowance on the account plan."}
                </p>
              </section>
            )}

            {plan.featureBullets.length > 0 && (
              <section class="mt-10">
                <h2 class="text-xs font-bold uppercase text-white/54">What you get</h2>
                <ul class="mt-4 grid gap-3 text-sm leading-7 text-white/74 sm:grid-cols-2">
                  {plan.featureBullets.map((bullet) => (
                    <li class="flex gap-3 border border-white/30 bg-black/54 p-4 transition hover:border-signal hover:bg-signal/[0.06]">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-signal"></span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {productDetail !== null && (
              <section class="mt-10">
                <h2 class="text-xs font-bold uppercase text-white/54">Core use case</h2>
                <p class="mt-4 max-w-3xl text-base leading-8 text-white/76">{productDetail.useCase}</p>

                <h2 class="mt-10 text-xs font-bold uppercase text-white/54">Outcomes</h2>
                <ul class="mt-4 grid gap-3 text-sm leading-7 text-white/74 sm:grid-cols-2">
                  {productDetail.outcomes.map((outcome) => (
                    <li class="flex gap-3 border border-white/30 bg-black/50 p-4 transition hover:border-signal hover:bg-signal/[0.06]">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-signal"></span>
                      <span>{outcome}</span>
                    </li>
                  ))}
                </ul>

                <h2 class="mt-10 text-xs font-bold uppercase text-white/54">Primary workflows</h2>
                <div class="mt-4 flex flex-wrap gap-2">
                  {productDetail.workflows.map((workflow) => (
                    <span class="border border-white/40 bg-black/54 px-3 py-2 text-xs font-bold uppercase text-white/70">
                      {workflow}
                    </span>
                  ))}
                </div>
              </section>
            )}

            {planResearch !== null && (
              <section class="mt-10 border-2 border-signal/70 bg-black/68 p-5">
                <p class="text-xs font-bold uppercase text-signal">Benchmark</p>
                <h2 class="mt-3 text-2xl font-extrabold uppercase">{planResearch.label}</h2>
                <p class="mt-3 max-w-2xl text-sm leading-7 text-white/72">{planResearch.summary}</p>
                <a href={planResearch.href} class="mt-5 inline-flex min-h-11 items-center justify-center border border-signal px-4 text-xs font-bold uppercase text-signal-soft transition hover:bg-signal/10 hover:text-white">
                  Read benchmark
                </a>
              </section>
            )}
          </div>

          <aside id="waitlist" class="h-fit scroll-mt-6 border-2 border-white bg-black/78 p-5 lg:sticky lg:top-6">
            {isEvaluation ? (
              <>
                <p class="text-xs font-bold uppercase text-signal">Start Evaluation</p>
                <p class="mt-4 text-2xl font-extrabold uppercase">200 one-time credits</p>
                <p class="mt-4 text-sm leading-6 text-white/66">Sign in with a verified email in the Monarchic webapp. No card, automatic billing, overage, or rollover.</p>
                <a href={`${appBaseUrl}/products/${plan.slug}`} class="mt-6 inline-flex min-h-12 w-full items-center justify-center border-2 border-signal bg-signal px-4 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">
                  Claim 200 credits
                </a>
              </>
            ) : isPurchasable ? (
              <>
                <p class="text-xs font-bold uppercase text-white/54">Plan price</p>
                {displayPrice?.price.priceCents != null && (
                  <p class="mt-4 text-3xl font-extrabold uppercase">
                    {formatPriceUSD(displayPrice.price.priceCents)}
                    <span class="ml-1 text-sm font-bold text-white/54">{cadenceLabel(displayPrice.cadence)}</span>
                  </p>
                )}
                {annualPrice?.priceCents != null && (
                  <p class="mt-2 text-xs font-bold uppercase text-white/58">
                    Annual {formatPriceUSD(annualPrice.priceCents)}{cadenceLabel("annual")}
                  </p>
                )}
                <p class="mt-4 text-sm leading-6 text-white/66">Choose monthly or annual billing in the Monarchic webapp.</p>
                <a href={`${appBaseUrl}/products/${plan.slug}`} class="mt-6 inline-flex min-h-12 w-full items-center justify-center border-2 border-signal bg-signal px-4 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">
                  Choose plan
                </a>
              </>
            ) : plan.status === "contact_sales" && plan.salesContactUrl ? (
              <>
                <p class="text-xs font-bold uppercase text-white/54">Business plan</p>
                <p class="mt-4 text-2xl font-extrabold uppercase">Contact sales</p>
                <p class="mt-4 text-sm leading-6 text-white/66">Capacity, support, and service terms are based on the expected workload.</p>
                <a href={plan.salesContactUrl} class="mt-6 inline-flex min-h-12 w-full items-center justify-center border-2 border-signal bg-signal px-4 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">
                  Contact sales
                </a>
              </>
            ) : plan.kind === "single-mcp" && plan.status === "available" ? (
              <>
                <p class="text-xs font-bold uppercase text-signal">Available</p>
                <p class="mt-4 text-2xl font-extrabold uppercase">Use it with a credit plan</p>
                <p class="mt-4 text-sm leading-6 text-white/66">Calls draw from the included credits on your active plan.</p>
                <a href="/products#plans" class="mt-6 inline-flex min-h-12 w-full items-center justify-center border-2 border-signal bg-signal px-4 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">
                  Compare plans
                </a>
              </>
            ) : (
              <>
                <p class="text-xs font-bold uppercase text-signal">{statusLabel(plan)}</p>
                <p class="mt-4 text-2xl font-extrabold uppercase">Not available for checkout</p>
                <p class="mt-4 text-sm leading-6 text-white/66">Join the waitlist for an update when public access opens.</p>
                <a href={`/waitlist?product=${encodeURIComponent(plan.slug)}`} class="mt-6 inline-flex min-h-12 w-full items-center justify-center border-2 border-signal/80 px-4 text-xs font-bold uppercase text-signal-soft transition hover:bg-signal/10 hover:text-white">
                  Join waitlist
                </a>
              </>
            )}
            <a href="/products" class="mt-3 inline-flex min-h-11 w-full items-center justify-center border border-white/50 px-4 text-xs font-bold uppercase text-white transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">
              View all products
            </a>
          </aside>
        </section>

        <div class="mt-16">
          <SiteFooter />
        </div>
      </div>
    </main>
  </body>
</html>
