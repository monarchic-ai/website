---
import ProductWorkflowProof from "../../components/ProductWorkflowProof.astro";
import PublicPageFrame from "../../components/PublicPageFrame.astro";
import SeoHead from "../../components/SeoHead.astro";
import "../../styles/global.css";
import {
  allPlans,
  cadenceLabel,
  catalogStatusLabel,
  usageAllowanceLabel,
  findPlanPrice,
  formatPriceUSD,
  hostedMcpStatus,
  planStatusLabel,
  resolveDisplayPrice,
  type CatalogPlan,
  type PlanKind,
} from "../../lib/pricing";
import { getProductDetail } from "../../lib/productDetails";
import { getMcpResearchByProductSlug } from "../../lib/mcpResearch";
import { webappBaseUrl } from "../../lib/publicUrls";
import {
  getProductWorkflowProof,
  productWorkflowProofs,
} from "../../lib/productWorkflowProofs";

const availableMcpSlugs = allPlans
  .filter((candidate) => candidate.kind === "single-mcp" && candidate.status === "available")
  .map((candidate) => candidate.slug)
  .sort();
const workflowProofSlugs = Object.keys(productWorkflowProofs).sort();
if (JSON.stringify(workflowProofSlugs) !== JSON.stringify(availableMcpSlugs)) {
  throw new Error(
    `Available MCP workflow proofs do not match the public catalog: expected ${availableMcpSlugs.join(", ")}, got ${workflowProofSlugs.join(", ")}`,
  );
}

export function getStaticPaths() {
  return allPlans.map((plan) => ({ params: { slug: plan.slug } }));
}

const { slug } = Astro.params;
const plan = allPlans.find((candidate) => candidate.slug === slug);
if (!plan) {
  return Astro.redirect("/products");
}

const productDetail = getProductDetail(plan.slug);
const workflowProof = getProductWorkflowProof(plan.slug);
const displayPrice = resolveDisplayPrice(plan, "monthly");
const monthlyPrice = findPlanPrice(plan, "monthly");
const annualPrice = findPlanPrice(plan, "annual");
const isPurchasable = plan.kind === "usage-plan" && plan.status === "available" && Boolean(monthlyPrice?.priceId || annualPrice?.priceId);
const isEvaluation = plan.slug === "usage-evaluation";
const mcpHostedStatus = plan.kind === "single-mcp" ? hostedMcpStatus(plan) : null;
const isHostedCatalogEntry = plan.kind === "usage-plan" || plan.kind === "single-mcp";

const planResearch = getMcpResearchByProductSlug(plan.slug);

const connectionSummary = mcpHostedStatus === "available"
  ? "Connect from an MCP-aware client with an account-scoped Monarchic key. The hosted route checks access, runs the named product contract, and records the operation on the account receipt."
  : mcpHostedStatus === "in_rollout"
    ? "The client contract and hosted runtime are being qualified outside production. Public credentials and production endpoints are not issued for this MCP yet."
    : "The intended MCP contract is documented for evaluation, but no public hosted endpoint is available yet.";

const productBoundary = workflowProof?.boundary
  ?? (mcpHostedStatus === "in_rollout"
    ? "A non-production deployment does not establish production readiness. Tenant isolation, cost attribution, and release gates remain open."
    : "The page describes planned product scope. Tool availability, runtime behavior, and performance should not be inferred before the production gate passes.");

function kindBadge(kind: PlanKind): string {
  if (kind === "usage-plan") return "Usage plan";
  if (kind === "single-mcp") return "MCP";
  return "Product";
}

function statusLabel(plan: CatalogPlan): string {
  if (plan.kind !== "single-mcp") return planStatusLabel(plan.status);
  return hostedMcpStatus(plan) === "planned" ? "Coming soon" : catalogStatusLabel(plan);
}

function statusClasses(plan: CatalogPlan): string {
  if (plan.kind === "single-mcp" && hostedMcpStatus(plan) === "in_rollout") {
    return "border-signal/80 bg-signal/10 text-signal-soft";
  }
  if (plan.status === "available") return "border-signal bg-signal text-black";
  if (plan.status === "contact_sales") return "border-white/70 text-white";
  return "border-white/35 text-white/58";
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title={`${plan.displayName} | Monarchic`}
      description={`${plan.displayName}: ${plan.tagline}. ${plan.description}`}
      path={`/products/${plan.slug}`}
    />
  </head>
  <body class="min-h-screen bg-ink text-white">
    <PublicPageFrame active="products">

        <p class="page-bar py-4 text-xs font-semibold uppercase text-white/54">
          <a href="/products" class="transition hover:text-signal-soft">Products</a>
          {isHostedCatalogEntry && <> / <a href="/products/hosted-mcps" class="transition hover:text-signal-soft">Hosted MCPs</a></>}
          / {plan.displayName}
        </p>

        <section class="page-section grid gap-8 lg:grid-cols-[minmax(0,1fr)_340px]">
          <div class="min-w-0">
            <div class="flex flex-wrap gap-2">
              <span class="inline-flex border border-white/60 px-3 py-1 text-[0.65rem] font-bold uppercase text-white">
                {kindBadge(plan.kind)}
              </span>
              <span class={`inline-flex border px-3 py-1 text-[0.65rem] font-bold uppercase ${statusClasses(plan)}`}>
                {statusLabel(plan)}
              </span>
            </div>
            <h1 class="mt-5 max-w-4xl break-words text-4xl font-extrabold uppercase leading-[0.9] sm:text-6xl lg:text-7xl">
              {plan.displayName}
            </h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-white/80">{plan.tagline}</p>
            <p class="mt-5 max-w-3xl text-base leading-8 text-white/72">{plan.description}</p>

            {productDetail !== null && (
              <section class="mt-8 grid gap-3 sm:grid-cols-2">
                <div class="border border-white/36 bg-black/60 p-4">
                  <p class="text-[0.65rem] font-bold uppercase text-white/48">Category</p>
                  <p class="mt-2 text-sm font-bold uppercase leading-5">{productDetail.category}</p>
                </div>
                <div class="border border-white/36 bg-black/60 p-4">
                  <p class="text-[0.65rem] font-bold uppercase text-white/48">Best for</p>
                  <p class="mt-2 text-sm leading-6 text-white/74">{productDetail.buyer}</p>
                </div>
              </section>
            )}

            {plan.kind === "usage-plan" && (
              <section class="mt-10 border-2 border-white bg-black/68 p-5">
                <p class="text-xs font-bold uppercase text-signal">Included usage</p>
                <div class="mt-4 grid gap-3 sm:grid-cols-3">
                  {usageAllowanceLabel(plan) !== null && (
                    <div class="border border-white/36 bg-black/54 p-4">
                      <p class="text-[0.65rem] font-bold uppercase text-white/48">Included</p>
                      <p class="mt-2 text-sm font-extrabold uppercase">{usageAllowanceLabel(plan)}</p>
                    </div>
                  )}
                  {plan.overageLabel && (
                    <div class="border border-white/36 bg-black/54 p-4">
                      <p class="text-[0.65rem] font-bold uppercase text-white/48">After allowance</p>
                      <p class="mt-2 text-sm font-extrabold uppercase">{plan.overageLabel}</p>
                    </div>
                  )}
                  <div class="border border-white/36 bg-black/54 p-4">
                    <p class="text-[0.65rem] font-bold uppercase text-white/48">Coverage</p>
                    <p class="mt-2 text-sm font-extrabold uppercase">Every available MCP</p>
                  </div>
                </div>
                {plan.usageSummary && <p class="mt-4 text-sm leading-7 text-white/72">{plan.usageSummary}</p>}
              </section>
            )}

            {plan.kind === "single-mcp" && (
              <section class="mt-10 border-2 border-white bg-black/68 p-5">
                <p class="text-xs font-bold uppercase text-signal">Access and usage</p>
                <h2 class="mt-3 text-2xl font-extrabold uppercase">
                  {mcpHostedStatus === "available"
                    ? "Included with an active usage plan"
                    : mcpHostedStatus === "in_rollout"
                      ? "Hosted rollout in progress"
                      : "Hosted access coming soon"}
                </h2>
                <p class="mt-3 max-w-2xl text-sm leading-7 text-white/72">
                  {plan.usageSummary ?? "This MCP uses the shared weekly execution allowance on the account plan."}
                </p>
                {plan.status === "available" && (
                  <a href="/products/hosted-mcps#plans" class="mt-5 inline-flex min-h-11 items-center justify-center border border-signal px-4 text-xs font-bold uppercase text-signal-soft transition hover:bg-signal/10 hover:text-white lg:hidden">
                    Compare usage plans
                  </a>
                )}
              </section>
            )}

            {plan.kind === "single-mcp" && productDetail !== null && (
              <section class="mt-10 border-y border-white/40">
                <div class="grid lg:grid-cols-3">
                  <article class="border-b border-white/30 py-6 lg:border-b-0 lg:border-r lg:pr-6">
                    <p class="text-[0.65rem] font-bold uppercase text-signal">Why it exists</p>
                    <p class="mt-3 text-sm leading-7 text-white/70">{productDetail.useCase}</p>
                    <p class="mt-3 text-xs leading-6 text-white/48">
                      Generic terminals, provider APIs, and custom prompts can cover parts of the work, but the caller must supply permission limits, output requirements, failure handling, and usage accounting.
                    </p>
                  </article>
                  <article class="border-b border-white/30 py-6 lg:border-b-0 lg:border-r lg:px-6">
                    <p class="text-[0.65rem] font-bold uppercase text-signal">Connection and contract</p>
                    <p class="mt-3 text-sm leading-7 text-white/70">{connectionSummary}</p>
                    <p class="mt-3 text-xs leading-6 text-white/48">
                      The product-specific schema defines the inputs and outputs used by clients and downstream automation.
                    </p>
                  </article>
                  <article class="py-6 lg:pl-6">
                    <p class="text-[0.65rem] font-bold uppercase text-signal">Current limits</p>
                    <p class="mt-3 text-sm leading-7 text-white/70">{productBoundary}</p>
                    {workflowProof !== null && (
                      <p class="mt-3 text-xs leading-6 text-white/48">{workflowProof.permission}</p>
                    )}
                  </article>
                </div>
              </section>
            )}

            {plan.featureBullets.length > 0 && (
              <section class="mt-10">
                <h2 class="text-xs font-bold uppercase text-white/54">What you get</h2>
                <ul class="mt-4 grid gap-3 text-sm leading-7 text-white/74 sm:grid-cols-2">
                  {plan.featureBullets.map((bullet) => (
                    <li class="flex gap-3 border border-white/30 bg-black/54 p-4">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-signal"></span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {productDetail !== null && (
              <section class="mt-10">
                <h2 class="text-xs font-bold uppercase text-white/54">Core use case</h2>
                <p class="mt-4 max-w-3xl text-base leading-8 text-white/76">{productDetail.useCase}</p>

                <h2 class="mt-10 text-xs font-bold uppercase text-white/54">Outcomes</h2>
                <ul class="mt-4 grid gap-3 text-sm leading-7 text-white/74 sm:grid-cols-2">
                  {productDetail.outcomes.map((outcome) => (
                    <li class="flex gap-3 border border-white/30 bg-black/50 p-4">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-signal"></span>
                      <span>{outcome}</span>
                    </li>
                  ))}
                </ul>

                <h2 class="mt-10 text-xs font-bold uppercase text-white/54">Primary workflows</h2>
                <div class="mt-4 flex flex-wrap gap-2">
                  {productDetail.workflows.map((workflow) => (
                    <span class="border border-white/40 bg-black/54 px-3 py-2 text-xs font-bold uppercase text-white/70">
                      {workflow}
                    </span>
                  ))}
                </div>
              </section>
            )}

            {planResearch !== null && (
              <section class="mt-10 border-2 border-signal/70 bg-black/68 p-5">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <p class="text-xs font-bold uppercase text-signal">Research</p>
                  <span class="border border-signal/60 px-2 py-1 text-[0.62rem] font-bold uppercase text-signal-soft">
                    {planResearch.briefLabel}
                  </span>
                </div>
                <h2 class="mt-4 text-2xl font-extrabold uppercase">{planResearch.question}</h2>
                <p class="mt-4 max-w-2xl text-sm leading-7 text-white/72">{planResearch.evaluationLens}</p>
                <p class="mt-4 border-l-2 border-white/40 pl-4 text-xs leading-6 text-white/52">{planResearch.limit}</p>
                <a href={planResearch.href} class="mt-5 inline-flex min-h-11 items-center justify-center border border-signal px-4 text-xs font-bold uppercase text-signal-soft transition hover:bg-signal/10 hover:text-white">
                  {planResearch.publishedBenchmark
                    ? "Read benchmark"
                    : planResearch.hostedStatus === "available"
                      ? "Read research note"
                      : "Read research program"}
                </a>
              </section>
            )}
          </div>

          <aside id="waitlist" class="h-fit scroll-mt-6 border-2 border-white bg-black/78 p-5 lg:sticky lg:top-6">
            {plan.kind === "usage-plan" && displayPrice?.price.priceCents != null && (
              <div class="mb-5 border-b border-white/30 pb-5">
                <p class="text-xs font-bold uppercase text-white/54">Published plan price</p>
                <p class="mt-4 text-3xl font-extrabold uppercase">
                  {formatPriceUSD(displayPrice.price.priceCents)}
                  <span class="ml-1 text-sm font-bold text-white/54">{cadenceLabel(displayPrice.cadence)}</span>
                </p>
                {annualPrice?.priceCents != null && (
                  <p class="mt-2 text-xs font-bold uppercase text-white/58">
                    Annual {formatPriceUSD(annualPrice.priceCents)}{cadenceLabel("annual")} · two months included
                  </p>
                )}
              </div>
            )}
            {isEvaluation ? (
              <>
                <p class="text-xs font-bold uppercase text-signal">Start Evaluation</p>
                <p class="mt-4 text-2xl font-extrabold uppercase">Limited 30-day usage</p>
                <p class="mt-4 text-sm leading-6 text-white/66">Confirm your email in the Monarchic webapp before starting. No card or automatic billing; usage pauses at the evaluation limit.</p>
                <a href={`${webappBaseUrl}/products/${plan.slug}`} class="mt-6 inline-flex min-h-12 w-full items-center justify-center border-2 border-signal bg-signal px-4 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">
                  Start free evaluation
                </a>
              </>
            ) : isPurchasable ? (
              <>
                <p class="text-xs font-bold uppercase text-signal">Checkout available</p>
                <p class="mt-4 text-sm leading-6 text-white/66">Choose monthly or annual billing in the Monarchic webapp. Usage pauses at the plan limit by default.</p>
                <a href={`${webappBaseUrl}/products/${plan.slug}`} class="mt-6 inline-flex min-h-12 w-full items-center justify-center border-2 border-signal bg-signal px-4 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">
                  Choose plan
                </a>
              </>
            ) : plan.status === "contact_sales" && plan.salesContactUrl ? (
              <>
                <p class="text-xs font-bold uppercase text-white/54">Business plan</p>
                <p class="mt-4 text-2xl font-extrabold uppercase">Contact sales</p>
                <p class="mt-4 text-sm leading-6 text-white/66">Capacity, support, and service terms are based on the expected workload.</p>
                <a href={plan.salesContactUrl} class="mt-6 inline-flex min-h-12 w-full items-center justify-center border-2 border-signal bg-signal px-4 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">
                  Contact sales
                </a>
              </>
            ) : plan.kind === "single-mcp" && mcpHostedStatus === "available" ? (
              <>
                <p class="text-xs font-bold uppercase text-signal">Available</p>
                <p class="mt-4 text-2xl font-extrabold uppercase">Use it with a usage plan</p>
                <p class="mt-4 text-sm leading-6 text-white/66">Calls draw from the weekly execution usage included with your active plan.</p>
                <a href="/products/hosted-mcps#plans" class="mt-6 inline-flex min-h-12 w-full items-center justify-center border-2 border-signal bg-signal px-4 text-xs font-bold uppercase text-black transition hover:bg-signal-soft">
                  Compare plans
                </a>
              </>
            ) : (
              <>
                <p class="text-xs font-bold uppercase text-signal">{statusLabel(plan)}</p>
                <p class="mt-4 text-2xl font-extrabold uppercase">Not available for checkout</p>
                <p class="mt-4 text-sm leading-6 text-white/66">
                  {mcpHostedStatus === "in_rollout"
                    ? "A non-production deployment is being qualified. Join the waitlist for an update when production access opens."
                    : mcpHostedStatus === "planned"
                      ? "This MCP has an assigned hosted runtime plan. Join the waitlist for deployment updates."
                      : "Join the waitlist for an update when public access opens."}
                </p>
                <a href={`/waitlist?product=${encodeURIComponent(plan.slug)}`} class="mt-6 inline-flex min-h-12 w-full items-center justify-center border-2 border-signal/80 px-4 text-xs font-bold uppercase text-signal-soft transition hover:bg-signal/10 hover:text-white">
                  Join waitlist
                </a>
              </>
            )}
            <a href={isHostedCatalogEntry ? "/products/hosted-mcps" : "/products"} class="mt-3 inline-flex min-h-11 w-full items-center justify-center border border-white/50 px-4 text-xs font-bold uppercase text-white transition hover:border-signal hover:bg-signal/10 hover:text-signal-soft">
              {isHostedCatalogEntry ? "View hosted MCPs" : "View all products"}
            </a>
          </aside>
        </section>

        {workflowProof !== null && <div class="page-gutter mb-12"><ProductWorkflowProof proof={workflowProof} /></div>}

    </PublicPageFrame>
  </body>
</html>
