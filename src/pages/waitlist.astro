---
import Shader14 from "../components/Shader14.astro";
import SeoHead from "../components/SeoHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WaitlistForm from "../components/WaitlistForm.svelte";
import { allPlans } from "../lib/pricing";
import "../styles/global.css";

const apiBaseUrl = import.meta.env.PUBLIC_MONARCHIC_API_BASE_URL ?? "https://api.monarchic.io";
const wipProducts = allPlans
  .filter((plan) => plan.kind === "single-mcp" && plan.status === "coming_soon")
  .map((plan) => ({ slug: plan.slug, label: plan.displayName }));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead
      title="Waitlist | Monarchic"
      description="Join the Monarchic MCP catalog waitlist for coming-soon access updates."
      path="/waitlist"
    />
  </head>
  <body class="min-h-screen bg-black text-white">
    <main class="relative min-h-screen overflow-hidden">
      <Shader14 className="pointer-events-none fixed inset-0 h-full w-full opacity-70" />
      <div class="pointer-events-none fixed inset-0 bg-[linear-gradient(to_bottom,_rgba(0,0,0,0.68),_rgba(0,0,0,0.94))]"></div>

      <section class="relative z-10 mx-auto max-w-5xl px-6 py-8 sm:py-12">
        <SiteHeader />

        <section class="grid min-h-[calc(100vh-112px)] gap-8 py-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
          <div>
            <p class="mb-5 text-xs font-semibold uppercase tracking-[0.4em] text-white/64">
              MCP catalog waitlist
            </p>
            <h1 class="max-w-4xl text-5xl font-extrabold uppercase leading-[0.9] sm:text-7xl [text-shadow:6px_6px_0_rgba(255,255,255,0.12)]">
              Get Access<br />Updates
            </h1>
            <p class="mt-7 max-w-2xl text-base leading-8 text-white/78 sm:text-lg">
              Choose a WIP MCP and join for an email when public access opens.
            </p>
          </div>

          <div class="border-2 border-white bg-black/76 p-5 sm:p-6">
            <p class="text-xs font-bold uppercase tracking-[0.32em] text-signal">Join the waitlist</p>
            <p class="mt-4 text-sm leading-7 text-white/74">
              We will use this list for product availability and account access
              updates.
            </p>
            <div class="mt-6">
              <WaitlistForm
                client:load
                apiBaseUrl={apiBaseUrl}
                slug={wipProducts[0]?.slug ?? "monarchic-ai"}
                products={wipProducts}
                submitLabel="Join waitlist"
              />
            </div>
            <p class="mt-5 text-xs leading-5 text-white/50">
              Products marked Available can be used through an active plan.
              WIP products cannot be purchased yet.
            </p>
          </div>
        </section>
        <SiteFooter />
      </section>
    </main>
  </body>
</html>
