---
import PublicPageFrame from "../components/PublicPageFrame.astro";
import SeoHead from "../components/SeoHead.astro";
import WaitlistForm from "../components/WaitlistForm.svelte";
import { allPlans } from "../lib/pricing";
import "../styles/global.css";

const apiBaseUrl = import.meta.env.PUBLIC_MONARCHIC_API_BASE_URL ?? "https://api.monarchic.io";
const waitlistProducts = allPlans
  .filter((plan) => plan.status === "coming_soon")
  .map((plan) => ({
    slug: plan.slug,
    label: plan.kind === "usage-plan" ? `${plan.displayName} plan` : plan.displayName,
  }));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=1" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,follow" />
    <SeoHead
      title="Waitlist | Monarchic"
      description="Join the Monarchic product waitlist for coming-soon access updates."
      path="/waitlist"
    />
  </head>
  <body class="min-h-screen bg-ink text-white">
    <PublicPageFrame>
        <section class="page-hero grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
          <div>
            <h1 class="max-w-4xl text-5xl font-extrabold uppercase leading-[0.9] sm:text-7xl">
              Get Access<br />Updates
            </h1>
            <p class="mt-7 max-w-2xl text-base leading-8 text-white/78 sm:text-lg">
              Choose a coming-soon product and join for an email when public access opens.
            </p>
          </div>

          <div class="border-2 border-white bg-black/76 p-5 sm:p-6">
            <p class="text-sm leading-7 text-white/74">
              We will use this list for product availability and account access
              updates.
            </p>
            <div class="mt-5">
              <WaitlistForm
                client:load
                apiBaseUrl={apiBaseUrl}
                slug={waitlistProducts[0]?.slug ?? "monarchic-ai"}
                products={waitlistProducts}
                submitLabel="Join waitlist"
              />
            </div>
            <p class="mt-5 text-xs leading-5 text-white/50">
              Products marked Available can be used through an active plan.
              Coming-soon products cannot be purchased yet.
            </p>
          </div>
        </section>
    </PublicPageFrame>
  </body>
</html>
