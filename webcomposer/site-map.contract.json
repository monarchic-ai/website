{
  "name": "Monarchic Public Website",
  "description": "Content-only contract for Monarchic's public home, product, benchmark, waitlist, privacy, and service-terms routes.",
  "pages": [
    {
      "route": "/",
      "title": "Home",
      "purpose": "Introduce the Monarchic MCP catalog, shared credit model, product availability, and current benchmark evidence.",
      "audience": ["buyers", "engineering teams", "agent users"],
      "requiredContent": ["catalog_positioning", "available_and_wip_scope", "shared_credit_model", "primary_cta", "benchmark_metrics", "measurement_limits", "waitlist_offer"],
      "forbiddenContent": ["secret names", "private API URLs", "unsupported availability claims", "internal test output", "website implementation details"],
      "primaryActions": ["view_products", "read_docs", "view_research", "join_waitlist"]
    },
    {
      "route": "/products",
      "title": "Products",
      "purpose": "Let buyers compare five shared-credit plans and inspect all fifteen current MCP products with clear Available or WIP status.",
      "audience": ["buyers", "engineering teams", "agent users"],
      "requiredContent": ["five_credit_plans", "fifteen_mcp_products", "availability", "wip_markers", "shared_credit_model", "catalog_prices", "purchase_link_for_available_plans", "docs_link"],
      "forbiddenContent": ["retired MCPs", "workflow bundles", "platform promotion", "standalone MCP subscriptions", "prices absent from the catalog", "checkout promises for WIP products", "website implementation details"],
      "primaryActions": ["compare_plans", "inspect_product", "open_purchase_flow_when_available", "read_docs"]
    },
    {
      "route": "/products/mcp-explicitmem",
      "title": "ExplicitMem Product",
      "purpose": "Explain ExplicitMem's buyer fit, shared-credit access, capabilities, status, and qualifying benchmark.",
      "audience": ["agent users", "AI platform teams", "engineering leaders"],
      "requiredContent": ["product_name", "buyer_fit", "capabilities", "availability", "shared_credit_access", "benchmark_link", "primary_cta"],
      "forbiddenContent": ["unsupported latency claims", "private benchmark records", "internal test output", "standalone MCP price"],
      "primaryActions": ["compare_plans", "read_benchmark", "return_to_catalog"]
    },
    {
      "route": "/products/[slug]",
      "title": "Product Detail",
      "purpose": "Describe one catalog product with its buyer fit, capabilities, availability, shared-credit access, and eligible next action.",
      "audience": ["buyers", "engineering teams", "agent users"],
      "requiredContent": ["product_name", "buyer_fit", "capabilities", "availability", "catalog_price_state", "shared_credit_access", "purchase_link_when_available", "primary_cta"],
      "forbiddenContent": ["retired products", "prices absent from the catalog", "checkout promises for WIP products", "private catalog metadata", "unsupported evidence claims", "website implementation details"],
      "primaryActions": ["open_purchase_flow_when_available", "join_waitlist_when_wip", "return_to_catalog", "read_benchmark_when_available"]
    },
    {
      "route": "/research",
      "title": "Research",
      "purpose": "Index only public benchmarks that meet the stated publication bar and keep limitations beside headline results.",
      "audience": ["technical buyers", "agent users", "research readers"],
      "requiredContent": ["publication_criteria", "explicitmem_benchmark", "headline_metrics", "methodology_link", "limitations"],
      "forbiddenContent": ["raw internal test output", "MCP hooks", "deployment checks", "unscoped benchmark rankings", "private data"],
      "primaryActions": ["open_explicitmem_benchmark", "open_explicitmem_product"]
    },
    {
      "route": "/research/explicitmem",
      "title": "ExplicitMem Research",
      "purpose": "Publish the dated 500-question LongMemEval-S result, fixed method, question-type breakdown, failures, and interpretation limits.",
      "audience": ["technical buyers", "memory system builders", "research readers"],
      "requiredContent": ["run_date", "sample_size", "methodology", "headline_results", "question_type_results", "failures", "quality_gate_status", "limitations", "source_link"],
      "forbiddenContent": ["hosted latency claims", "private tenant data", "deployment configuration", "MCP hooks", "unscoped competitive claims"],
      "primaryActions": ["view_product", "view_source"]
    },
    {
      "route": "/waitlist",
      "title": "Waitlist",
      "purpose": "Collect an email address for WIP product availability and account-access updates.",
      "audience": ["prospects", "buyers", "agent users"],
      "requiredContent": ["waitlist_offer", "form_fields", "success_state", "privacy_boundary", "wip_scope"],
      "forbiddenContent": ["instant access promises", "unsupported launch dates", "private CRM labels", "website release status"],
      "primaryActions": ["join_waitlist"]
    },
    {
      "route": "/privacy",
      "title": "Privacy Notice",
      "purpose": "Explain Monarchic's current data handling for the website, accounts, billing, hosted MCP requests, operational telemetry, and support contacts.",
      "audience": ["website visitors", "account holders", "buyers", "agent users"],
      "requiredContent": ["effective_date", "controller_identity", "data_categories", "processing_purposes", "service_providers", "retention_boundary", "privacy_rights", "security_boundary", "contact_path"],
      "forbiddenContent": ["unsupported compliance certifications", "guaranteed security claims", "secret values", "private customer data", "unsupported retention periods"],
      "primaryActions": ["contact_privacy", "read_terms"]
    },
    {
      "route": "/terms",
      "title": "Service Terms",
      "purpose": "State the operating terms for Monarchic accounts, hosted MCPs, credit metering, billing, customer content, acceptable use, and service availability.",
      "audience": ["account holders", "buyers", "agent users", "billing owners"],
      "requiredContent": ["effective_date", "agreement_scope", "account_terms", "usage_metering", "acceptable_use", "customer_content", "third_party_services", "payment_terms", "suspension_boundary", "warranty_boundary", "liability_boundary", "change_notice", "contact_path"],
      "forbiddenContent": ["unsupported uptime commitments", "unpublished pricing promises", "secret values", "private customer data", "automatic compliance claims"],
      "primaryActions": ["contact_support", "read_privacy"]
    }
  ]
}
